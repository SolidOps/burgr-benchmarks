@@ -0,0 +1,162 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Data.Sqlite;
+
+namespace Acme.Warehouse.Tests;
+
+[TestClass]
+public class WarehouseApiTests
+{
+    private string _dbPath = "";
+    private WebApplicationFactory<Program> _factory = null!;
+    private HttpClient _client = null!;
+
+    [TestInitialize]
+    public void Init()
+    {
+        _dbPath = Path.Combine(Path.GetTempPath(), $"warehouse-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+            b.UseSetting("ConnectionStrings:Warehouse", $"Data Source={_dbPath}"));
+        _client = _factory.CreateClient();
+    }
+
+    [TestCleanup]
+    public void Cleanup()
+    {
+        _client.Dispose();
+        _factory.Dispose();
+        SqliteConnection.ClearAllPools();
+        File.Delete(_dbPath);
+    }
+
+    private async Task<JsonElement> Json(HttpResponseMessage r) =>
+        (await r.Content.ReadFromJsonAsync<JsonElement>());
+
+    private async Task<Guid> CreateSupplier(string name = "Acme", string? email = null)
+    {
+        var r = await _client.PostAsJsonAsync("/suppliers", new { name, email });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        return (await Json(r)).GetProperty("id").GetGuid();
+    }
+
+    private Task<HttpResponseMessage> PostProduct(Guid supplierId, string sku = "A-1", int stock = 5, int reorder = 2, int status = 0) =>
+        _client.PostAsJsonAsync("/products", new { sku, name = "Widget", stock, reorderLevel = reorder, status, supplierId });
+
+    [TestMethod]
+    public async Task Supplier_round_trip()
+    {
+        var id = await CreateSupplier("S1", "a@b.c");
+        var got = await Json(await _client.GetAsync($"/suppliers/{id}"));
+        Assert.AreEqual("S1", got.GetProperty("name").GetString());
+        Assert.AreEqual(0, got.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "S2" });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("S2", (await Json(put)).GetProperty("name").GetString());
+
+        Assert.AreEqual(1, (await Json(await _client.GetAsync("/suppliers"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_round_trip_and_supplier_includes_products()
+    {
+        var sid = await CreateSupplier();
+        var created = await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var p = await Json(created);
+        var pid = p.GetProperty("id").GetGuid();
+        Assert.AreEqual(sid, p.GetProperty("supplierId").GetGuid());
+        Assert.AreEqual(0, p.GetProperty("status").GetInt32());
+
+        var sup = await Json(await _client.GetAsync($"/suppliers/{sid}"));
+        Assert.AreEqual(1, sup.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/products/{pid}", new { sku = "A-1", name = "Gadget", stock = 9, reorderLevel = 2, status = 1, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Gadget", (await Json(put)).GetProperty("name").GetString());
+        Assert.AreEqual(1, (await Json(await _client.GetAsync("/products"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/products/{pid}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{pid}")).StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(5, 5, 0, true)]
+    [DataRow(4, 5, 0, true)]
+    [DataRow(6, 5, 0, false)]
+    [DataRow(1, 5, 1, false)]
+    public async Task NeedsReorder_is_computed(int stock, int reorder, int status, bool expected)
+    {
+        var sid = await CreateSupplier();
+        var p = await Json(await PostProduct(sid, stock: stock, reorder: reorder, status: status));
+        Assert.AreEqual(expected, p.GetProperty("needsReorder").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task Supplier_validation()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = "" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = "ok", email = new string('x', 101) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_validation()
+    {
+        var sid = await CreateSupplier();
+        foreach (var body in new object[]
+        {
+            new { sku = "", name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = sid },
+            new { sku = new string('x', 21), name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = sid },
+            new { sku = "a", name = "", stock = 1, reorderLevel = 1, status = 0, supplierId = sid },
+            new { sku = "a", name = "n", stock = -1, reorderLevel = 1, status = 0, supplierId = sid },
+            new { sku = "a", name = "n", stock = 1, reorderLevel = -1, status = 0, supplierId = sid },
+            new { sku = "a", name = "n", stock = 1, reorderLevel = 1, status = 7, supplierId = sid },
+            new { sku = "a", name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = Guid.NewGuid() },
+            new { sku = "a", name = "n", stock = 1, reorderLevel = 1, status = 0 },
+        })
+        {
+            var r = await _client.PostAsJsonAsync("/products", body);
+            Assert.AreEqual(HttpStatusCode.BadRequest, r.StatusCode, JsonSerializer.Serialize(body));
+        }
+    }
+
+    [TestMethod]
+    public async Task Unique_values_conflict()
+    {
+        var sid = await CreateSupplier("Dup");
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.PostAsJsonAsync("/suppliers", new { name = "Dup" })).StatusCode);
+        var other = await CreateSupplier("Other");
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.PutAsJsonAsync($"/suppliers/{other}", new { name = "Dup" })).StatusCode);
+
+        await PostProduct(sid, "SKU");
+        Assert.AreEqual(HttpStatusCode.Conflict, (await PostProduct(sid, "SKU")).StatusCode);
+        var p2 = await Json(await PostProduct(sid, "SKU2"));
+        var r = await _client.PutAsJsonAsync($"/products/{p2.GetProperty("id").GetGuid()}",
+            new { sku = "SKU", name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.Conflict, r.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Deleting_supplier_with_products_conflicts()
+    {
+        var sid = await CreateSupplier();
+        await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.DeleteAsync($"/suppliers/{sid}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Unknown_ids_return_404()
+    {
+        var id = Guid.NewGuid();
+        var sid = await CreateSupplier();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "x" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.PutAsJsonAsync($"/products/{id}",
+            new { sku = "a", name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = sid })).StatusCode);
+    }
+}
