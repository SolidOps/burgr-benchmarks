@@ -0,0 +1,124 @@
+using Acme.Warehouse.Contracts;
+using Acme.Warehouse.Domain;
+using Acme.Warehouse.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Warehouse.Api;
+
+public static class WarehouseEndpoints
+{
+    public static WebApplication MapWarehouseEndpoints(this WebApplication app)
+    {
+        var suppliers = app.MapGroup("/suppliers");
+
+        suppliers.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Suppliers.Include(s => s.Products).AsNoTracking().OrderBy(s => s.Name).ToListAsync())
+                .Select(SupplierDto.From)));
+
+        suppliers.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Suppliers.Include(s => s.Products).AsNoTracking().FirstOrDefaultAsync(s => s.Id == id) is { } s
+                ? Results.Ok(SupplierDto.From(s)) : Results.NotFound());
+
+        suppliers.MapPost("/", async (SupplierInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            if (await db.Suppliers.AnyAsync(s => s.Name == input.Name))
+                return Conflict("name", "A supplier with this name already exists.");
+            var s = new Supplier { Id = Guid.NewGuid() };
+            input.ApplyTo(s);
+            db.Suppliers.Add(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Created($"/suppliers/{s.Id}", SupplierDto.From(s));
+        });
+
+        suppliers.MapPut("/{id:guid}", async (Guid id, SupplierInput input, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.Include(x => x.Products).FirstOrDefaultAsync(x => x.Id == id);
+            if (s is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            if (await db.Suppliers.AnyAsync(x => x.Name == input.Name && x.Id != id))
+                return Conflict("name", "A supplier with this name already exists.");
+            input.ApplyTo(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Ok(SupplierDto.From(s));
+        });
+
+        suppliers.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            db.Suppliers.Remove(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.NoContent();
+        });
+
+        var products = app.MapGroup("/products");
+
+        products.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Products.AsNoTracking().OrderBy(p => p.Sku).ToListAsync()).Select(ProductDto.From)));
+
+        products.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Id == id) is { } p
+                ? Results.Ok(ProductDto.From(p)) : Results.NotFound());
+
+        products.MapPost("/", async (ProductInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count == 0 && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+                errors["supplierId"] = ["supplierId does not reference an existing supplier."];
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            if (await db.Products.AnyAsync(p => p.Sku == input.Sku))
+                return Conflict("sku", "A product with this sku already exists.");
+            var p = new Product { Id = Guid.NewGuid() };
+            input.ApplyTo(p);
+            db.Products.Add(p);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Created($"/products/{p.Id}", ProductDto.From(p));
+        });
+
+        products.MapPut("/{id:guid}", async (Guid id, ProductInput input, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count == 0 && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+                errors["supplierId"] = ["supplierId does not reference an existing supplier."];
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            if (await db.Products.AnyAsync(x => x.Sku == input.Sku && x.Id != id))
+                return Conflict("sku", "A product with this sku already exists.");
+            input.ApplyTo(p);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Ok(ProductDto.From(p));
+        });
+
+        products.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            db.Products.Remove(p);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.NoContent();
+        });
+
+        return app;
+    }
+
+    private static IResult Conflict(string property, string message) =>
+        Results.Problem(title: "Conflict", detail: message, statusCode: StatusCodes.Status409Conflict,
+            extensions: new Dictionary<string, object?> { ["property"] = property });
+
+    private static async Task<IResult?> TrySave(WarehouseDbContext db)
+    {
+        try
+        {
+            await db.SaveChangesAsync();
+            return null;
+        }
+        catch (DbUpdateException)
+        {
+            return Conflict("", "The operation violates a unique or foreign key constraint.");
+        }
+    }
+}
