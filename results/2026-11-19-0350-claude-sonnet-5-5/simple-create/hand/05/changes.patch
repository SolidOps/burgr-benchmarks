+using Microsoft.AspNetCore.Hosting;
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace Warehouse.Tests;
+
+public class WarehouseFactory : WebApplicationFactory<Program>
+{
+    private readonly string _db = Path.Combine(Path.GetTempPath(), $"wh-{Guid.NewGuid():N}.db");
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder) =>
+        builder.UseSetting("ConnectionStrings:Warehouse", $"Data Source={_db}");
+
+    protected override void Dispose(bool disposing)
+    {
+        base.Dispose(disposing);
+        Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools();
+        try { File.Delete(_db); } catch { }
+    }
+}
+
+[TestClass]
+public class ApiTests
+{
+    private WarehouseFactory _factory = null!;
+    private HttpClient _client = null!;
+
+    [TestInitialize] public void Init() { _factory = new(); _client = _factory.CreateClient(); }
+    [TestCleanup] public void Cleanup() { _client.Dispose(); _factory.Dispose(); }
+
+    private async Task<JsonElement> Json(HttpResponseMessage r) =>
+        (await r.Content.ReadFromJsonAsync<JsonElement>());
+
+    private async Task<Guid> CreateSupplier(string name = "Acme")
+    {
+        var r = await _client.PostAsJsonAsync("/suppliers", new { name, email = "a@b.c" });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        return (await Json(r)).GetProperty("id").GetGuid();
+    }
+
+    private Task<HttpResponseMessage> PostProduct(Guid supplierId, string sku = "SKU1", int stock = 5,
+        int reorder = 5, int status = 0) =>
+        _client.PostAsJsonAsync("/products", new { sku, name = "Widget", stock, reorderLevel = reorder, status, supplierId });
+
+    [TestMethod]
+    public async Task Supplier_round_trip()
+    {
+        var id = await CreateSupplier();
+        var get = await Json(await _client.GetAsync($"/suppliers/{id}"));
+        Assert.AreEqual("Acme", get.GetProperty("name").GetString());
+        Assert.AreEqual(0, get.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "Beta" });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Beta", (await Json(put)).GetProperty("name").GetString());
+
+        var list = await Json(await _client.GetAsync("/suppliers"));
+        Assert.AreEqual(1, list.GetArrayLength());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_round_trip_and_supplier_includes_products()
+    {
+        var sid = await CreateSupplier();
+        var created = await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var p = await Json(created);
+        var pid = p.GetProperty("id").GetGuid();
+        Assert.AreEqual(sid, p.GetProperty("supplierId").GetGuid());
+
+        var sup = await Json(await _client.GetAsync($"/suppliers/{sid}"));
+        Assert.AreEqual(1, sup.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/products/{pid}",
+            new { sku = "SKU2", name = "Gadget", stock = 50, reorderLevel = 5, status = 1, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        var updated = await Json(put);
+        Assert.AreEqual("SKU2", updated.GetProperty("sku").GetString());
+        Assert.AreEqual(1, updated.GetProperty("status").GetInt32());
+
+        Assert.AreEqual(1, (await Json(await _client.GetAsync("/products"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/products/{pid}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{pid}")).StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(0, 5, 5, true)]
+    [DataRow(0, 4, 5, true)]
+    [DataRow(0, 6, 5, false)]
+    [DataRow(1, 0, 5, false)]
+    public async Task NeedsReorder_is_computed(int status, int stock, int reorder, bool expected)
+    {
+        var sid = await CreateSupplier();
+        var p = await Json(await PostProduct(sid, stock: stock, reorder: reorder, status: status));
+        Assert.AreEqual(expected, p.GetProperty("needsReorder").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task Unknown_ids_return_404()
+    {
+        var id = Guid.NewGuid();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound,
+            (await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "x" })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Supplier_validation()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = new string('a', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "ok", email = new string('a', 101) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_validation()
+    {
+        var sid = await CreateSupplier();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: "")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: new string('a', 21))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, stock: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, reorder: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, status: 2)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(Guid.NewGuid())).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(Guid.Empty)).StatusCode);
+        var body = await Json(await PostProduct(Guid.NewGuid()));
+        Assert.IsTrue(body.GetProperty("errors").TryGetProperty("supplierId", out _));
+    }
+
+    [TestMethod]
+    public async Task Unique_values_return_409()
+    {
+        var sid = await CreateSupplier("Acme");
+        Assert.AreEqual(HttpStatusCode.Conflict,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "Acme" })).StatusCode);
+
+        Assert.AreEqual(HttpStatusCode.Created, (await PostProduct(sid, "A")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await PostProduct(sid, "A")).StatusCode);
+
+        var other = await Json(await PostProduct(sid, "B"));
+        var put = await _client.PutAsJsonAsync($"/products/{other.GetProperty("id").GetGuid()}",
+            new { sku = "A", name = "x", stock = 1, reorderLevel = 1, status = 0, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.Conflict, put.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Deleting_supplier_with_products_returns_409()
+    {
+        var sid = await CreateSupplier();
+        await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.DeleteAsync($"/suppliers/{sid}")).StatusCode);
+    }
+}
