@@ -0,0 +1,157 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace Acme.Warehouse.Tests;
+
+[TestClass]
+public class WarehouseTests
+{
+    private string _db = null!;
+    private WebApplicationFactory<Program> _factory = null!;
+    private HttpClient _client = null!;
+
+    [TestInitialize]
+    public void Init()
+    {
+        _db = Path.Combine(Path.GetTempPath(), $"wh-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+            b.UseSetting("ConnectionStrings:Warehouse", $"Data Source={_db};Pooling=False"));
+        _client = _factory.CreateClient();
+    }
+
+    [TestCleanup]
+    public void Cleanup()
+    {
+        _client.Dispose();
+        _factory.Dispose();
+        try { File.Delete(_db); } catch (IOException) { }
+    }
+
+    private async Task<JsonElement> Body(HttpResponseMessage r) =>
+        (await r.Content.ReadFromJsonAsync<JsonElement>());
+
+    private async Task<Guid> NewSupplier(string name = "Acme")
+    {
+        var r = await _client.PostAsJsonAsync("/suppliers", new { name, email = "a@b.c" });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        return (await Body(r)).GetProperty("id").GetGuid();
+    }
+
+    private Task<HttpResponseMessage> PostProduct(Guid supplier, string sku = "S1", int stock = 5, int reorder = 5, int status = 0) =>
+        _client.PostAsJsonAsync("/products", new { sku, name = "Widget", stock, reorderLevel = reorder, status, supplierId = supplier });
+
+    [TestMethod]
+    public async Task Supplier_round_trip()
+    {
+        var id = await NewSupplier();
+        var get = await Body(await _client.GetAsync($"/suppliers/{id}"));
+        Assert.AreEqual("Acme", get.GetProperty("name").GetString());
+        Assert.AreEqual(0, get.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "Beta" });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Beta", (await Body(put)).GetProperty("name").GetString());
+
+        var list = await Body(await _client.GetAsync("/suppliers"));
+        Assert.AreEqual(1, list.GetArrayLength());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_round_trip_and_supplier_lists_products()
+    {
+        var sid = await NewSupplier();
+        var created = await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var pid = (await Body(created)).GetProperty("id").GetGuid();
+
+        var p = await Body(await _client.GetAsync($"/products/{pid}"));
+        Assert.AreEqual(sid, p.GetProperty("supplierId").GetGuid());
+
+        var put = await _client.PutAsJsonAsync($"/products/{pid}",
+            new { sku = "S1", name = "New", stock = 50, reorderLevel = 5, status = 0, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.IsFalse((await Body(put)).GetProperty("needsReorder").GetBoolean());
+
+        var s = await Body(await _client.GetAsync($"/suppliers/{sid}"));
+        Assert.AreEqual(1, s.GetProperty("products").GetArrayLength());
+        Assert.AreEqual(1, (await Body(await _client.GetAsync("/products"))).GetArrayLength());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/products/{pid}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/products/{pid}")).StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(5, 5, 0, true)]
+    [DataRow(4, 5, 0, true)]
+    [DataRow(6, 5, 0, false)]
+    [DataRow(1, 5, 1, false)]
+    public async Task NeedsReorder_is_computed(int stock, int level, int status, bool expected)
+    {
+        var sid = await NewSupplier();
+        var r = await PostProduct(sid, stock: stock, reorder: level, status: status);
+        var json = await Body(r);
+        Assert.AreEqual(expected, json.GetProperty("needsReorder").GetBoolean());
+        Assert.AreEqual(status, json.GetProperty("status").GetInt32());
+    }
+
+    [TestMethod]
+    public async Task Supplier_validation()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = "" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await _client.PostAsJsonAsync("/suppliers", new { name = "ok", email = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Created, (await _client.PostAsJsonAsync("/suppliers", new { name = new string('x', 100) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_validation()
+    {
+        var sid = await NewSupplier();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: "")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: new string('x', 21))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, stock: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, reorder: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, status: 2)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(Guid.NewGuid())).StatusCode);
+        var r = await PostProduct(Guid.NewGuid());
+        Assert.IsTrue((await Body(r)).GetProperty("errors").TryGetProperty("supplierId", out _));
+    }
+
+    [TestMethod]
+    public async Task Unique_values_conflict()
+    {
+        var sid = await NewSupplier();
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.PostAsJsonAsync("/suppliers", new { name = "Acme" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Created, (await PostProduct(sid)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await PostProduct(sid)).StatusCode);
+
+        var other = await PostProduct(sid, sku: "S2");
+        var oid = (await Body(other)).GetProperty("id").GetGuid();
+        var put = await _client.PutAsJsonAsync($"/products/{oid}",
+            new { sku = "S1", name = "x", stock = 1, reorderLevel = 1, status = 0, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.Conflict, put.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Deleting_supplier_with_products_conflicts()
+    {
+        var sid = await NewSupplier();
+        await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.DeleteAsync($"/suppliers/{sid}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Unknown_ids_return_404()
+    {
+        var id = Guid.NewGuid();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "x" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+    }
+}
