@@ -0,0 +1,101 @@
+using Acme.Warehouse.Contracts;
+using Acme.Warehouse.Domain;
+using Acme.Warehouse.Infrastructure;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Warehouse.Api;
+
+public static class WarehouseEndpoints
+{
+    public static IEndpointRouteBuilder MapWarehouseEndpoints(this IEndpointRouteBuilder app)
+    {
+        var suppliers = app.MapGroup("/suppliers");
+        suppliers.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Suppliers.AsNoTracking().ToListAsync()).Select(SupplierDto.From)));
+        suppliers.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Suppliers.AsNoTracking().Include(s => s.Products).FirstOrDefaultAsync(s => s.Id == id)
+                is { } s ? Results.Ok(SupplierDetailDto.From(s)) : Results.NotFound());
+        suppliers.MapPost("/", async (SupplierInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var s = new Supplier { Id = Guid.NewGuid() };
+            input.ApplyTo(s);
+            db.Suppliers.Add(s);
+            return await Save(db, () => Results.Created($"/suppliers/{s.Id}", SupplierDto.From(s)));
+        });
+        suppliers.MapPut("/{id:guid}", async (Guid id, SupplierInput input, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(s);
+            return await Save(db, () => Results.Ok(SupplierDto.From(s)));
+        });
+        suppliers.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            db.Suppliers.Remove(s);
+            return await Save(db, () => Results.NoContent());
+        });
+
+        var products = app.MapGroup("/products");
+        products.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Products.AsNoTracking().ToListAsync()).Select(ProductDto.From)));
+        products.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Id == id)
+                is { } p ? Results.Ok(ProductDto.From(p)) : Results.NotFound());
+        products.MapPost("/", async (ProductInput input, WarehouseDbContext db) =>
+        {
+            var errors = await Check(input, db);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var p = new Product { Id = Guid.NewGuid() };
+            input.ApplyTo(p);
+            db.Products.Add(p);
+            return await Save(db, () => Results.Created($"/products/{p.Id}", ProductDto.From(p)));
+        });
+        products.MapPut("/{id:guid}", async (Guid id, ProductInput input, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            var errors = await Check(input, db);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(p);
+            return await Save(db, () => Results.Ok(ProductDto.From(p)));
+        });
+        products.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            db.Products.Remove(p);
+            return await Save(db, () => Results.NoContent());
+        });
+        return app;
+    }
+
+    private static async Task<Dictionary<string, string[]>> Check(ProductInput input, WarehouseDbContext db)
+    {
+        var errors = input.Validate();
+        if (!errors.ContainsKey("supplierId") && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+            errors["supplierId"] = ["supplierId does not reference an existing supplier."];
+        return errors;
+    }
+
+    private static async Task<IResult> Save(WarehouseDbContext db, Func<IResult> ok)
+    {
+        try
+        {
+            await db.SaveChangesAsync();
+            return ok();
+        }
+        catch (DbUpdateException ex) when (ex.InnerException is SqliteException { SqliteErrorCode: 19 } inner)
+        {
+            return Results.Problem(
+                title: inner.SqliteExtendedErrorCode == 787 ? "Referenced by other objects." : "Value already taken.",
+                statusCode: StatusCodes.Status409Conflict);
+        }
+    }
+}
