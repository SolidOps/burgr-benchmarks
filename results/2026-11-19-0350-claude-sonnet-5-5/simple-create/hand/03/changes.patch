+using Acme.Warehouse.Domain;
+
+namespace Acme.Warehouse.Contracts;
+
+public record SupplierDto(Guid Id, string Name, string? Email)
+{
+    public static SupplierDto From(Supplier s) => new(s.Id, s.Name, s.Email);
+}
+
+public record SupplierDetailDto(Guid Id, string Name, string? Email, List<ProductDto> Products)
+{
+    public static SupplierDetailDto From(Supplier s) =>
+        new(s.Id, s.Name, s.Email, s.Products.Select(ProductDto.From).ToList());
+}
+
+public class SupplierInput
+{
+    public string? Name { get; set; }
+    public string? Email { get; set; }
+
+    public Dictionary<string, string[]> Validate()
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (string.IsNullOrWhiteSpace(Name)) errors["name"] = ["name is required."];
+        else if (Name.Length > 100) errors["name"] = ["name must be at most 100 characters."];
+        if (Email is { Length: > 100 }) errors["email"] = ["email must be at most 100 characters."];
+        return errors;
+    }
+
+    public void ApplyTo(Supplier s)
+    {
+        s.Name = Name!;
+        s.Email = Email;
+    }
+}
