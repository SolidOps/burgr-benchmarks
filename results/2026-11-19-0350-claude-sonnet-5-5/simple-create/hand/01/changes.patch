@@ -0,0 +1,175 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace Acme.Warehouse.Tests;
+
+[TestClass]
+public class ApiTests
+{
+    private string _db = "";
+    private WebApplicationFactory<Program> _factory = null!;
+    private HttpClient _client = null!;
+
+    [TestInitialize]
+    public void Init()
+    {
+        _db = Path.Combine(Path.GetTempPath(), $"warehouse-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+            b.UseSetting("ConnectionStrings:Warehouse", $"Data Source={_db}"));
+        _client = _factory.CreateClient();
+    }
+
+    [TestCleanup]
+    public void Cleanup()
+    {
+        _client.Dispose();
+        _factory.Dispose();
+        Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools();
+        foreach (var f in Directory.GetFiles(Path.GetTempPath(), Path.GetFileName(_db) + "*")) File.Delete(f);
+    }
+
+    private async Task<JsonElement> Json(HttpResponseMessage r) =>
+        (await r.Content.ReadFromJsonAsync<JsonElement>());
+
+    private async Task<Guid> CreateSupplier(string name = "Acme", string? email = null)
+    {
+        var r = await _client.PostAsJsonAsync("/suppliers", new { name, email });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        return (await Json(r)).GetProperty("id").GetGuid();
+    }
+
+    private Task<HttpResponseMessage> PostProduct(Guid supplierId, string sku = "A1", int stock = 10,
+        int reorderLevel = 5, int status = 0, string name = "Widget") =>
+        _client.PostAsJsonAsync("/products", new { sku, name, stock, reorderLevel, status, supplierId });
+
+    [TestMethod]
+    public async Task Supplier_round_trip()
+    {
+        var id = await CreateSupplier("Acme", "a@acme.com");
+
+        var get = await Json(await _client.GetAsync($"/suppliers/{id}"));
+        Assert.AreEqual("Acme", get.GetProperty("name").GetString());
+        Assert.AreEqual(0, get.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "Acme2" });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Acme2", (await Json(put)).GetProperty("name").GetString());
+
+        var list = await Json(await _client.GetAsync("/suppliers"));
+        Assert.AreEqual(1, list.GetArrayLength());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_round_trip_and_supplier_includes_products()
+    {
+        var sid = await CreateSupplier();
+        var created = await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var p = await Json(created);
+        var pid = p.GetProperty("id").GetGuid();
+        Assert.AreEqual(sid, p.GetProperty("supplierId").GetGuid());
+        Assert.AreEqual(0, p.GetProperty("status").GetInt32());
+
+        var s = await Json(await _client.GetAsync($"/suppliers/{sid}"));
+        Assert.AreEqual(1, s.GetProperty("products").GetArrayLength());
+
+        var put = await _client.PutAsJsonAsync($"/products/{pid}",
+            new { sku = "A1", name = "Gadget", stock = 50, reorderLevel = 5, status = 1, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Gadget", (await Json(put)).GetProperty("name").GetString());
+
+        Assert.AreEqual(1, (await Json(await _client.GetAsync("/products"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await _client.DeleteAsync($"/products/{pid}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{pid}")).StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(0, 5, 0, true)]
+    [DataRow(5, 5, 0, true)]
+    [DataRow(6, 5, 0, false)]
+    [DataRow(0, 5, 1, false)]
+    public async Task NeedsReorder_is_computed(int stock, int level, int status, bool expected)
+    {
+        var sid = await CreateSupplier();
+        var p = await Json(await PostProduct(sid, stock: stock, reorderLevel: level, status: status));
+        Assert.AreEqual(expected, p.GetProperty("needsReorder").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task Supplier_validation()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "ok", email = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Created,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = new string('x', 100) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Product_validation()
+    {
+        var sid = await CreateSupplier();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: "")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, sku: new string('x', 21))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, name: "")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, stock: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, reorderLevel: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(sid, status: 2)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(Guid.NewGuid())).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(Guid.Empty)).StatusCode);
+        var bad = await PostProduct(sid, stock: -1);
+        Assert.IsTrue((await Json(bad)).GetProperty("errors").TryGetProperty("stock", out _));
+    }
+
+    [TestMethod]
+    public async Task Unique_values_give_409()
+    {
+        var sid = await CreateSupplier("Acme");
+        Assert.AreEqual(HttpStatusCode.Conflict,
+            (await _client.PostAsJsonAsync("/suppliers", new { name = "Acme" })).StatusCode);
+
+        var other = await CreateSupplier("Other");
+        Assert.AreEqual(HttpStatusCode.Conflict,
+            (await _client.PutAsJsonAsync($"/suppliers/{other}", new { name = "Acme" })).StatusCode);
+
+        Assert.AreEqual(HttpStatusCode.Created, (await PostProduct(sid, "A1")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await PostProduct(sid, "A1")).StatusCode);
+
+        var p2 = await Json(await PostProduct(sid, "A2"));
+        var put = await _client.PutAsJsonAsync($"/products/{p2.GetProperty("id").GetGuid()}",
+            new { sku = "A1", name = "x", stock = 1, reorderLevel = 1, status = 0, supplierId = sid });
+        Assert.AreEqual(HttpStatusCode.Conflict, put.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Deleting_supplier_with_products_gives_409()
+    {
+        var sid = await CreateSupplier();
+        await PostProduct(sid);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await _client.DeleteAsync($"/suppliers/{sid}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task Unknown_ids_give_404()
+    {
+        var id = Guid.NewGuid();
+        var sid = await CreateSupplier();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.GetAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound,
+            (await _client.PutAsJsonAsync($"/suppliers/{id}", new { name = "x" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound,
+            (await _client.PutAsJsonAsync($"/products/{id}",
+                new { sku = "a", name = "x", stock = 0, reorderLevel = 0, status = 0, supplierId = sid })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await _client.DeleteAsync($"/products/{id}")).StatusCode);
+    }
+}
