@@ -0,0 +1,124 @@
+using Acme.Warehouse.Contracts;
+using Acme.Warehouse.Domain;
+using Acme.Warehouse.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Warehouse.Api;
+
+public static class WarehouseEndpoints
+{
+    public static void MapWarehouseEndpoints(this IEndpointRouteBuilder app)
+    {
+        MapSuppliers(app.MapGroup("/suppliers"));
+        MapProducts(app.MapGroup("/products"));
+    }
+
+    private static void MapSuppliers(RouteGroupBuilder g)
+    {
+        g.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Suppliers.Include(s => s.Products).AsNoTracking()
+                .OrderBy(s => s.Name).ToListAsync()).Select(SupplierDto.From)));
+
+        g.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Suppliers.Include(s => s.Products).AsNoTracking().FirstOrDefaultAsync(s => s.Id == id)
+                is { } s ? Results.Ok(SupplierDto.From(s)) : Results.NotFound());
+
+        g.MapPost("/", async (SupplierInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var s = new Supplier { Id = Guid.NewGuid() };
+            input.ApplyTo(s);
+            db.Suppliers.Add(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Created($"/suppliers/{s.Id}", SupplierDto.From(s));
+        });
+
+        g.MapPut("/{id:guid}", async (Guid id, SupplierInput input, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.Include(x => x.Products).FirstOrDefaultAsync(x => x.Id == id);
+            if (s is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Ok(SupplierDto.From(s));
+        });
+
+        g.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            db.Suppliers.Remove(s);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.NoContent();
+        });
+    }
+
+    private static void MapProducts(RouteGroupBuilder g)
+    {
+        g.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok((await db.Products.AsNoTracking().OrderBy(p => p.Sku).ToListAsync())
+                .Select(ProductDto.From)));
+
+        g.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+            await db.Products.AsNoTracking().FirstOrDefaultAsync(p => p.Id == id)
+                is { } p ? Results.Ok(ProductDto.From(p)) : Results.NotFound());
+
+        g.MapPost("/", async (ProductInput input, WarehouseDbContext db) =>
+        {
+            var errors = await Validate(input, db);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var p = new Product { Id = Guid.NewGuid() };
+            input.ApplyTo(p);
+            db.Products.Add(p);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Created($"/products/{p.Id}", ProductDto.From(p));
+        });
+
+        g.MapPut("/{id:guid}", async (Guid id, ProductInput input, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            var errors = await Validate(input, db);
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(p);
+            if (await TrySave(db) is { } conflict) return conflict;
+            return Results.Ok(ProductDto.From(p));
+        });
+
+        g.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            db.Products.Remove(p);
+            await db.SaveChangesAsync();
+            return Results.NoContent();
+        });
+    }
+
+    private static async Task<Dictionary<string, string[]>> Validate(ProductInput input, WarehouseDbContext db)
+    {
+        var errors = input.Validate();
+        if (!errors.ContainsKey("supplierId") && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+            errors["supplierId"] = ["supplierId does not reference an existing supplier."];
+        return errors;
+    }
+
+    // Returns a 409 result when a unique index or foreign key is violated, null on success.
+    private static async Task<IResult?> TrySave(WarehouseDbContext db)
+    {
+        try
+        {
+            await db.SaveChangesAsync();
+            return null;
+        }
+        catch (DbUpdateException)
+        {
+            return Results.Problem(
+                title: "Conflict",
+                detail: "The change violates a unique value or a reference.",
+                statusCode: StatusCodes.Status409Conflict);
+        }
+    }
+}
