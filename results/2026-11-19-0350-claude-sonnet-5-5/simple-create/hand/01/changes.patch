+using Acme.Warehouse.Domain;
+
+namespace Acme.Warehouse.Contracts;
+
+public record ProductDto(
+    Guid Id, string Sku, string Name, int Stock, int ReorderLevel,
+    ProductStatus Status, Guid SupplierId, bool NeedsReorder)
+{
+    public static ProductDto From(Product p) =>
+        new(p.Id, p.Sku, p.Name, p.Stock, p.ReorderLevel, p.Status, p.SupplierId, p.NeedsReorder);
+}
+
+public class ProductInput
+{
+    public string? Sku { get; set; }
+    public string? Name { get; set; }
+    public int Stock { get; set; }
+    public int ReorderLevel { get; set; }
+    public int Status { get; set; }
+    public Guid SupplierId { get; set; }
+
+    public Dictionary<string, string[]> Validate()
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (string.IsNullOrWhiteSpace(Sku)) errors["sku"] = ["sku is required."];
+        else if (Sku.Length > 20) errors["sku"] = ["sku must be at most 20 characters."];
+        if (string.IsNullOrWhiteSpace(Name)) errors["name"] = ["name is required."];
+        else if (Name.Length > 100) errors["name"] = ["name must be at most 100 characters."];
+        if (Stock < 0) errors["stock"] = ["stock must not be negative."];
+        if (ReorderLevel < 0) errors["reorderLevel"] = ["reorderLevel must not be negative."];
+        if (!Enum.IsDefined((ProductStatus)Status)) errors["status"] = ["status is not a valid value."];
+        if (SupplierId == Guid.Empty) errors["supplierId"] = ["supplierId is required."];
+        return errors;
+    }
+
+    public void ApplyTo(Product p)
+    {
+        p.Sku = Sku!;
+        p.Name = Name!;
+        p.Stock = Stock;
+        p.ReorderLevel = ReorderLevel;
+        p.Status = (ProductStatus)Status;
+        p.SupplierId = SupplierId;
+    }
+}
