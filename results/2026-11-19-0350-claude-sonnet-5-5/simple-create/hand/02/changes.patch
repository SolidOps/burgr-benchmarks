+using Acme.Warehouse.Contracts;
+using Acme.Warehouse.Domain;
+using Acme.Warehouse.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Warehouse.Api;
+
+public static class WarehouseEndpoints
+{
+    public static IEndpointRouteBuilder MapWarehouseEndpoints(this IEndpointRouteBuilder app)
+    {
+        MapSuppliers(app.MapGroup("/suppliers"));
+        MapProducts(app.MapGroup("/products"));
+        return app;
+    }
+
+    private static IResult Conflict(string message) =>
+        Results.Problem(message, statusCode: StatusCodes.Status409Conflict, title: "Conflict");
+
+    private static async Task<IResult?> TrySave(WarehouseDbContext db, string conflictMessage)
+    {
+        try
+        {
+            await db.SaveChangesAsync();
+            return null;
+        }
+        catch (DbUpdateException)
+        {
+            return Conflict(conflictMessage);
+        }
+    }
+
+    private static void MapSuppliers(RouteGroupBuilder g)
+    {
+        g.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok(await db.Suppliers.AsNoTracking().OrderBy(s => s.Name)
+                .Select(s => SupplierDto.From(s)).ToListAsync()));
+
+        g.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.AsNoTracking().Include(x => x.Products).FirstOrDefaultAsync(x => x.Id == id);
+            return s is null ? Results.NotFound() : Results.Ok(SupplierDetailDto.From(s));
+        });
+
+        g.MapPost("/", async (SupplierInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var s = new Supplier { Id = Guid.NewGuid() };
+            input.ApplyTo(s);
+            db.Suppliers.Add(s);
+            return await TrySave(db, "A supplier with this name already exists.")
+                ?? Results.Created($"/suppliers/{s.Id}", SupplierDto.From(s));
+        });
+
+        g.MapPut("/{id:guid}", async (Guid id, SupplierInput input, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(s);
+            return await TrySave(db, "A supplier with this name already exists.")
+                ?? Results.Ok(SupplierDto.From(s));
+        });
+
+        g.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var s = await db.Suppliers.FindAsync(id);
+            if (s is null) return Results.NotFound();
+            db.Suppliers.Remove(s);
+            return await TrySave(db, "The supplier still has products.") ?? Results.NoContent();
+        });
+    }
+
+    private static void MapProducts(RouteGroupBuilder g)
+    {
+        g.MapGet("/", async (WarehouseDbContext db) =>
+            Results.Ok(await db.Products.AsNoTracking().OrderBy(p => p.Sku)
+                .Select(p => ProductDto.From(p)).ToListAsync()));
+
+        g.MapGet("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.AsNoTracking().FirstOrDefaultAsync(x => x.Id == id);
+            return p is null ? Results.NotFound() : Results.Ok(ProductDto.From(p));
+        });
+
+        g.MapPost("/", async (ProductInput input, WarehouseDbContext db) =>
+        {
+            var errors = input.Validate();
+            if (errors.Count == 0 && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+                errors["supplierId"] = ["Unknown supplier."];
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            var p = new Product { Id = Guid.NewGuid() };
+            input.ApplyTo(p);
+            db.Products.Add(p);
+            return await TrySave(db, "A product with this sku already exists.")
+                ?? Results.Created($"/products/{p.Id}", ProductDto.From(p));
+        });
+
+        g.MapPut("/{id:guid}", async (Guid id, ProductInput input, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            var errors = input.Validate();
+            if (errors.Count == 0 && !await db.Suppliers.AnyAsync(s => s.Id == input.SupplierId))
+                errors["supplierId"] = ["Unknown supplier."];
+            if (errors.Count > 0) return Results.ValidationProblem(errors);
+            input.ApplyTo(p);
+            return await TrySave(db, "A product with this sku already exists.")
+                ?? Results.Ok(ProductDto.From(p));
+        });
+
+        g.MapDelete("/{id:guid}", async (Guid id, WarehouseDbContext db) =>
+        {
+            var p = await db.Products.FindAsync(id);
+            if (p is null) return Results.NotFound();
+            db.Products.Remove(p);
+            return await TrySave(db, "The product cannot be deleted.") ?? Results.NoContent();
+        });
+    }
+}
