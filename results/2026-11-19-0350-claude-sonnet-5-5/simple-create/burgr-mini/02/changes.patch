diff --git a/src/Warehouse.Tests/ApiTests.cs b/src/Warehouse.Tests/ApiTests.cs
new file mode 100644
index 0000000..d081845
--- /dev/null
+++ b/src/Warehouse.Tests/ApiTests.cs
@@ -0,0 +1,130 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.AspNetCore.Mvc.Testing;
+
+namespace Warehouse.Tests;
+
+[TestClass]
+public class ApiTests
+{
+    private sealed class Factory : WebApplicationFactory<Program>
+    {
+        public string Db = Path.Combine(Path.GetTempPath(), $"wh-{Guid.NewGuid():N}.db");
+        protected override void ConfigureWebHost(IWebHostBuilder b)
+        {
+            b.UseSetting("ConnectionStrings:Warehouse", $"Data Source={Db}");
+        }
+        protected override void Dispose(bool disposing)
+        {
+            base.Dispose(disposing);
+            Microsoft.Data.Sqlite.SqliteConnection.ClearAllPools();
+            try { File.Delete(Db); } catch { }
+        }
+    }
+
+    private static async Task<JsonElement> Json(HttpResponseMessage r) =>
+        JsonDocument.Parse(await r.Content.ReadAsStringAsync()).RootElement.Clone();
+
+    private static async Task<string> NewSupplier(HttpClient c, string name = "Acme")
+    {
+        var r = await c.PostAsJsonAsync("/suppliers", new { name, email = "a@b.c" });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        return (await Json(r)).GetProperty("id").GetString()!;
+    }
+
+    private static Task<HttpResponseMessage> PostProduct(HttpClient c, string sup, string sku = "S1",
+        int stock = 5, int reorder = 5, int status = 0) =>
+        c.PostAsJsonAsync("/products", new { sku, name = "Widget", stock, reorderLevel = reorder, status, supplierId = sup });
+
+    [TestMethod]
+    public async Task SupplierRoundTrip()
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var id = await NewSupplier(c);
+        var r = await c.PutAsJsonAsync($"/suppliers/{id}", new { name = "New", email = (string?)null });
+        Assert.AreEqual(HttpStatusCode.OK, r.StatusCode);
+        Assert.AreEqual("New", (await Json(r)).GetProperty("name").GetString());
+        Assert.AreEqual(1, (await Json(await c.GetAsync("/suppliers"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await c.DeleteAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await c.GetAsync($"/suppliers/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await c.DeleteAsync($"/suppliers/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ProductRoundTripAndSupplierProducts()
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var sup = await NewSupplier(c);
+        var r = await PostProduct(c, sup);
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode);
+        var p = await Json(r);
+        var id = p.GetProperty("id").GetString();
+        Assert.AreEqual(sup, p.GetProperty("supplierId").GetString());
+        Assert.AreEqual(0, p.GetProperty("status").GetInt32());
+        var u = await c.PutAsJsonAsync($"/products/{id}",
+            new { sku = "S1", name = "W2", stock = 50, reorderLevel = 5, status = 1, supplierId = sup });
+        Assert.AreEqual(HttpStatusCode.OK, u.StatusCode);
+        Assert.AreEqual(1, (await Json(u)).GetProperty("status").GetInt32());
+        var s = await Json(await c.GetAsync($"/suppliers/{sup}"));
+        Assert.AreEqual(1, s.GetProperty("products").GetArrayLength());
+        Assert.AreEqual(1, (await Json(await c.GetAsync("/products"))).GetArrayLength());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await c.DeleteAsync($"/products/{id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await c.GetAsync($"/products/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(5, 5, 0, true)]
+    [DataRow(4, 5, 0, true)]
+    [DataRow(6, 5, 0, false)]
+    [DataRow(0, 5, 1, false)]
+    public async Task NeedsReorder(int stock, int level, int status, bool expected)
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var sup = await NewSupplier(c);
+        var p = await Json(await PostProduct(c, sup, "X", stock, level, status));
+        Assert.AreEqual(expected, p.GetProperty("needsReorder").GetBoolean());
+        var g = await Json(await c.GetAsync($"/products/{p.GetProperty("id").GetString()}"));
+        Assert.AreEqual(expected, g.GetProperty("needsReorder").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task Validation()
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var sup = await NewSupplier(c);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, sup, stock: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, sup, reorder: -1)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, sup, status: 7)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, sup, sku: new string('x', 21))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, sup, sku: "")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await PostProduct(c, Guid.NewGuid().ToString())).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await c.PostAsJsonAsync("/suppliers", new { name = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest,
+            (await c.PostAsJsonAsync("/suppliers", new { name = "ok", email = new string('x', 101) })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await c.PostAsJsonAsync("/suppliers", new { })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task UniqueConflicts()
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var sup = await NewSupplier(c, "A");
+        Assert.AreEqual(HttpStatusCode.Conflict, (await c.PostAsJsonAsync("/suppliers", new { name = "A" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Created, (await PostProduct(c, sup, "K")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await PostProduct(c, sup, "K")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIs404()
+    {
+        using var f = new Factory(); var c = f.CreateClient();
+        var id = Guid.NewGuid();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await c.GetAsync($"/products/{id}")).StatusCode);
+        var sup = await NewSupplier(c);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await c.PutAsJsonAsync($"/products/{id}",
+            new { sku = "S", name = "n", stock = 1, reorderLevel = 1, status = 0, supplierId = sup })).StatusCode);
+    }
+}
