+{
+    public Guid Id { get; set; }
+    // Property [S][NO][NAR][PUO]
+    public System.String Sku { get; set; } = string.Empty;
+
+    public System.String Name { get; set; } = string.Empty;
+
+    public System.Int32 Stock { get; set; } = default(System.Int32);
