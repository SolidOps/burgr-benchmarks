+    public System.Int32 ReorderLevel { get; set; } = default(System.Int32);
+
+    // Property [S][CA][NAR][PUO]
+    public System.Boolean NeedsReorder { get; set; } = default(System.Boolean);
+
+    // Property [E][NO][CA][NAR][PUO]
