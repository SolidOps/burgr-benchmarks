+    [TestMethod]
+    public async Task BookingFlow()
+    {
+        var vid = (await CreateVenue()).GetProperty("id").GetGuid();
+        var show = await CreateShow(vid, [new { name = "Std", price = 10.5m, quota = 3 }]);
+
+        var ok = await Book(show, quantity: 2);
+        Assert.AreEqual(HttpStatusCode.OK, ok.StatusCode, await ok.Content.ReadAsStringAsync());
+        var booking = await Body(ok);
+        Assert.AreEqual(21m, booking.GetProperty("totalPrice").GetDecimal());
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Book(show, quantity: 2)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Book(show, tier: "Nope")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Book(show, quantity: 1)).StatusCode);
+
+        var got = await Body(await Client.GetAsync($"/shows/{show.GetProperty("id").GetGuid()}"));
+        Assert.AreEqual(3, got.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+        Assert.IsTrue(got.GetProperty("isSoldOut").GetBoolean());
+
+        // sold is kept on update
+        var tier = got.GetProperty("ticketTiers")[0];
+        var put = await Client.PutAsJsonAsync($"/shows/{show.GetProperty("id").GetGuid()}",
+            ShowBody(vid, [new { id = tier.GetProperty("id").GetGuid(), name = "Std", price = 10.5m, quota = 3, sold = 0 }]));
+        Assert.AreEqual(3, (await Body(put)).GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+
+        var id = booking.GetProperty("id").GetGuid();
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/bookings/{id}")).StatusCode);
+        Assert.AreEqual(2, (await Body(await Client.GetAsync("/bookings"))).GetProperty("totalCount").GetInt32());
+
+        // deletions refused
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/shows/{show.GetProperty("id").GetGuid()}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/venues/{vid}")).StatusCode);
+    }
