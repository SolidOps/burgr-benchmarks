+namespace Acme.Ticketing.Application;
+
+public partial class ShowService
+{
+    private async partial Task<Error?> CheckCapacityAsync(Domain.Show aggregate, CancellationToken cancellationToken)
+    {
+        var venue = await VenueRepository.FindAsync(aggregate.VenueId, cancellationToken);
+        if (venue is null)
+        {
+            return Error.Invalid(new Dictionary<string, string[]> { ["VenueId"] = ["Venue not found"] });
+        }
+        var total = aggregate.TicketTiers.Sum(t => (long)t.Quota);
+        if (total > venue.Capacity)
+        {
+            return Error.Invalid(new Dictionary<string, string[]>
+            {
+                ["TicketTiers"] = [$"The quotas ({total}) exceed the capacity of the venue ({venue.Capacity})"]
+            });
+        }
+        return null;
+    }
+}
