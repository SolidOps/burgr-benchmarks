+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text;
+using System.Text.Json;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class TicketingTests : ApiTestBase
+{
+    private static JsonElement Json(string s) => JsonDocument.Parse(s).RootElement;
+
+    private static async Task<JsonElement> Body(HttpResponseMessage r) => Json(await r.Content.ReadAsStringAsync());
+
+    private async Task<JsonElement> CreateVenue(string name = "Arena", int capacity = 100)
+    {
+        var r = await Client.PostAsJsonAsync("/venues", new { name, capacity, address = new { street = "1 Main", city = "Paris", postalCode = "75001" } });
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode, await r.Content.ReadAsStringAsync());
+        return await Body(r);
+    }
+
+    private object ShowBody(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null) => new
+    {
+        title = "Concert",
+        startsAt = startsAt ?? DateTime.UtcNow.AddDays(10),
+        status,
+        venueId,
+        ticketTiers = tiers ?? [new { name = "Std", price = 10.5m, quota = 5 }],
+    };
+
+    private async Task<JsonElement> CreateShow(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null)
+    {
+        var r = await Client.PostAsJsonAsync("/shows", ShowBody(venueId, tiers, status, startsAt));
+        Assert.AreEqual(HttpStatusCode.Created, r.StatusCode, await r.Content.ReadAsStringAsync());
+        return await Body(r);
+    }
+
+    private Task<HttpResponseMessage> Book(JsonElement show, string tier = "Std", string email = "a@b.c", int quantity = 1) =>
+        Client.PostAsJsonAsync("/box-office/book", new { showId = show.GetProperty("id").GetGuid(), tier, customerEmail = email, quantity });
+
+    [TestMethod]
+    public async Task VenueRoundTripAndUniqueName()
+    {
+        var venue = await CreateVenue();
+        var id = venue.GetProperty("id").GetGuid();
+        Assert.AreEqual("Paris", venue.GetProperty("address").GetProperty("city").GetString());
+
+        var dup = await Client.PostAsJsonAsync("/venues", new { name = "Arena", capacity = 1, address = new { street = "s", city = "c", postalCode = "p" } });
+        Assert.AreEqual(HttpStatusCode.Conflict, dup.StatusCode);
+
+        var put = await Client.PutAsJsonAsync($"/venues/{id}", new { name = "Arena2", capacity = 5, address = new { street = "s", city = "c", postalCode = "p" } });
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode);
+        Assert.AreEqual("Arena2", (await Body(put)).GetProperty("name").GetString());
+
+        var page = await Body(await Client.GetAsync("/venues?orderBy=Name&descending=true&pageSize=10"));
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(1, page.GetProperty("pageNumber").GetInt32());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/venues/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task InvalidPagingAndVenueBody()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Client.GetAsync("/venues?page=0")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Client.GetAsync("/venues?pageSize=201")).StatusCode);
+        var r = await Client.PostAsJsonAsync("/venues", new { name = "", capacity = 1, address = new { street = "s", city = "c", postalCode = "p" } });
+        await AssertInvalidAsync(r, "Name");
+    }
+
+    [TestMethod]
+    public async Task ShowLifecycleTiersAndSoldOut()
+    {
+        var venue = await CreateVenue();
+        var vid = venue.GetProperty("id").GetGuid();
+        var show = await CreateShow(vid, [new { name = "A", price = 5m, quota = 2, sold = 99 }, new { name = "B", price = 7m, quota = 3 }]);
+        var id = show.GetProperty("id").GetGuid();
+        Assert.AreEqual(2, show.GetProperty("ticketTiers").GetArrayLength());
+        Assert.AreEqual(0, show.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+
+        var venueGet = await Body(await Client.GetAsync($"/venues/{vid}"));
+        Assert.AreEqual(1, venueGet.GetProperty("shows").GetArrayLength());
+
+        // update: keep A (with its id), drop B, add C
+        var a = show.GetProperty("ticketTiers").EnumerateArray().First(t => t.GetProperty("name").GetString() == "A");
+        var put = await Client.PutAsJsonAsync($"/shows/{id}", ShowBody(vid, [
+            new { id = a.GetProperty("id").GetGuid(), name = "A2", price = 5m, quota = 2, sold = 50 },
+            new { name = "C", price = 1m, quota = 1 }]));
+        Assert.AreEqual(HttpStatusCode.OK, put.StatusCode, await put.Content.ReadAsStringAsync());
+        var updated = await Body(put);
+        Assert.AreEqual(2, updated.GetProperty("ticketTiers").GetArrayLength());
+
+        var get = await Body(await Client.GetAsync($"/shows/{id}"));
+        Assert.IsFalse(get.GetProperty("isSoldOut").GetBoolean());
+        Assert.AreEqual(1, get.GetProperty("status").GetInt32());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/shows/{id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ShowValidation()
+    {
+        var venue = await CreateVenue(capacity: 10);
+        var vid = venue.GetProperty("id").GetGuid();
+        var tooMany = await Client.PostAsJsonAsync("/shows", ShowBody(vid, [new { name = "A", price = 1m, quota = 6 }, new { name = "B", price = 1m, quota = 5 }]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, tooMany.StatusCode);
+        var unknownVenue = await Client.PostAsJsonAsync("/shows", ShowBody(Guid.NewGuid()));
