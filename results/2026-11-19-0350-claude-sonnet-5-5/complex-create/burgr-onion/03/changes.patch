+using Microsoft.Extensions.DependencyInjection;
+
+namespace Acme.Ticketing.Application;
+
+public partial class BoxOfficeService
+{
+    public async Task<Result<BookingDto>> BookAsync(BookRequestDto request, CancellationToken cancellationToken = default)
+    {
+        var show = await ShowRepository.FindAsync(request.ShowId, cancellationToken);
+        if (show is null)
+        {
+            return Error.NotFound("Show not found");
+        }
+        if (show.Status != Domain.ShowStatus.on_sale)
+        {
+            return Error.Conflict("The show is not on sale");
+        }
+        var startsAt = DateTime.SpecifyKind(show.StartsAt, DateTimeKind.Utc);
+        if (startsAt < DateTime.UtcNow)
+        {
+            return Error.Conflict("The show has already started");
+        }
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == request.Tier);
+        if (tier is null)
+        {
+            return Error.Invalid(new Dictionary<string, string[]> { ["Tier"] = ["Tier not found"] });
+        }
+        if (tier.Quota - tier.SoldCount < request.Quantity)
+        {
+            return Error.Conflict("Not enough tickets left");
+        }
+
+        tier.SoldCount += request.Quantity;
+        var booking = new Domain.Booking
+        {
+            ShowId = show.Id,
+            Tier = tier.Name,
+            CustomerEmail = request.CustomerEmail,
+            Quantity = request.Quantity,
+            TotalPrice = tier.Price * request.Quantity,
+        };
+        Services.GetRequiredService<Domain.IBookingRepository>().Add(booking);
+        if (await UnitOfWork.SaveChangesAsync(cancellationToken) is { } error)
+        {
+            return error;
+        }
+        return BookingDto.From(booking);
+    }
+}
