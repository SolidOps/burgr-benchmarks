+    // Service 
+    private static void MapBoxOfficeEndpoints(RouteGroupBuilder group)
+    {
+
+        group.MapPost("/book", async ([FromBody] Acme.Ticketing.Application.BookRequestDto request, IBoxOfficeService service, CancellationToken cancellationToken) =>
+            (await service.BookAsync(request, cancellationToken)).ToHttpResult())
