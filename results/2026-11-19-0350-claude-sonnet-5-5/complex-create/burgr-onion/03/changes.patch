+[TestClass]
+public class JwtTests : ApiTestBase
+{
+    protected override bool UseTestAuthentication => false;
+
+    protected override void ConfigureWebHost(Microsoft.AspNetCore.Hosting.IWebHostBuilder builder) =>
+        builder.UseSetting("Jwt:Key", "secret");
+
+    private static string Token(string key, DateTime? expires = null, params string[] rights)
+    {
+        var creds = new SigningCredentials(new SymmetricSecurityKey(Encoding.UTF8.GetBytes(key.PadRight(32))), SecurityAlgorithms.HmacSha256);
+        var jwt = new JwtSecurityToken(claims: rights.Select(r => new Claim("right", r)), notBefore: DateTime.UtcNow.AddMinutes(-10),
+            expires: expires ?? DateTime.UtcNow.AddHours(1), signingCredentials: creds);
+        return new JwtSecurityTokenHandler().WriteToken(jwt);
+    }
+
+    private async Task<HttpStatusCode> Get(string? token)
+    {
+        using var req = new HttpRequestMessage(HttpMethod.Get, "/venues");
+        if (token is not null) req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        return (await Client.SendAsync(req)).StatusCode;
+    }
+
+    [TestMethod]
+    public async Task TokenValidation()
+    {
+        Unauthenticate();
+        Assert.AreEqual(HttpStatusCode.Unauthorized, await Get(null));
+        Assert.AreEqual(HttpStatusCode.Unauthorized, await Get(Token("other")));
+        Assert.AreEqual(HttpStatusCode.Unauthorized, await Get(Token("secret", DateTime.UtcNow.AddMinutes(-5))));
+        Assert.AreEqual(HttpStatusCode.OK, await Get(Token("secret")));
+    }
+
+    [TestMethod]
+    public async Task RightClaimsAreRead()
+    {
+        Unauthenticate();
+        var body = new { name = "V", capacity = 1, address = new { street = "s", city = "c", postalCode = "p" } };
+        async Task<HttpStatusCode> Post(string t)
+        {
+            using var req = new HttpRequestMessage(HttpMethod.Post, "/venues") { Content = JsonContent.Create(body) };
+            req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", t);
+            return (await Client.SendAsync(req)).StatusCode;
+        }
+        Assert.AreEqual(HttpStatusCode.Forbidden, await Post(Token("secret")));
+        Assert.AreEqual(HttpStatusCode.Created, await Post(Token("secret", null, "*")));
+    }
+}
