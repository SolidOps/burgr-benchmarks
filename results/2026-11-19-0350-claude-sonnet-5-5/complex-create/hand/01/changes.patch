+using System.Linq.Expressions;
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public abstract class EfRepository<T>(TicketingDbContext db) : IRepository<T> where T : Entity
+{
+    protected TicketingDbContext Db => db;
+
+    /// <summary>The base query, with the includes of the aggregate.</summary>
+    protected virtual IQueryable<T> Query() => db.Set<T>();
+
+    public Task<T?> GetAsync(Guid id) => Query().FirstOrDefaultAsync(e => e.Id == id);
+
+    public void Add(T entity) => db.Set<T>().Add(entity);
+
+    public void Remove(T entity) => db.Set<T>().Remove(entity);
+
+    public async Task<Page<T>> QueryAsync(PageQuery query)
+    {
+        var source = Query();
+        var total = await source.CountAsync();
+        var property = Paging.OrderableProperties(typeof(T)).First(p => p.Name == (query.OrderBy ?? nameof(Entity.Id)));
+        var skip = (query.Page - 1) * query.PageSize;
+
+        // SQLite cannot order by a decimal: sort those in memory.
+        if (property.PropertyType == typeof(decimal))
+        {
+            var all = await source.ToListAsync();
+            Func<T, decimal> key = e => (decimal)property.GetValue(e)!;
+            var sorted = (query.Descending ? all.OrderByDescending(key) : all.OrderBy(key)).ThenBy(e => e.Id);
+            return new Page<T>(sorted.Skip(skip).Take(query.PageSize).ToList(), total);
+        }
+
+        var parameter = Expression.Parameter(typeof(T), "e");
+        var selector = Expression.Lambda(Expression.Property(parameter, property), parameter);
+        var call = Expression.Call(typeof(Queryable), query.Descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy),
+            [typeof(T), property.PropertyType], source.Expression, Expression.Quote(selector));
+        var ordered = (IOrderedQueryable<T>)source.Provider.CreateQuery<T>(call);
+        return new Page<T>(await ordered.ThenBy(e => e.Id).Skip(skip).Take(query.PageSize).ToListAsync(), total);
+    }
+}
