+++ b/src/Ticketing.Infrastructure/TicketingDbContext.cs
@@ -0,0 +1,45 @@
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public sealed class TicketingDbContext(DbContextOptions<TicketingDbContext> options) : DbContext(options)
+{
+    public DbSet<Venue> Venues => Set<Venue>();
+    public DbSet<Show> Shows => Set<Show>();
+    public DbSet<TicketTier> TicketTiers => Set<TicketTier>();
+    public DbSet<Booking> Bookings => Set<Booking>();
+
+    protected override void OnModelCreating(ModelBuilder model)
+    {
+        foreach (var entity in new[] { typeof(Venue), typeof(Show), typeof(TicketTier), typeof(Booking) })
+            model.Entity(entity).Property(nameof(Entity.Id)).ValueGeneratedNever();
+
+        model.Entity<Venue>(b =>
+        {
+            b.Property(v => v.Name).HasMaxLength(100);
+            b.HasIndex(v => v.Name).IsUnique();
+            b.ComplexProperty(v => v.Address, a => a.ToJson());
+            b.HasMany(v => v.Shows).WithOne(s => s.Venue).HasForeignKey(s => s.VenueId).OnDelete(DeleteBehavior.Restrict);
+        });
+
+        model.Entity<Show>(b =>
+        {
+            b.Property(s => s.Title).HasMaxLength(200);
+            b.Property(s => s.StartsAt).HasConversion(v => v, v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+            b.HasMany(s => s.TicketTiers).WithOne().HasForeignKey(t => t.ShowId).OnDelete(DeleteBehavior.Cascade);
+        });
+
+        model.Entity<TicketTier>(b =>
+        {
+            b.Property(t => t.Name).HasMaxLength(50);
+            b.Property(t => t.Sold).IsConcurrencyToken();
+        });
+
+        model.Entity<Booking>(b =>
+        {
+            b.HasOne<Show>().WithMany().HasForeignKey(x => x.ShowId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
