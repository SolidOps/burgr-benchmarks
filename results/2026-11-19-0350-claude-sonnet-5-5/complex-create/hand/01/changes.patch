@@ -0,0 +1,129 @@
+using System.Net;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class ShowTests : TestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var venue = await CreateVenue();
+        var (status, created) = await Post("/shows", ShowBody(venue, [Tier("Standard", 12.5m, 40)], status: 0));
+        Assert.AreEqual(HttpStatusCode.Created, status);
+        var id = created!["id"]!.GetValue<string>();
+        Assert.AreEqual(0, created["status"]!.GetValue<int>());
+        Assert.AreEqual(venue, created["venueId"]!.GetValue<string>());
+        Assert.AreEqual(12.5m, created["ticketTiers"]![0]!["price"]!.GetValue<decimal>());
+        Assert.AreEqual(0, created["ticketTiers"]![0]!["sold"]!.GetValue<int>());
+
+        var (_, got) = await Get($"/shows/{id}");
+        Assert.IsFalse(got!["isSoldOut"]!.GetValue<bool>());
+        Assert.AreEqual("Concert", got["title"]!.GetValue<string>());
+
+        var (putStatus, updated) = await Put($"/shows/{id}", ShowBody(venue, [], status: 2, title: "Renamed"));
+        Assert.AreEqual(HttpStatusCode.OK, putStatus);
+        Assert.AreEqual(2, updated!["status"]!.GetValue<int>());
+        Assert.AreEqual(0, updated["ticketTiers"]!.AsArray().Count);
+
+        var (_, page) = await Get("/shows?orderBy=Title");
+        Assert.AreEqual(1, page!["totalCount"]!.GetValue<int>());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/shows/{id}")).Status);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/shows/{id}")).Status);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Put($"/shows/{id}", ShowBody(venue))).Status);
+    }
+
+    [TestMethod]
+    public async Task TiersAreSynchronizedByTheWholeList()
+    {
+        var venue = await CreateVenue(capacity: 100);
+        var show = await CreateShow(venue, [Tier("A", 10, 10), Tier("B", 20, 20), Tier("C", 30, 30)]);
+        var id = show["id"]!.GetValue<string>();
+        var tiers = show["ticketTiers"]!.AsArray();
+        string TierId(string name) => tiers.First(t => t!["name"]!.GetValue<string>() == name)!["id"]!.GetValue<string>();
+
+        var (status, updated) = await Put($"/shows/{id}", ShowBody(venue, [Tier("A", 11, 15, TierId("A")), Tier("D", 40, 40)]));
+        Assert.AreEqual(HttpStatusCode.OK, status, updated?.ToJsonString());
+        var result = updated!["ticketTiers"]!.AsArray();
+        Assert.AreEqual(2, result.Count);
+        var a = result.First(t => t!["name"]!.GetValue<string>() == "A")!;
+        Assert.AreEqual(TierId("A"), a["id"]!.GetValue<string>());
+        Assert.AreEqual(11m, a["price"]!.GetValue<decimal>());
+        Assert.AreEqual(15, a["quota"]!.GetValue<int>());
+        Assert.IsTrue(result.Any(t => t!["name"]!.GetValue<string>() == "D"));
+
+        var (_, got) = await Get($"/shows/{id}");
+        Assert.AreEqual(2, got!["ticketTiers"]!.AsArray().Count);
+    }
+
+    [TestMethod]
+    public async Task SoldInTheBodyIsIgnored()
+    {
+        var venue = await CreateVenue();
+        var (_, show) = await Post("/shows", ShowBody(venue, [new { name = "A", price = 1, quota = 5, sold = 5 }]));
+        Assert.AreEqual(0, show!["ticketTiers"]![0]!["sold"]!.GetValue<int>());
+    }
+
+    [TestMethod]
+    public async Task Invalid_Bodies()
+    {
+        var venue = await CreateVenue(capacity: 10);
+
+        var (s1, b1) = await Post("/shows", ShowBody(venue, [Tier("A", 1, 6), Tier("B", 1, 5)]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, s1);
+        CollectionAssert.Contains(ErrorKeys(b1).ToList(), "ticketTiers");
+
+        var (s2, b2) = await Post("/shows", ShowBody(Guid.NewGuid().ToString()));
+        Assert.AreEqual(HttpStatusCode.BadRequest, s2);
+        CollectionAssert.Contains(ErrorKeys(b2).ToList(), "venueId");
+
+        var (s3, b3) = await Post("/shows", ShowBody(venue, status: 7));
+        Assert.AreEqual(HttpStatusCode.BadRequest, s3);
+        CollectionAssert.Contains(ErrorKeys(b3).ToList(), "status");
+
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(venue, status: 1) is var _ ? new { title = "x", startsAt = DateTime.UtcNow, status = "Bogus", venueId = venue } : null!)).Status);
+
+        var (s4, b4) = await Post("/shows", new { title = "", venueId = venue, ticketTiers = new[] { new { name = "", price = -1, quota = -1 } } });
+        Assert.AreEqual(HttpStatusCode.BadRequest, s4);
+        var keys = ErrorKeys(b4);
+        foreach (var key in new[] { "title", "startsAt", "ticketTiers[0].name", "ticketTiers[0].price", "ticketTiers[0].quota" })
+            CollectionAssert.Contains(keys.ToList(), key);
+
+        var show = await CreateShow(venue, [Tier("A", 1, 1)]);
+        var (s5, b5) = await Put($"/shows/{show["id"]}", ShowBody(venue, [Tier("X", 1, 1, Guid.NewGuid().ToString())]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, s5);
+        CollectionAssert.Contains(ErrorKeys(b5).ToList(), "ticketTiers[0].id");
+
+        var (s6, _) = await Put($"/shows/{show["id"]}", ShowBody(venue, [Tier("A", 1, 11)]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, s6);
+    }
+
+    [TestMethod]
+    public async Task IsSoldOut_WhenEveryTierIsSoldOut()
+    {
+        var venue = await CreateVenue();
+        var none = await CreateShow(venue);
+        Assert.IsFalse((await Get($"/shows/{none["id"]}")).Body!["isSoldOut"]!.GetValue<bool>());
+
+        var show = await CreateShow(venue, [Tier("A", 5, 1), Tier("B", 5, 1)]);
+        var id = show["id"]!.GetValue<string>();
+        await Post("/box-office/book", Book(id, "A"));
+        Assert.IsFalse((await Get($"/shows/{id}")).Body!["isSoldOut"]!.GetValue<bool>());
+        await Post("/box-office/book", Book(id, "B"));
+        Assert.IsTrue((await Get($"/shows/{id}")).Body!["isSoldOut"]!.GetValue<bool>());
+    }
+
+    [TestMethod]
+    public async Task ShowWithBookings_CannotBeDeleted_ShowWithoutDeletesItsTiers()
+    {
+        var venue = await CreateVenue();
+        var booked = await CreateShow(venue, [Tier("Standard", 5, 5)]);
+        Assert.AreEqual(HttpStatusCode.OK, (await Post("/box-office/book", Book(booked["id"]!.GetValue<string>()))).Status);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Delete($"/shows/{booked["id"]}")).Status);
+
+        var free = await CreateShow(venue, [Tier("Standard", 5, 5)]);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/shows/{free["id"]}")).Status);
+        Assert.AreEqual(1, (await Get("/shows")).Body!["totalCount"]!.GetValue<int>());
+    }
+}
