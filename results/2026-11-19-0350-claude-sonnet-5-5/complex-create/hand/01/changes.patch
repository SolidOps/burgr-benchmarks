+using Acme.Ticketing.Api.Framework;
+using Acme.Ticketing.Application;
+
+namespace Acme.Ticketing.Api.Endpoints;
+
+public static class Endpoints
+{
+    public static void MapTicketing(this IEndpointRouteBuilder app)
+    {
+        var venues = app.MapGroup("/venues");
+        venues.MapGet("/", async (VenueService s, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            (await s.QueryAsync(new(page, pageSize, orderBy, descending))).ToHttp());
+        venues.MapGet("/{id:guid}", async (Guid id, VenueService s) => (await s.GetAsync(id)).ToHttp());
+        venues.MapPost("/", async (VenueInput input, VenueService s) =>
+            (await s.AddAsync(input)).ToHttp(v => Results.Created($"/venues/{v.Id}", v))).RequireAuthorization(Rights.ManageVenues);
+        venues.MapPut("/{id:guid}", async (Guid id, VenueInput input, VenueService s) =>
+            (await s.UpdateAsync(id, input)).ToHttp()).RequireAuthorization(Rights.ManageVenues);
+        venues.MapDelete("/{id:guid}", async (Guid id, VenueService s) =>
+            (await s.RemoveAsync(id)).ToHttp(_ => Results.NoContent())).RequireAuthorization(Rights.ManageVenues);
+
+        var shows = app.MapGroup("/shows");
+        shows.MapGet("/", async (ShowService s, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            (await s.QueryAsync(new(page, pageSize, orderBy, descending))).ToHttp());
+        shows.MapGet("/{id:guid}", async (Guid id, ShowService s) => (await s.GetAsync(id)).ToHttp());
+        shows.MapPost("/", async (ShowInput input, ShowService s) =>
+            (await s.AddAsync(input)).ToHttp(v => Results.Created($"/shows/{v.Id}", v))).RequireAuthorization(Rights.ManageShows);
+        shows.MapPut("/{id:guid}", async (Guid id, ShowInput input, ShowService s) =>
+            (await s.UpdateAsync(id, input)).ToHttp()).RequireAuthorization(Rights.ManageShows);
+        shows.MapDelete("/{id:guid}", async (Guid id, ShowService s) =>
+            (await s.RemoveAsync(id)).ToHttp(_ => Results.NoContent())).RequireAuthorization(Rights.ManageShows);
+
+        var bookings = app.MapGroup("/bookings").RequireAuthorization(Rights.ManageShows);
+        bookings.MapGet("/", async (BookingService s, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            (await s.QueryAsync(new(page, pageSize, orderBy, descending))).ToHttp());
+        bookings.MapGet("/{id:guid}", async (Guid id, BookingService s) => (await s.GetAsync(id)).ToHttp());
+
+        app.MapPost("/box-office/book", async (BookingInput input, BoxOfficeService s) => (await s.BookAsync(input)).ToHttp());
+    }
+}
