+using System.Text.Json.Serialization;
+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public sealed record AddressDto(string Street, string City, string PostalCode);
+
+public sealed record VenueDto(
+    Guid Id, string Name, AddressDto Address, int Capacity,
+    [property: JsonIgnore(Condition = JsonIgnoreCondition.WhenWritingNull)] IReadOnlyList<ShowDto>? Shows = null);
+
+public sealed record TicketTierDto(Guid Id, string Name, decimal Price, int Quota, int Sold);
+
+public sealed record ShowDto(
+    Guid Id, string Title, DateTime StartsAt, ShowStatus Status, Guid VenueId,
+    IReadOnlyList<TicketTierDto> TicketTiers, bool IsSoldOut);
+
+public sealed record BookingDto(Guid Id, Guid ShowId, string Tier, string CustomerEmail, int Quantity, decimal TotalPrice);
+
+public static class Mappings
+{
+    public static VenueDto ToDto(this Venue v, bool withShows = false) =>
+        new(v.Id, v.Name, new AddressDto(v.Address.Street, v.Address.City, v.Address.PostalCode), v.Capacity,
+            withShows ? v.Shows.OrderBy(s => s.StartsAt).ThenBy(s => s.Id).Select(s => s.ToDto()).ToList() : null);
+
+    public static ShowDto ToDto(this Show s) =>
+        new(s.Id, s.Title, s.StartsAt, s.Status, s.VenueId,
+            s.TicketTiers.Select(t => new TicketTierDto(t.Id, t.Name, t.Price, t.Quota, t.Sold)).ToList(), s.IsSoldOut);
+
+    public static BookingDto ToDto(this Booking b) =>
+        new(b.Id, b.ShowId, b.Tier, b.CustomerEmail, b.Quantity, b.TotalPrice);
+}
