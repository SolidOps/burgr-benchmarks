@@ -0,0 +1,20 @@
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+public abstract class ServiceBase(IUnitOfWork unitOfWork)
+{
+    /// <summary>Commits; a violated unique index or foreign key is a conflict.</summary>
+    protected async Task<Error?> CommitAsync(string conflictMessage)
+    {
+        try
+        {
+            await unitOfWork.CommitAsync();
+            return null;
+        }
+        catch (ConflictException)
+        {
+            return Error.Conflict(conflictMessage);
+        }
+    }
+}
