+using System.Net;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class BoxOfficeTests : TestBase
+{
+    private async Task<string> OnSaleShow(int status = 1, DateTime? startsAt = null, int quota = 5)
+    {
+        var venue = await CreateVenue(Guid.NewGuid().ToString("N"));
+        var show = await CreateShow(venue, [Tier("Standard", 12.5m, quota)], status, startsAt);
+        return show["id"]!.GetValue<string>();
+    }
+
+    private async Task<HttpStatusCode> BookStatus(string showId, string tier = "Standard", int quantity = 1, string email = "a@b.c") =>
+        (await Post("/box-office/book", Book(showId, tier, quantity, email))).Status;
+
+    [TestMethod]
+    public async Task Booking_IncreasesSold_AndIsListed()
+    {
+        var show = await OnSaleShow();
+        var (status, booking) = await Post("/box-office/book", Book(show, quantity: 3, email: "x@y.z"));
+        Assert.AreEqual(HttpStatusCode.OK, status);
+        Assert.AreEqual(37.5m, booking!["totalPrice"]!.GetValue<decimal>());
+        Assert.AreEqual("Standard", booking["tier"]!.GetValue<string>());
+        Assert.AreEqual(show, booking["showId"]!.GetValue<string>());
+
+        Assert.AreEqual(3, (await Get($"/shows/{show}")).Body!["ticketTiers"]![0]!["sold"]!.GetValue<int>());
+
+        var (_, got) = await Get($"/bookings/{booking["id"]}");
+        Assert.AreEqual("x@y.z", got!["customerEmail"]!.GetValue<string>());
+        var (_, page) = await Get("/bookings?orderBy=TotalPrice&descending=true");
+        Assert.AreEqual(1, page!["totalCount"]!.GetValue<int>());
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/bookings/{Guid.NewGuid()}")).Status);
+        Assert.AreEqual(HttpStatusCode.MethodNotAllowed, (await Delete($"/bookings/{booking["id"]}")).Status);
+    }
+
+    [TestMethod]
+    public async Task Quantity_And_Email_AreValidatedFirst()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest, await BookStatus(Guid.NewGuid().ToString(), quantity: 0));
+        Assert.AreEqual(HttpStatusCode.BadRequest, await BookStatus(Guid.NewGuid().ToString(), quantity: 11));
+        Assert.AreEqual(HttpStatusCode.BadRequest, await BookStatus(Guid.NewGuid().ToString(), email: "nope"));
+        Assert.AreEqual(HttpStatusCode.NotFound, await BookStatus(Guid.NewGuid().ToString()));
+        var show = await OnSaleShow(quota: 20);
+        Assert.AreEqual(HttpStatusCode.OK, await BookStatus(show, quantity: 10));
+    }
+
+    [TestMethod]
+    public async Task ShowMustBeOnSale_AndInTheFuture()
+    {
+        Assert.AreEqual(HttpStatusCode.Conflict, await BookStatus(await OnSaleShow(status: 0)));
+        Assert.AreEqual(HttpStatusCode.Conflict, await BookStatus(await OnSaleShow(status: 2)));
+        Assert.AreEqual(HttpStatusCode.Conflict, await BookStatus(await OnSaleShow(startsAt: DateTime.UtcNow.AddDays(-1))));
+    }
+
+    [TestMethod]
+    public async Task UnknownTier_Is400_BeforeStockCheck()
+    {
+        var show = await OnSaleShow();
+        var (status, body) = await Post("/box-office/book", Book(show, "VIP", quantity: 10));
+        Assert.AreEqual(HttpStatusCode.BadRequest, status);
+        CollectionAssert.Contains(ErrorKeys(body).ToList(), "tier");
+    }
+
+    [TestMethod]
+    public async Task NotEnoughTickets_Is409_AndNothingChanges()
+    {
+        var show = await OnSaleShow(quota: 5);
+        Assert.AreEqual(HttpStatusCode.OK, await BookStatus(show, quantity: 4));
+        Assert.AreEqual(HttpStatusCode.Conflict, await BookStatus(show, quantity: 2));
+        Assert.AreEqual(4, (await Get($"/shows/{show}")).Body!["ticketTiers"]![0]!["sold"]!.GetValue<int>());
+        Assert.AreEqual(1, (await Get("/bookings")).Body!["totalCount"]!.GetValue<int>());
+        Assert.AreEqual(HttpStatusCode.OK, await BookStatus(show, quantity: 1));
+        Assert.AreEqual(HttpStatusCode.Conflict, await BookStatus(show, quantity: 1));
+    }
+
+    [TestMethod]
+    public async Task QuotaCannotGoUnderSold()
+    {
+        var show = await OnSaleShow(quota: 5);
+        await BookStatus(show, quantity: 3);
+        var current = (await Get($"/shows/{show}")).Body!;
+        var tierId = current["ticketTiers"]![0]!["id"]!.GetValue<string>();
+        var venue = current["venueId"]!.GetValue<string>();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Put($"/shows/{show}", ShowBody(venue, [Tier("Standard", 1, 2, tierId)]))).Status);
+        Assert.AreEqual(HttpStatusCode.OK, (await Put($"/shows/{show}", ShowBody(venue, [Tier("Standard", 1, 3, tierId)]))).Status);
+    }
+}
diff --git a/src/Ticketing.Tests/Framework/TestBase.cs b/src/Ticketing.Tests/Framework/TestBase.cs
new file mode 100644
index 0000000..e9b8246
--- /dev/null
+++ b/src/Ticketing.Tests/Framework/TestBase.cs
@@ -0,0 +1,102 @@
+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Acme.Ticketing.Api.Framework;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Data.Sqlite;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests.Framework;
+
+/// <summary>A real host per test, with a throw-away SQLite database and a signed token.</summary>
+[TestClass]
+public abstract class TestBase
+{
+    protected const string JwtKey = "test-signing-key";
+    private string _db = "";
+    private WebApplicationFactory<Program> _factory = null!;
+    protected HttpClient Client { get; private set; } = null!;
+
+    [TestInitialize]
+    public void Start()
+    {
+        _db = Path.Combine(Path.GetTempPath(), $"ticketing-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+        {
+            b.UseSetting("ConnectionStrings:Ticketing", $"Data Source={_db}");
+            b.UseSetting("Jwt:Key", JwtKey);
+        });
+        Client = _factory.CreateClient();
+        Authenticate("*");
+    }
+
+    [TestCleanup]
+    public void Stop()
+    {
+        Client.Dispose();
+        _factory.Dispose();
+        SqliteConnection.ClearAllPools();
+        File.Delete(_db);
+    }
+
+    public static string Token(string[] rights, string key = JwtKey, DateTime? expires = null)
+    {
+        var claims = rights.Select(r => new Claim("right", r)).Append(new Claim("sub", "tester"));
+        var credentials = new SigningCredentials(new SymmetricSecurityKey(Security.KeyBytes(key)), SecurityAlgorithms.HmacSha256);
+        var now = DateTime.UtcNow;
+        var token = new JwtSecurityToken(claims: claims, notBefore: expires is null ? null : now.AddHours(-2),
+            expires: expires ?? now.AddHours(1), signingCredentials: credentials);
+        return new JwtSecurityTokenHandler().WriteToken(token);
+    }
+
+    protected void Authenticate(params string[] rights) =>
+        Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token(rights));
+
+    protected void Anonymous() => Client.DefaultRequestHeaders.Authorization = null;
+
+    protected async Task<(HttpStatusCode Status, JsonNode? Body)> Send(HttpMethod method, string url, object? body = null)
+    {
+        var request = new HttpRequestMessage(method, url);
+        if (body is not null) request.Content = JsonContent.Create(body);
+        var response = await Client.SendAsync(request);
+        var text = await response.Content.ReadAsStringAsync();
+        return (response.StatusCode, string.IsNullOrEmpty(text) ? null : JsonNode.Parse(text));
+    }
+
+    protected Task<(HttpStatusCode Status, JsonNode? Body)> Get(string url) => Send(HttpMethod.Get, url);
+    protected Task<(HttpStatusCode Status, JsonNode? Body)> Post(string url, object body) => Send(HttpMethod.Post, url, body);
+    protected Task<(HttpStatusCode Status, JsonNode? Body)> Put(string url, object body) => Send(HttpMethod.Put, url, body);
+    protected Task<(HttpStatusCode Status, JsonNode? Body)> Delete(string url) => Send(HttpMethod.Delete, url);
+
+    protected static object VenueBody(string name = "Arena", int capacity = 100) =>
+        new { name, address = new { street = "1 Main St", city = "Paris", postalCode = "75001" }, capacity };
+
+    protected static object ShowBody(string venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null, string title = "Concert") =>
+        new { title, startsAt = startsAt ?? DateTime.UtcNow.AddDays(10), status, venueId, ticketTiers = tiers ?? [] };
+
+    protected static object Tier(string name, decimal price, int quota, string? id = null) => new { id, name, price, quota };
+
+    protected async Task<string> CreateVenue(string name = "Arena", int capacity = 100)
+    {
+        var (status, body) = await Post("/venues", VenueBody(name, capacity));
+        Assert.AreEqual(HttpStatusCode.Created, status);
+        return body!["id"]!.GetValue<string>();
+    }
+
+    protected async Task<JsonNode> CreateShow(string venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null)
+    {
+        var (code, body) = await Post("/shows", ShowBody(venueId, tiers, status, startsAt));
+        Assert.AreEqual(HttpStatusCode.Created, code, body?.ToJsonString());
+        return body!;
+    }
+
+    protected static JsonNode Book(string showId, string tier = "Standard", int quantity = 1, string email = "a@b.c") =>
+        JsonNode.Parse(JsonSerializer.Serialize(new { showId, tier, customerEmail = email, quantity }))!;
+
+    protected static HashSet<string> ErrorKeys(JsonNode? body) =>
+        body!["errors"]!.AsObject().Select(p => p.Key).ToHashSet();
+}
diff --git a/src/Ticketing.Tests/SecurityTests.cs b/src/Ticketing.Tests/SecurityTests.cs
new file mode 100644
index 0000000..0b5e1c6
--- /dev/null
+++ b/src/Ticketing.Tests/SecurityTests.cs
@@ -0,0 +1,61 @@
+using System.Net;
+using System.Net.Http.Headers;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class SecurityTests : TestBase
+{
+    [TestMethod]
+    public async Task NoToken_Is401_OnEveryKindOfEndpoint()
+    {
+        Anonymous();
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get("/venues")).Status);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Post("/venues", VenueBody())).Status);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Post("/box-office/book", new { })).Status);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get("/bookings")).Status);
+    }
+
+    [TestMethod]
+    public async Task BadSignature_And_ExpiredToken_Are401()
+    {
+        Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token(["*"], key: "another-key"));
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get("/venues")).Status);
+        Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token(["*"], expires: DateTime.UtcNow.AddHours(-1)));
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get("/venues")).Status);
+    }
+
+    [TestMethod]
+    public async Task AuthenticatedWithoutRights_CanRead_ButNotWrite()
+    {
+        Authenticate();
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/venues")).Status);
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/shows")).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Post("/venues", VenueBody())).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Put($"/venues/{Guid.NewGuid()}", VenueBody())).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Delete($"/venues/{Guid.NewGuid()}")).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Post("/shows", ShowBody(Guid.NewGuid().ToString()))).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Delete($"/shows/{Guid.NewGuid()}")).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Get("/bookings")).Status);
+    }
+
+    [TestMethod]
+    public async Task EachRight_GrantsItsOwnArea()
+    {
+        Authenticate("ManageVenues");
+        Assert.AreEqual(HttpStatusCode.Created, (await Post("/venues", VenueBody())).Status);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Post("/shows", ShowBody(Guid.NewGuid().ToString()))).Status);
+        Authenticate("ManageShows");
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Post("/venues", VenueBody("Other"))).Status);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(Guid.NewGuid().ToString()))).Status);
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/bookings")).Status);
+    }
+
+    [TestMethod]
+    public async Task Booking_OnlyRequiresAuthentication()
+    {
+        Authenticate();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Post("/box-office/book", Book(Guid.NewGuid().ToString()))).Status);
+    }
+}
