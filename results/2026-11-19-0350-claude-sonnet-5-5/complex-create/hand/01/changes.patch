+using Acme.Ticketing.Application.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed record AddressInput(string? Street, string? City, string? PostalCode);
+
+public sealed record VenueInput(string? Name, AddressInput? Address, int? Capacity)
+{
+    public ValidationErrors Validate()
+    {
+        var e = new ValidationErrors();
+        e.Text("name", Name, 100);
+        if (Address is null) e.Add("address", "The address is required.");
+        else
+        {
+            e.Text("address.street", Address.Street, 100);
+            e.Text("address.city", Address.City, 50);
+            e.Text("address.postalCode", Address.PostalCode, 10);
+        }
+        if (Capacity is null) e.Add("capacity", "The capacity is required.");
+        else if (Capacity < 0) e.Add("capacity", "The capacity must not be negative.");
+        return e;
+    }
+}
+
+public sealed record TicketTierInput(Guid? Id, string? Name, decimal? Price, int? Quota)
+{
+    public void Validate(ValidationErrors e, string path)
+    {
+        e.Text($"{path}.name", Name, 50);
+        if (Price is null) e.Add($"{path}.price", "The price is required.");
+        else if (Price < 0) e.Add($"{path}.price", "The price must not be negative.");
+        if (Quota is null) e.Add($"{path}.quota", "The quota is required.");
+        else if (Quota < 0) e.Add($"{path}.quota", "The quota must not be negative.");
+    }
+}
+
+public sealed record ShowInput(string? Title, DateTime? StartsAt, int? Status, Guid? VenueId, List<TicketTierInput?>? TicketTiers)
+{
+    public ValidationErrors Validate()
+    {
+        var e = new ValidationErrors();
+        e.Text("title", Title, 200);
+        if (StartsAt is null) e.Add("startsAt", "The start date is required.");
+        if (Status is not null && !Enum.IsDefined(typeof(Domain.ShowStatus), Status.Value)) e.Add("status", "The status is unknown.");
+        if (VenueId is null || VenueId == Guid.Empty) e.Add("venueId", "The venue is required.");
+        for (var i = 0; i < (TicketTiers?.Count ?? 0); i++)
+        {
+            if (TicketTiers![i] is { } tier) tier.Validate(e, $"ticketTiers[{i}]");
+            else e.Add($"ticketTiers[{i}]", "The tier is required.");
+        }
+        return e;
+    }
+}
+
+public sealed record BookingInput(Guid? ShowId, string? Tier, string? CustomerEmail, int? Quantity);
