+++ b/src/Ticketing.Tests/VenueTests.cs
@@ -0,0 +1,98 @@
+using System.Net;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class VenueTests : TestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var (status, created) = await Post("/venues", VenueBody("Arena", 500));
+        Assert.AreEqual(HttpStatusCode.Created, status);
+        var id = created!["id"]!.GetValue<string>();
+        Assert.AreEqual("Paris", created["address"]!["city"]!.GetValue<string>());
+
+        var (_, got) = await Get($"/venues/{id}");
+        Assert.AreEqual(500, got!["capacity"]!.GetValue<int>());
+        Assert.AreEqual(0, got["shows"]!.AsArray().Count);
+
+        var (putStatus, updated) = await Put($"/venues/{id}", VenueBody("Arena 2", 600));
+        Assert.AreEqual(HttpStatusCode.OK, putStatus);
+        Assert.AreEqual("Arena 2", updated!["name"]!.GetValue<string>());
+
+        var (_, page) = await Get("/venues");
+        Assert.AreEqual(1, page!["totalCount"]!.GetValue<int>());
+        Assert.AreEqual(1, page["pageNumber"]!.GetValue<int>());
+        Assert.AreEqual(50, page["pageSize"]!.GetValue<int>());
+        Assert.IsNull(page["items"]![0]!["shows"]);
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/venues/{id}")).Status);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/venues/{id}")).Status);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Put($"/venues/{id}", VenueBody())).Status);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Delete($"/venues/{id}")).Status);
+    }
+
+    [TestMethod]
+    public async Task InvalidBody_IsValidationProblemWithPaths()
+    {
+        var (status, body) = await Post("/venues", new { name = new string('x', 101), address = new { street = "", city = new string('c', 51), postalCode = "12345678901" } });
+        Assert.AreEqual(HttpStatusCode.BadRequest, status);
+        CollectionAssert.IsSubsetOf(new[] { "name", "address.street", "address.city", "address.postalCode", "capacity" }, ErrorKeys(body).ToList());
+
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/venues", new { name = "x", capacity = 1 })).Status);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/venues", new { name = "x", capacity = "many" })).Status);
+    }
+
+    [TestMethod]
+    public async Task NameMustBeUnique()
+    {
+        await CreateVenue("Arena");
+        var other = await CreateVenue("Hall");
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Post("/venues", VenueBody("Arena"))).Status);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Put($"/venues/{other}", VenueBody("Arena"))).Status);
+        Assert.AreEqual(HttpStatusCode.OK, (await Put($"/venues/{other}", VenueBody("Hall", 7))).Status);
+    }
+
+    [TestMethod]
+    public async Task VenueWithShows_CannotBeDeleted_AndListsShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Delete($"/venues/{venue}")).Status);
+
+        var (_, got) = await Get($"/venues/{venue}");
+        Assert.AreEqual(show["id"]!.GetValue<string>(), got!["shows"]![0]!["id"]!.GetValue<string>());
+
+        await Delete($"/shows/{show["id"]}");
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/venues/{venue}")).Status);
+    }
+
+    [TestMethod]
+    public async Task CapacityCannotGoBelowTheQuotasOfItsShows()
+    {
+        var venue = await CreateVenue(capacity: 100);
+        await CreateShow(venue, [Tier("Standard", 10, 80)]);
+        var (status, body) = await Put($"/venues/{venue}", VenueBody("Arena", 50));
+        Assert.AreEqual(HttpStatusCode.BadRequest, status);
+        CollectionAssert.Contains(ErrorKeys(body).ToList(), "capacity");
+    }
+
+    [TestMethod]
+    public async Task Paging_And_Ordering()
+    {
+        foreach (var (name, capacity) in new[] { ("B", 20), ("A", 30), ("C", 10) }) await CreateVenue(name, capacity);
+
+        var (_, byName) = await Get("/venues?orderBy=Name");
+        CollectionAssert.AreEqual(new[] { "A", "B", "C" }, byName!["items"]!.AsArray().Select(i => i!["name"]!.GetValue<string>()).ToArray());
+        var (_, desc) = await Get("/venues?orderBy=Capacity&descending=true&page=2&pageSize=1");
+        Assert.AreEqual("B", desc!["items"]![0]!["name"]!.GetValue<string>());
+        Assert.AreEqual(3, desc["totalCount"]!.GetValue<int>());
+        Assert.AreEqual(2, desc["pageNumber"]!.GetValue<int>());
+        Assert.AreEqual(1, desc["items"]!.AsArray().Count);
+
+        foreach (var bad in new[] { "page=0", "pageSize=0", "pageSize=201", "orderBy=Nope", "orderBy=Address", "page=abc", "descending=maybe" })
+            Assert.AreEqual(HttpStatusCode.BadRequest, (await Get($"/venues?{bad}")).Status, bad);
+    }
+}
