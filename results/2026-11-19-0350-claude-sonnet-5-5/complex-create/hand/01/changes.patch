@@ -0,0 +1,61 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class VenueService(IVenueRepository venues, IShowRepository shows, IUnitOfWork unitOfWork) : ServiceBase(unitOfWork)
+{
+    private const string NameTaken = "A venue with this name already exists.";
+
+    public Task<Result<PagedResult<VenueDto>>> QueryAsync(PageRequest request) =>
+        Paging.QueryAsync(venues, request, v => v.ToDto());
+
+    public async Task<Result<VenueDto>> GetAsync(Guid id) =>
+        await venues.GetWithShowsAsync(id) is { } venue ? venue.ToDto(withShows: true) : Error.NotFound("Venue not found.");
+
+    public async Task<Result<VenueDto>> AddAsync(VenueInput input)
+    {
+        var errors = input.Validate();
+        if (errors.Any) return Error.Invalid(errors);
+        if (await venues.NameExistsAsync(input.Name!, null)) return Error.Conflict(NameTaken);
+
+        var venue = new Venue();
+        Apply(venue, input);
+        venues.Add(venue);
+        if (await CommitAsync(NameTaken) is { } error) return error;
+        return venue.ToDto();
+    }
+
+    public async Task<Result<VenueDto>> UpdateAsync(Guid id, VenueInput input)
+    {
+        if (await venues.GetAsync(id) is not { } venue) return Error.NotFound("Venue not found.");
+        var errors = input.Validate();
+        if (errors.Any) return Error.Invalid(errors);
+        if (await venues.NameExistsAsync(input.Name!, id)) return Error.Conflict(NameTaken);
+
+        var tooBig = (await shows.ListByVenueAsync(id)).Any(s => s.TicketTiers.Sum(t => t.Quota) > input.Capacity);
+        if (tooBig) return Error.Invalid("capacity", "The capacity is lower than the quotas of the shows of the venue.");
+
+        Apply(venue, input);
+        if (await CommitAsync(NameTaken) is { } error) return error;
+        return venue.ToDto();
+    }
+
+    public async Task<Result<Unit>> RemoveAsync(Guid id)
+    {
+        if (await venues.GetAsync(id) is not { } venue) return Error.NotFound("Venue not found.");
+        if (await venues.HasShowsAsync(id)) return Error.Conflict("The venue still has shows.");
+
+        venues.Remove(venue);
+        if (await CommitAsync("The venue still has shows.") is { } error) return error;
+        return default(Unit);
+    }
+
+    private static void Apply(Venue venue, VenueInput input)
+    {
+        venue.Name = input.Name!;
+        venue.Address = new Address { Street = input.Address!.Street!, City = input.Address.City!, PostalCode = input.Address.PostalCode! };
+        venue.Capacity = input.Capacity!.Value;
+    }
+}
