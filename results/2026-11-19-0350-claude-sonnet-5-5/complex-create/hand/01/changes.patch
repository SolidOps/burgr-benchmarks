+using Acme.Ticketing.Api.Endpoints;
+using Acme.Ticketing.Api.Framework;
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Infrastructure;
+using Microsoft.AspNetCore.Diagnostics;
+using Microsoft.AspNetCore.Http.Json;
+using Microsoft.EntityFrameworkCore;
+
+var builder = WebApplication.CreateBuilder(args);
+
+builder.Services.AddTicketingApplication();
+builder.Services.AddTicketingInfrastructure((sp, options) =>
+    options.UseSqlite(sp.GetRequiredService<IConfiguration>().GetConnectionString("Ticketing")));
+builder.Services.AddTicketingSecurity();
+builder.Services.Configure<RouteHandlerOptions>(o => o.ThrowOnBadRequest = true);
+
+var app = builder.Build();
+
+// An unreadable body (malformed JSON, wrong type...) is a validation problem.
+app.UseExceptionHandler(handler => handler.Run(async context =>
+{
+    var exception = context.Features.Get<IExceptionHandlerFeature>()?.Error;
+    if (exception is BadHttpRequestException bad)
+    {
+        context.Response.StatusCode = StatusCodes.Status400BadRequest;
+        await Results.ValidationProblem(new Dictionary<string, string[]> { ["body"] = [bad.Message] }).ExecuteAsync(context);
+    }
+    else
+    {
+        context.Response.StatusCode = StatusCodes.Status500InternalServerError;
+        await Results.Problem(statusCode: 500).ExecuteAsync(context);
+    }
+}));
+
+app.UseAuthentication();
+app.UseAuthorization();
+app.MapTicketing();
+
+await app.Services.EnsureTicketingDatabaseAsync();
+app.Run();
+
+public partial class Program;
