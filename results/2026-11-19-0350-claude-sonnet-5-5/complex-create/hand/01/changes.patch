@@ -0,0 +1,53 @@
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+using Acme.Ticketing.Infrastructure.Framework;
+using Microsoft.Data.Sqlite;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public sealed class VenueRepository(TicketingDbContext db) : EfRepository<Venue>(db), IVenueRepository
+{
+    public Task<Venue?> GetWithShowsAsync(Guid id) =>
+        Db.Venues.Include(v => v.Shows).ThenInclude(s => s.TicketTiers).FirstOrDefaultAsync(v => v.Id == id);
+
+    public Task<bool> NameExistsAsync(string name, Guid? exceptId) =>
+        Db.Venues.AnyAsync(v => v.Name == name && v.Id != exceptId);
+
+    public Task<bool> HasShowsAsync(Guid id) => Db.Shows.AnyAsync(s => s.VenueId == id);
+}
+
+public sealed class ShowRepository(TicketingDbContext db) : EfRepository<Show>(db), IShowRepository
+{
+    protected override IQueryable<Show> Query() => Db.Shows.Include(s => s.TicketTiers);
+
+    public void AddTier(TicketTier tier) => Db.TicketTiers.Add(tier);
+
+    public void RemoveTier(TicketTier tier) => Db.TicketTiers.Remove(tier);
+
+    public Task<bool> HasBookingsAsync(Guid showId) => Db.Bookings.AnyAsync(b => b.ShowId == showId);
+
+    public async Task<IReadOnlyList<Show>> ListByVenueAsync(Guid venueId) =>
+        await Query().Where(s => s.VenueId == venueId).ToListAsync();
+}
+
+public sealed class BookingRepository(TicketingDbContext db) : EfRepository<Booking>(db), IBookingRepository;
+
+public sealed class UnitOfWork(TicketingDbContext db) : IUnitOfWork
+{
+    public async Task CommitAsync()
+    {
+        try
+        {
+            await db.SaveChangesAsync();
+        }
+        catch (DbUpdateConcurrencyException e)
+        {
+            throw new ConflictException("The data was changed concurrently.", e);
+        }
+        catch (DbUpdateException e) when (e.InnerException is SqliteException { SqliteErrorCode: 19 })
+        {
+            throw new ConflictException("A unique or foreign key constraint is violated.", e);
+        }
+    }
+}
