+public sealed record Page<T>(IReadOnlyList<T> Items, int TotalCount);
+
+public interface IRepository<T> where T : Entity
+{
+    Task<T?> GetAsync(Guid id);
+    Task<Page<T>> QueryAsync(PageQuery query);
+    void Add(T entity);
+    void Remove(T entity);
+}
