+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class BookingService(IBookingRepository bookings)
+{
+    public Task<Result<PagedResult<BookingDto>>> QueryAsync(PageRequest request) =>
+        Paging.QueryAsync(bookings, request, b => b.ToDto());
+
+    public async Task<Result<BookingDto>> GetAsync(Guid id) =>
+        await bookings.GetAsync(id) is { } booking ? booking.ToDto() : Error.NotFound("Booking not found.");
+}
+
+public sealed class BoxOfficeService(IShowRepository shows, IBookingRepository bookings, IUnitOfWork unitOfWork, TimeProvider clock)
+    : ServiceBase(unitOfWork)
+{
+    public async Task<Result<BookingDto>> BookAsync(BookingInput input)
+    {
+        var errors = new ValidationErrors();
+        if (input.Quantity is not (>= 1 and <= 10)) errors.Add("quantity", "The quantity must be between 1 and 10.");
+        if (input.CustomerEmail is null || !input.CustomerEmail.Contains('@')) errors.Add("customerEmail", "The email is invalid.");
+        if (errors.Any) return Error.Invalid(errors);
+
+        if (input.ShowId is null || await shows.GetAsync(input.ShowId.Value) is not { } show) return Error.NotFound("Show not found.");
+        if (show.Status != ShowStatus.OnSale) return Error.Conflict("The show is not on sale.");
+        if (show.StartsAt <= clock.GetUtcNow().UtcDateTime) return Error.Conflict("The show has already started.");
+
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == input.Tier);
+        if (tier is null) return Error.Invalid("tier", "The show has no tier with this name.");
+
+        var quantity = input.Quantity!.Value;
+        if (tier.Remaining < quantity) return Error.Conflict("Not enough tickets left.");
+
+        tier.Sold += quantity;
+        var booking = new Booking
+        {
+            ShowId = show.Id, Tier = tier.Name, CustomerEmail = input.CustomerEmail!,
+            Quantity = quantity, TotalPrice = tier.Price * quantity,
+        };
+        bookings.Add(booking);
+        if (await CommitAsync("Not enough tickets left.") is { } error) return error;
+        return booking.ToDto();
+    }
+}
