+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class ShowService(IShowRepository shows, IVenueRepository venues, IUnitOfWork unitOfWork) : ServiceBase(unitOfWork)
+{
+    private const string Refused = "The show is referenced by other data.";
+
+    public Task<Result<PagedResult<ShowDto>>> QueryAsync(PageRequest request) =>
+        Paging.QueryAsync(shows, request, s => s.ToDto());
+
+    public async Task<Result<ShowDto>> GetAsync(Guid id) =>
+        await shows.GetAsync(id) is { } show ? show.ToDto() : Error.NotFound("Show not found.");
+
+    public async Task<Result<ShowDto>> AddAsync(ShowInput input)
+    {
+        var errors = input.Validate();
+        var venue = errors.Any || input.VenueId is null ? null : await venues.GetAsync(input.VenueId.Value);
+        if (!errors.Any && venue is null) errors.Add("venueId", "The venue does not exist.");
+        CheckCapacity(errors, input, venue, null);
+        if (errors.Any) return Error.Invalid(errors);
+
+        var show = new Show();
+        ApplyScalars(show, input);
+        shows.Add(show);
+        foreach (var tierInput in input.TicketTiers ?? [])
+        {
+            var tier = new TicketTier { ShowId = show.Id };
+            ApplyTier(tier, tierInput!);
+            show.TicketTiers.Add(tier);
+            shows.AddTier(tier);
+        }
+        if (await CommitAsync(Refused) is { } error) return error;
+        return show.ToDto();
+    }
+
+    public async Task<Result<ShowDto>> UpdateAsync(Guid id, ShowInput input)
+    {
+        if (await shows.GetAsync(id) is not { } show) return Error.NotFound("Show not found.");
+        var errors = input.Validate();
+        var venue = errors.Any || input.VenueId is null ? null : await venues.GetAsync(input.VenueId.Value);
+        if (!errors.Any && venue is null) errors.Add("venueId", "The venue does not exist.");
+        CheckCapacity(errors, input, venue, show);
+        if (errors.Any) return Error.Invalid(errors);
+
+        ApplyScalars(show, input);
+        var wanted = input.TicketTiers ?? [];
+        foreach (var existing in show.TicketTiers.ToList())
+        {
+            if (wanted.Any(t => t!.Id == existing.Id)) continue;
+            show.TicketTiers.Remove(existing);
+            shows.RemoveTier(existing);
+        }
+        foreach (var tierInput in wanted)
+        {
+            if (tierInput!.Id is { } tierId)
+            {
+                ApplyTier(show.TicketTiers.First(t => t.Id == tierId), tierInput);
+                continue;
+            }
+            var tier = new TicketTier { ShowId = show.Id };
+            ApplyTier(tier, tierInput);
+            show.TicketTiers.Add(tier);
+            shows.AddTier(tier);
+        }
+        if (await CommitAsync(Refused) is { } error) return error;
+        return show.ToDto();
+    }
+
+    public async Task<Result<Unit>> RemoveAsync(Guid id)
+    {
+        if (await shows.GetAsync(id) is not { } show) return Error.NotFound("Show not found.");
+        if (await shows.HasBookingsAsync(id)) return Error.Conflict("The show has bookings.");
+
+        shows.Remove(show);
+        if (await CommitAsync("The show has bookings.") is { } error) return error;
+        return default(Unit);
+    }
+
+    /// <summary>Tier ids must belong to the show, quotas cannot go under what is sold, and add up within the venue capacity.</summary>
+    private static void CheckCapacity(ValidationErrors errors, ShowInput input, Venue? venue, Show? current)
+    {
+        var tiers = input.TicketTiers ?? [];
+        var seen = new HashSet<Guid>();
+        for (var i = 0; i < tiers.Count; i++)
+        {
+            if (tiers[i] is not { } tier) continue;
+            if (tier.Id is not { } id) continue;
+            var existing = current?.TicketTiers.FirstOrDefault(t => t.Id == id);
+            if (existing is null || !seen.Add(id)) errors.Add($"ticketTiers[{i}].id", "The tier does not belong to the show.");
+            else if (tier.Quota < existing.Sold) errors.Add($"ticketTiers[{i}].quota", "The quota is lower than the tickets already sold.");
+        }
+        if (venue is not null && tiers.Sum(t => t?.Quota ?? 0) > venue.Capacity)
+            errors.Add("ticketTiers", $"The quotas exceed the capacity of the venue ({venue.Capacity}).");
+    }
+
+    private static void ApplyScalars(Show show, ShowInput input)
+    {
+        show.Title = input.Title!;
+        var startsAt = input.StartsAt!.Value;
+        show.StartsAt = startsAt.Kind == DateTimeKind.Local ? startsAt.ToUniversalTime() : DateTime.SpecifyKind(startsAt, DateTimeKind.Utc);
+        show.Status = input.Status is { } s ? (ShowStatus)s : ShowStatus.Draft;
+        show.VenueId = input.VenueId!.Value;
+    }
+
+    private static void ApplyTier(TicketTier tier, TicketTierInput input)
+    {
+        tier.Name = input.Name!;
+        tier.Price = input.Price!.Value;
+        tier.Quota = input.Quota!.Value;
+    }
+}
