+namespace Acme.Ticketing.Application.Framework;
+
+public enum ErrorKind { NotFound, Invalid, Conflict, Forbidden }
+
+public sealed record Error(ErrorKind Kind, string Message, IReadOnlyDictionary<string, string[]>? Errors = null)
+{
+    public static Error NotFound(string message) => new(ErrorKind.NotFound, message);
+    public static Error Conflict(string message) => new(ErrorKind.Conflict, message);
+    public static Error Forbidden(string message) => new(ErrorKind.Forbidden, message);
+    public static Error Invalid(string path, string message) =>
+        new(ErrorKind.Invalid, "Validation failed.", new Dictionary<string, string[]> { [path] = [message] });
+    public static Error Invalid(ValidationErrors errors) => new(ErrorKind.Invalid, "Validation failed.", errors.ToDictionary());
+}
+
+public readonly record struct Unit;
+
+public sealed class Result<T>
+{
+    private readonly T? _value;
+    private readonly Error? _error;
+
+    private Result(T? value, Error? error) { _value = value; _error = error; }
+
+    public bool IsSuccess => _error is null;
+    public T Value => _error is null ? _value! : throw new InvalidOperationException("The result is an error.");
+    public Error Error => _error ?? throw new InvalidOperationException("The result is a success.");
+
+    public static implicit operator Result<T>(T value) => new(value, null);
+    public static implicit operator Result<T>(Error error) => new(default, error);
+
+    public Result<U> Map<U>(Func<T, U> map) => IsSuccess ? map(Value) : Error;
+}
+
+public sealed class ValidationErrors
+{
+    private readonly Dictionary<string, List<string>> _errors = [];
+
+    public bool Any => _errors.Count > 0;
+
+    public void Add(string path, string message)
+    {
+        if (!_errors.TryGetValue(path, out var list)) _errors[path] = list = [];
+        list.Add(message);
+    }
+
+    /// <summary>Checks a required string with a maximum length.</summary>
+    public void Text(string path, string? value, int maxLength)
+    {
+        if (string.IsNullOrWhiteSpace(value)) Add(path, "The value is required.");
+        else if (value.Length > maxLength) Add(path, $"The value must be at most {maxLength} characters.");
+    }
+
+    public Dictionary<string, string[]> ToDictionary() => _errors.ToDictionary(e => e.Key, e => e.Value.ToArray());
+}
