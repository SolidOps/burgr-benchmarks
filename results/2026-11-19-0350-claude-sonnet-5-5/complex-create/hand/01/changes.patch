@@ -0,0 +1,43 @@
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+public sealed record PageRequest(int Page = 1, int PageSize = 50, string? OrderBy = null, bool Descending = false);
+
+public sealed record PagedResult<T>(IReadOnlyList<T> Items, int PageNumber, int PageSize, int TotalCount);
+
+public static class Paging
+{
+    /// <summary>Simple (scalar, writable) properties of an entity: the ones a query can order by.</summary>
+    public static PropertyInfo[] OrderableProperties(Type entity) => entity
+        .GetProperties(BindingFlags.Public | BindingFlags.Instance)
+        .Where(p => p.GetMethod is { IsPublic: true } && p.SetMethod is not null && IsScalar(p.PropertyType))
+        .ToArray();
+
+    private static bool IsScalar(Type t)
+    {
+        t = Nullable.GetUnderlyingType(t) ?? t;
+        return t.IsPrimitive || t.IsEnum || t == typeof(string) || t == typeof(Guid) || t == typeof(decimal) || t == typeof(DateTime);
+    }
+
+    public static async Task<Result<PagedResult<TDto>>> QueryAsync<TEntity, TDto>(
+        IRepository<TEntity> repository, PageRequest request, Func<TEntity, TDto> map) where TEntity : Entity
+    {
+        var errors = new ValidationErrors();
+        if (request.Page < 1) errors.Add("page", "The page must be at least 1.");
+        if (request.PageSize is < 1 or > 200) errors.Add("pageSize", "The page size must be between 1 and 200.");
+
+        string? orderBy = null;
+        if (!string.IsNullOrWhiteSpace(request.OrderBy))
+        {
+            orderBy = OrderableProperties(typeof(TEntity))
+                .FirstOrDefault(p => string.Equals(p.Name, request.OrderBy, StringComparison.OrdinalIgnoreCase))?.Name;
+            if (orderBy is null) errors.Add("orderBy", $"'{request.OrderBy}' is not a property that can be ordered by.");
+        }
+        if (errors.Any) return Error.Invalid(errors);
+
+        var page = await repository.QueryAsync(new PageQuery(request.Page, request.PageSize, orderBy, request.Descending));
+        return new PagedResult<TDto>(page.Items.Select(map).ToList(), request.Page, request.PageSize, page.TotalCount);
+    }
+}
