+using System.Linq.Expressions;
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public abstract class Repository<T>(TicketingDbContext db) : IRepository<T> where T : Entity
+{
+    protected TicketingDbContext Db => db;
+    protected DbSet<T> Set => db.Set<T>();
+
+    /// <summary>The related data always loaded with the entity.</summary>
+    protected virtual IQueryable<T> WithIncludes(IQueryable<T> query) => query;
+
+    public Task<T?> GetAsync(Guid id, CancellationToken ct = default) =>
+        WithIncludes(Set).FirstOrDefaultAsync(e => e.Id == id, ct);
+
+    public async Task<(IReadOnlyList<T> Items, int TotalCount)> QueryAsync(
+        int page, int pageSize, string? orderBy, bool descending, CancellationToken ct = default)
+    {
+        var total = await Set.CountAsync(ct);
+        var ordered = orderBy is null
+            ? Set.OrderBy(e => e.Id)
+            : OrderBy(Set, orderBy, descending).ThenBy(e => e.Id);
+        var items = await WithIncludes(ordered)
+            .Skip((page - 1) * pageSize).Take(pageSize)
+            .AsNoTracking()
+            .ToListAsync(ct);
+        return (items, total);
+    }
+
+    public void Add(T entity) => Set.Add(entity);
+
+    public void Remove(T entity) => Set.Remove(entity);
+
+    private static IOrderedQueryable<T> OrderBy(IQueryable<T> query, string property, bool descending)
+    {
+        var parameter = Expression.Parameter(typeof(T), "e");
+        var member = Expression.Property(parameter, property);
+        var lambda = Expression.Lambda(member, parameter);
+        var method = typeof(Queryable).GetMethods(BindingFlags.Public | BindingFlags.Static)
+            .First(m => m.Name == (descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy))
+                        && m.GetParameters().Length == 2)
+            .MakeGenericMethod(typeof(T), member.Type);
+        return (IOrderedQueryable<T>)method.Invoke(null, [query, lambda])!;
+    }
+}
