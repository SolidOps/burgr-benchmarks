diff --git a/src/Ticketing.Application/Shows/ShowService.cs b/src/Ticketing.Application/Shows/ShowService.cs
new file mode 100644
index 0000000..35c95cc
--- /dev/null
+++ b/src/Ticketing.Application/Shows/ShowService.cs
@@ -0,0 +1,117 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Shows;
+using Acme.Ticketing.Domain.Venues;
+
+namespace Acme.Ticketing.Application.Shows;
+
+public sealed class ShowService(
+    IShowRepository shows, IVenueRepository venues, IBookingRepository bookings, IUnitOfWork unitOfWork)
+{
+    public Task<Result<Page<ShowDto>>> QueryAsync(PageQuery query, CancellationToken ct = default) =>
+        Paging.QueryAsync(shows, query, ShowDto.From, ct);
+
+    public async Task<Result<ShowDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        return show is null ? Error.NotFound("Show not found.") : ShowDto.From(show);
+    }
+
+    public Task<Result<ShowDto>> AddAsync(ShowInput input, CancellationToken ct = default) =>
+        SaveAsync(null, input, ct);
+
+    public async Task<Result<ShowDto>> UpdateAsync(Guid id, ShowInput input, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        return show is null ? Error.NotFound("Show not found.") : await SaveAsync(show, input, ct);
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null)
+            return Error.NotFound("Show not found.");
+        if (await bookings.AnyForShowAsync(id, ct))
+            return Error.Conflict("The show has bookings.");
+
+        shows.Remove(show);
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    private async Task<Result<ShowDto>> SaveAsync(Show? current, ShowInput input, CancellationToken ct)
+    {
+        var errors = new ValidationErrors();
+        input.Validate(errors);
+
+        Venue? venue = null;
+        if (input.VenueId is { } venueId && venueId != Guid.Empty)
+        {
+            venue = await venues.GetAsync(venueId, ct);
+            if (venue is null)
+                errors.Add("venueId", "Unknown venue.");
+        }
+
+        var tiers = input.TicketTiers ?? [];
+        var existing = current?.TicketTiers.ToDictionary(t => t.Id) ?? [];
+        var seenIds = new HashSet<Guid>();
+        var seenNames = new HashSet<string>();
+        for (var i = 0; i < tiers.Count; i++)
+        {
+            var tier = tiers[i];
+            if (tier is null)
+                continue;
+            if (tier.Id is { } tierId)
+            {
+                if (!existing.TryGetValue(tierId, out var found) || !seenIds.Add(tierId))
+                    errors.Add($"ticketTiers[{i}].id", "Unknown tier.");
+                else if (tier.Quota < found.Sold)
+                    errors.Add($"ticketTiers[{i}].quota", "The quota is lower than the tickets already sold.");
+            }
+            if (!string.IsNullOrWhiteSpace(tier.Name) && !seenNames.Add(tier.Name))
+                errors.Add($"ticketTiers[{i}].name", "The tier name is already used in the show.");
+        }
+        if (venue is not null && tiers.Where(t => t is not null).Sum(t => (long)Math.Max(t.Quota, 0)) > venue.Capacity)
+            errors.Add("ticketTiers", "The quotas exceed the capacity of the venue.");
+
+        if (errors.Any)
+            return errors.ToError();
+
+        var show = current ?? new Show();
+        show.Title = input.Title!;
+        show.StartsAt = Utc(input.StartsAt!.Value);
+        show.Status = (ShowStatus)(input.Status ?? 0);
+        show.VenueId = input.VenueId!.Value;
+
+        foreach (var removed in show.TicketTiers.Where(t => !seenIds.Contains(t.Id)).ToList())
+            show.TicketTiers.Remove(removed);
+        foreach (var tier in tiers)
+        {
+            if (tier.Id is { } tierId)
+            {
+                var entity = existing[tierId];
+                entity.Name = tier.Name!;
+                entity.Price = tier.Price;
+                entity.Quota = tier.Quota;
+            }
+            else
+            {
+                var added = new TicketTier { ShowId = show.Id, Name = tier.Name!, Price = tier.Price, Quota = tier.Quota };
+                shows.AddTier(added);
+                if (!show.TicketTiers.Contains(added))
+                    show.TicketTiers.Add(added);
+            }
+        }
+        if (current is null)
+            shows.Add(show);
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? ShowDto.From(show) : commit.Error!;
+    }
+
+    public static DateTime Utc(DateTime value) => value.Kind switch
+    {
+        DateTimeKind.Utc => value,
+        DateTimeKind.Local => value.ToUniversalTime(),
+        _ => DateTime.SpecifyKind(value, DateTimeKind.Utc),
+    };
+}
