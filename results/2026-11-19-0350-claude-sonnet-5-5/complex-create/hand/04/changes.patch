+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Application.Shows;
+using Acme.Ticketing.Domain.Venues;
+
+namespace Acme.Ticketing.Application.Venues;
+
+public sealed record AddressDto(string Street, string City, string PostalCode);
+
+public sealed record VenueDto(Guid Id, string Name, AddressDto Address, int Capacity)
+{
+    [System.Text.Json.Serialization.JsonIgnore(Condition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull)]
+    public IReadOnlyList<ShowDto>? Shows { get; init; }
+
+    public static VenueDto From(Venue v, bool withShows = false) =>
+        new(v.Id, v.Name, new AddressDto(v.Address.Street, v.Address.City, v.Address.PostalCode), v.Capacity)
+        {
+            Shows = withShows ? v.Shows.Select(ShowDto.From).ToList() : null,
+        };
+}
+
+public sealed class AddressInput
+{
+    public string? Street { get; set; }
+    public string? City { get; set; }
+    public string? PostalCode { get; set; }
+}
+
+public sealed class VenueInput
+{
+    public string? Name { get; set; }
+    public AddressInput? Address { get; set; }
+    public int Capacity { get; set; }
+
+    public void Validate(ValidationErrors errors)
+    {
+        errors.Required("name", Name, 100);
+        if (Address is null)
+            errors.Add("address", "The address is required.");
+        else
+        {
+            errors.Required("address.street", Address.Street, 100);
+            errors.Required("address.city", Address.City, 50);
+            errors.Required("address.postalCode", Address.PostalCode, 10);
+        }
+        if (Capacity < 0)
+            errors.Add("capacity", "The capacity cannot be negative.");
+    }
+}
