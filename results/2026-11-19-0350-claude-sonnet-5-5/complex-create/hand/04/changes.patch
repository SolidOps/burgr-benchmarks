--- /dev/null
+++ b/src/Ticketing.Api/Endpoints.cs
@@ -0,0 +1,65 @@
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Application.Bookings;
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Application.Shows;
+using Acme.Ticketing.Application.Venues;
+
+namespace Acme.Ticketing.Api;
+
+public static class Endpoints
+{
+    public static void MapTicketingEndpoints(this IEndpointRouteBuilder app)
+    {
+        var venues = app.MapGroup("/venues").RequireAuthorization();
+        venues.MapGet("/", (VenueService s, CancellationToken ct, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            s.QueryAsync(new(page, pageSize, orderBy, descending), ct).ToHttp());
+        venues.MapGet("/{id:guid}", (Guid id, VenueService s, CancellationToken ct) => s.GetAsync(id, ct).ToHttp());
+        venues.MapPost("/", (VenueInput input, VenueService s, CancellationToken ct) =>
+            s.AddAsync(input, ct).ToHttp(v => Results.Created($"/venues/{v.Id}", v))).RequireAuthorization(Rights.ManageVenues);
+        venues.MapPut("/{id:guid}", (Guid id, VenueInput input, VenueService s, CancellationToken ct) =>
+            s.UpdateAsync(id, input, ct).ToHttp()).RequireAuthorization(Rights.ManageVenues);
+        venues.MapDelete("/{id:guid}", (Guid id, VenueService s, CancellationToken ct) =>
+            s.RemoveAsync(id, ct).ToHttp()).RequireAuthorization(Rights.ManageVenues);
+
+        var shows = app.MapGroup("/shows").RequireAuthorization();
+        shows.MapGet("/", (ShowService s, CancellationToken ct, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            s.QueryAsync(new(page, pageSize, orderBy, descending), ct).ToHttp());
+        shows.MapGet("/{id:guid}", (Guid id, ShowService s, CancellationToken ct) => s.GetAsync(id, ct).ToHttp());
+        shows.MapPost("/", (ShowInput input, ShowService s, CancellationToken ct) =>
+            s.AddAsync(input, ct).ToHttp(v => Results.Created($"/shows/{v.Id}", v))).RequireAuthorization(Rights.ManageShows);
+        shows.MapPut("/{id:guid}", (Guid id, ShowInput input, ShowService s, CancellationToken ct) =>
+            s.UpdateAsync(id, input, ct).ToHttp()).RequireAuthorization(Rights.ManageShows);
+        shows.MapDelete("/{id:guid}", (Guid id, ShowService s, CancellationToken ct) =>
+            s.RemoveAsync(id, ct).ToHttp()).RequireAuthorization(Rights.ManageShows);
+
+        var bookings = app.MapGroup("/bookings").RequireAuthorization(Rights.ManageShows);
+        bookings.MapGet("/", (BookingService s, CancellationToken ct, int page = 1, int pageSize = 50, string? orderBy = null, bool descending = false) =>
+            s.QueryAsync(new(page, pageSize, orderBy, descending), ct).ToHttp());
+        bookings.MapGet("/{id:guid}", (Guid id, BookingService s, CancellationToken ct) => s.GetAsync(id, ct).ToHttp());
+
+        app.MapPost("/box-office/book", (BookingInput input, BoxOfficeService s, CancellationToken ct) =>
+            s.BookAsync(input, ct).ToHttp()).RequireAuthorization();
+    }
+
+    private static async Task<IResult> ToHttp<T>(this Task<Result<T>> task, Func<T, IResult>? success = null)
+    {
+        var result = await task;
+        return result.IsSuccess ? (success ?? (v => Results.Ok(v)))(result.Value) : Problem(result.Error!);
+    }
+
+    private static async Task<IResult> ToHttp(this Task<Result> task)
+    {
+        var result = await task;
+        return result.IsSuccess ? Results.NoContent() : Problem(result.Error!);
+    }
+
+    private static IResult Problem(Error error) => error.Kind switch
+    {
+        ErrorKind.NotFound => Results.Problem(error.Message, statusCode: StatusCodes.Status404NotFound),
+        ErrorKind.Conflict => Results.Problem(error.Message, statusCode: StatusCodes.Status409Conflict),
+        ErrorKind.Forbidden => Results.Problem(error.Message, statusCode: StatusCodes.Status403Forbidden),
+        _ => Results.ValidationProblem(
+            error.Errors?.ToDictionary(e => e.Key, e => e.Value) ?? new Dictionary<string, string[]>(),
+            detail: error.Message),
+    };
+}
