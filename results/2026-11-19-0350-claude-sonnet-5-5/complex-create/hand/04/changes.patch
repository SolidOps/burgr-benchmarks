diff --git a/src/Ticketing.Infrastructure/TicketingDbContext.cs b/src/Ticketing.Infrastructure/TicketingDbContext.cs
new file mode 100644
index 0000000..2e27371
--- /dev/null
+++ b/src/Ticketing.Infrastructure/TicketingDbContext.cs
@@ -0,0 +1,50 @@
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Shows;
+using Acme.Ticketing.Domain.Venues;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Storage.ValueConversion;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public class TicketingDbContext(DbContextOptions<TicketingDbContext> options) : DbContext(options)
+{
+    protected override void OnModelCreating(ModelBuilder model)
+    {
+        // Ids are generated by the domain: a new entity found through a navigation must be Added.
+        foreach (var entity in model.Model.GetEntityTypes())
+            model.Entity(entity.ClrType).Property(nameof(Domain.Framework.Entity.Id)).ValueGeneratedNever();
+
+        // SQLite cannot order by decimal: money is stored as a real.
+        var money = new ValueConverter<decimal, double>(d => (double)d, d => (decimal)d);
+        var utc = new ValueConverter<DateTime, DateTime>(
+            d => d.ToUniversalTime(), d => DateTime.SpecifyKind(d, DateTimeKind.Utc));
+
+        model.Entity<Venue>(b =>
+        {
+            b.Property(v => v.Name).HasMaxLength(100).IsRequired();
+            b.HasIndex(v => v.Name).IsUnique();
+            b.OwnsOne(v => v.Address, a => a.ToJson());
+            b.HasMany(v => v.Shows).WithOne().HasForeignKey(s => s.VenueId).OnDelete(DeleteBehavior.Restrict);
+        });
+
+        model.Entity<Show>(b =>
+        {
+            b.Property(s => s.Title).HasMaxLength(200).IsRequired();
+            b.Property(s => s.StartsAt).HasConversion(utc);
+            b.HasMany(s => s.TicketTiers).WithOne().HasForeignKey(t => t.ShowId).OnDelete(DeleteBehavior.Cascade);
+        });
+
+        model.Entity<TicketTier>(b =>
+        {
+            b.Property(t => t.Name).HasMaxLength(50).IsRequired();
+            b.Property(t => t.Price).HasConversion(money);
+            b.Property(t => t.Sold).IsConcurrencyToken();
+        });
+
+        model.Entity<Booking>(b =>
+        {
+            b.Property(x => x.TotalPrice).HasConversion(money);
+            b.HasOne<Show>().WithMany().HasForeignKey(x => x.ShowId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
