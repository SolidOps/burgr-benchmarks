@@ -0,0 +1,136 @@
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class ShowTests : TestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var venueId = await CreateVenue();
+        var (created, body) = await Post("/shows", ShowBody(venueId, status: 0));
+        AssertStatus(201, created);
+        var id = body.GetProperty("id").GetGuid();
+        Assert.AreEqual(0, body.GetProperty("status").GetInt32());
+        var tier = body.GetProperty("ticketTiers")[0];
+        Assert.AreEqual(0, tier.GetProperty("sold").GetInt32());
+        Assert.AreEqual(20.5m, tier.GetProperty("price").GetDecimal());
+
+        var (_, got) = await Get($"/shows/{id}");
+        Assert.IsFalse(got.GetProperty("isSoldOut").GetBoolean());
+        Assert.AreEqual(venueId, got.GetProperty("venueId").GetGuid());
+
+        var (updated, upd) = await Put($"/shows/{id}", ShowBody(venueId, 1, title: "Macbeth", tiers: [new { id = tier.GetProperty("id").GetGuid(), name = "Std", price = 5m, quota = 20 }]));
+        AssertStatus(200, updated);
+        Assert.AreEqual("Macbeth", upd.GetProperty("title").GetString());
+        Assert.AreEqual("Std", upd.GetProperty("ticketTiers")[0].GetProperty("name").GetString());
+
+        AssertStatus(204, (await Delete($"/shows/{id}")).Response);
+        AssertStatus(404, (await Get($"/shows/{id}")).Response);
+    }
+
+    [TestMethod]
+    public async Task TiersAreAddedUpdatedRemovedAndSoldIsIgnored()
+    {
+        var venueId = await CreateVenue();
+        var show = await CreateShow(venueId, tiers: [new { name = "A", price = 1m, quota = 10 }, new { name = "B", price = 2m, quota = 10 }]);
+        var showId = show.GetProperty("id").GetGuid();
+        var a = show.GetProperty("ticketTiers").EnumerateArray().First(t => t.GetProperty("name").GetString() == "A").GetProperty("id").GetGuid();
+
+        AssertStatus(200, (await Book(showId, "A", 3)).Response);
+        var (response, upd) = await Put($"/shows/{showId}", ShowBody(venueId, tiers: [new { id = a, name = "A", price = 9m, quota = 10, sold = 0 }, new { name = "C", price = 3m, quota = 5 }]));
+        Assert.AreEqual(200, (int)response.StatusCode, upd.ToString());
+        var tiers = upd.GetProperty("ticketTiers").EnumerateArray().ToList();
+        Assert.AreEqual(2, tiers.Count);
+        var ta = tiers.First(t => t.GetProperty("name").GetString() == "A");
+        Assert.AreEqual(a, ta.GetProperty("id").GetGuid());
+        Assert.AreEqual(3, ta.GetProperty("sold").GetInt32());
+        Assert.AreEqual(9m, ta.GetProperty("price").GetDecimal());
+        Assert.IsTrue(tiers.Any(t => t.GetProperty("name").GetString() == "C"));
+
+        var (_, got) = await Get($"/shows/{showId}");
+        Assert.AreEqual(2, got.GetProperty("ticketTiers").GetArrayLength());
+    }
+
+    [TestMethod]
+    public async Task TiersExceedingCapacityIs400()
+    {
+        var venueId = await CreateVenue(capacity: 10);
+        var (response, body) = await Post("/shows", ShowBody(venueId, tiers: [new { name = "A", price = 1m, quota = 6 }, new { name = "B", price = 1m, quota = 5 }]));
+        AssertStatus(400, response);
+        Assert.IsTrue(body.TryGetProperty("errors", out _));
+        AssertStatus(201, (await Post("/shows", ShowBody(venueId, tiers: [new { name = "A", price = 1m, quota = 6 }, new { name = "B", price = 1m, quota = 4 }]))).Response);
+    }
+
+    [TestMethod]
+    public async Task InvalidBodies()
+    {
+        var venueId = await CreateVenue();
+        AssertStatus(400, (await Post("/shows", ShowBody(Guid.NewGuid()))).Response);
+        AssertStatus(400, (await Post("/shows", ShowBody(venueId, status: 7))).Response);
+        AssertStatus(400, (await Post("/shows", ShowBody(venueId, title: ""))).Response);
+        AssertStatus(400, (await Post("/shows", ShowBody(venueId, title: new string('x', 201)))).Response);
+        AssertStatus(400, (await Post("/shows", ShowBody(venueId, tiers: [new { name = new string('x', 51), price = 1m, quota = 1 }]))).Response);
+        AssertStatus(400, (await Post("/shows", ShowBody(venueId, tiers: [new { id = Guid.NewGuid(), name = "A", price = 1m, quota = 1 }]))).Response);
+        var (response, body) = await Post("/shows", new { title = "x", startsAt = DateTime.UtcNow, status = 1, ticketTiers = Array.Empty<object>() });
+        AssertStatus(400, response);
+        Assert.IsTrue(body.GetProperty("errors").TryGetProperty("venueId", out _));
+    }
+
+    [TestMethod]
+    public async Task IsSoldOut()
+    {
+        var venueId = await CreateVenue();
+        var empty = await CreateShow(venueId, tiers: []);
+        Assert.IsFalse((await Get($"/shows/{empty.GetProperty("id").GetGuid()}")).Body.GetProperty("isSoldOut").GetBoolean());
+
+        var show = await CreateShow(venueId, tiers: [new { name = "Standard", price = 1m, quota = 3 }]);
+        var id = show.GetProperty("id").GetGuid();
+        AssertStatus(200, (await Book(id, quantity: 3)).Response);
+        Assert.IsTrue((await Get($"/shows/{id}")).Body.GetProperty("isSoldOut").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task ShowWithBookingsCannotBeDeleted()
+    {
+        var venueId = await CreateVenue();
+        var id = (await CreateShow(venueId)).GetProperty("id").GetGuid();
+        AssertStatus(200, (await Book(id)).Response);
+        AssertStatus(409, (await Delete($"/shows/{id}")).Response);
+    }
+
+    [TestMethod]
+    public async Task QuotaCannotDropBelowSold()
+    {
+        var venueId = await CreateVenue();
+        var show = await CreateShow(venueId);
+        var id = show.GetProperty("id").GetGuid();
+        var tierId = show.GetProperty("ticketTiers")[0].GetProperty("id").GetGuid();
+        await Book(id, quantity: 5);
+        AssertStatus(400, (await Put($"/shows/{id}", ShowBody(venueId, tiers: [new { id = tierId, name = "Standard", price = 1m, quota = 4 }]))).Response);
+    }
+
+    [TestMethod]
+    public async Task PagingOrdersByTitle()
+    {
+        var venueId = await CreateVenue();
+        foreach (var t in new[] { "B", "A" })
+            await Post("/shows", ShowBody(venueId, title: t));
+        var (_, page) = await Get("/shows?orderBy=Title");
+        Assert.AreEqual("A", page.GetProperty("items")[0].GetProperty("title").GetString());
+        Assert.AreEqual(1, page.GetProperty("items")[0].GetProperty("ticketTiers").GetArrayLength());
+        AssertStatus(400, (await Get("/shows?orderBy=TicketTiers")).Response);
+    }
+
+    [TestMethod]
+    public async Task WritingRequiresManageShows()
+    {
+        var venueId = await CreateVenue();
+        Authenticate("ManageVenues");
+        AssertStatus(403, (await Post("/shows", ShowBody(venueId))).Response);
+        AssertStatus(200, (await Get("/shows")).Response);
+        Authenticate("ManageShows");
+        AssertStatus(201, (await Post("/shows", ShowBody(venueId))).Response);
+    }
+}
