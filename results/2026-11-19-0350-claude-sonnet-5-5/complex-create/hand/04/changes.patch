+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Shows;
+
+namespace Acme.Ticketing.Application.Bookings;
+
+public sealed class BoxOfficeService(
+    IShowRepository shows, IBookingRepository bookings, IUnitOfWork unitOfWork, TimeProvider time)
+{
+    public async Task<Result<BookingDto>> BookAsync(BookingInput input, CancellationToken ct = default)
+    {
+        var errors = new ValidationErrors();
+        if (input.Quantity is < 1 or > 10)
+            errors.Add("quantity", "The quantity must be between 1 and 10.");
+        if (input.CustomerEmail is null || !input.CustomerEmail.Contains('@'))
+            errors.Add("customerEmail", "The email is invalid.");
+        if (errors.Any)
+            return errors.ToError();
+
+        var show = await shows.GetAsync(input.ShowId, ct);
+        if (show is null)
+            return Error.NotFound("Show not found.");
+        if (show.Status != ShowStatus.OnSale)
+            return Error.Conflict("The show is not on sale.");
+        if (show.StartsAt < time.GetUtcNow().UtcDateTime)
+            return Error.Conflict("The show has already started.");
+
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == input.Tier);
+        if (tier is null)
+            return Error.Invalid("tier", "The show has no tier with this name.");
+        if (tier.Remaining < input.Quantity)
+            return Error.Conflict("Not enough tickets left.");
+
+        tier.Sold += input.Quantity;
+        var booking = new Booking
+        {
+            ShowId = show.Id,
+            Tier = tier.Name,
+            CustomerEmail = input.CustomerEmail!,
+            Quantity = input.Quantity,
+            TotalPrice = tier.Price * input.Quantity,
+        };
+        bookings.Add(booking);
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? BookingDto.From(booking) : commit.Error!;
+    }
+}
