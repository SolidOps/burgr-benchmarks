+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class VenueTests : TestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var (created, body) = await Post("/venues", VenueBody("Opera", 120));
+        AssertStatus(201, created);
+        var id = body.GetProperty("id").GetGuid();
+        Assert.AreEqual("Paris", body.GetProperty("address").GetProperty("city").GetString());
+
+        var (got, venue) = await Get($"/venues/{id}");
+        AssertStatus(200, got);
+        Assert.AreEqual(0, venue.GetProperty("shows").GetArrayLength());
+        Assert.AreEqual(120, venue.GetProperty("capacity").GetInt32());
+
+        var (updated, upd) = await Put($"/venues/{id}", VenueBody("Opera 2", 150));
+        AssertStatus(200, updated);
+        Assert.AreEqual("Opera 2", upd.GetProperty("name").GetString());
+
+        AssertStatus(204, (await Delete($"/venues/{id}")).Response);
+        AssertStatus(404, (await Get($"/venues/{id}")).Response);
+    }
+
+    [TestMethod]
+    public async Task GetByIdIncludesShows_ListDoesNot()
+    {
+        var venueId = await CreateVenue();
+        await CreateShow(venueId);
+        var (_, venue) = await Get($"/venues/{venueId}");
+        Assert.AreEqual(1, venue.GetProperty("shows").GetArrayLength());
+        var (_, list) = await Get("/venues");
+        Assert.IsFalse(list.GetProperty("items")[0].TryGetProperty("shows", out _));
+    }
+
+    [TestMethod]
+    public async Task InvalidBodyIsValidationProblem()
+    {
+        var (response, body) = await Post("/venues", new { name = new string('x', 101), address = new { street = "", city = "c", postalCode = "12345678901" }, capacity = 1 });
+        AssertStatus(400, response);
+        var errors = body.GetProperty("errors");
+        Assert.IsTrue(errors.TryGetProperty("name", out _));
+        Assert.IsTrue(errors.TryGetProperty("address.street", out _));
+        Assert.IsTrue(errors.TryGetProperty("address.postalCode", out _));
+    }
+
+    [TestMethod]
+    public async Task DuplicateNameIsConflict()
+    {
+        await CreateVenue("Opera");
+        AssertStatus(409, (await Post("/venues", VenueBody("Opera"))).Response);
+        var other = await CreateVenue("Other");
+        AssertStatus(409, (await Put($"/venues/{other}", VenueBody("Opera"))).Response);
+        AssertStatus(200, (await Put($"/venues/{other}", VenueBody("Other", 5))).Response);
+    }
+
+    [TestMethod]
+    public async Task VenueWithShowsCannotBeDeleted()
+    {
+        var venueId = await CreateVenue();
+        var show = await CreateShow(venueId);
+        AssertStatus(409, (await Delete($"/venues/{venueId}")).Response);
+        AssertStatus(204, (await Delete($"/shows/{show.GetProperty("id").GetGuid()}")).Response);
+        AssertStatus(204, (await Delete($"/venues/{venueId}")).Response);
+    }
+
+    [TestMethod]
+    public async Task CapacityCannotDropBelowQuotas()
+    {
+        var venueId = await CreateVenue(capacity: 100);
+        await CreateShow(venueId, tiers: [new { name = "A", price = 1m, quota = 60 }]);
+        AssertStatus(400, (await Put($"/venues/{venueId}", VenueBody("Opera", 50))).Response);
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIs404()
+    {
+        var id = Guid.NewGuid();
+        AssertStatus(404, (await Get($"/venues/{id}")).Response);
+        AssertStatus(404, (await Put($"/venues/{id}", VenueBody())).Response);
+        AssertStatus(404, (await Delete($"/venues/{id}")).Response);
+    }
+
+    [TestMethod]
+    public async Task PagingAndOrdering()
+    {
+        foreach (var (n, c) in new[] { ("B", 2), ("A", 3), ("C", 1) })
+            await CreateVenue(n, c);
+
+        var (_, page) = await Get("/venues?orderBy=Name&pageSize=2");
+        Assert.AreEqual(3, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(1, page.GetProperty("pageNumber").GetInt32());
+        Assert.AreEqual(2, page.GetProperty("pageSize").GetInt32());
+        Assert.AreEqual("A", page.GetProperty("items")[0].GetProperty("name").GetString());
+
+        var (_, desc) = await Get("/venues?orderBy=Capacity&descending=true&page=2&pageSize=2");
+        Assert.AreEqual(1, desc.GetProperty("items").GetArrayLength());
+        Assert.AreEqual("C", desc.GetProperty("items")[0].GetProperty("name").GetString());
+
+        foreach (var bad in new[] { "page=0", "pageSize=0", "pageSize=201", "orderBy=Nope", "orderBy=Address", "page=x", "descending=maybe" })
+            AssertStatus(400, (await Get("/venues?" + bad)).Response);
+    }
+
+    [TestMethod]
+    public async Task WritingRequiresManageVenues()
+    {
+        Authenticate("ManageShows");
+        AssertStatus(403, (await Post("/venues", VenueBody())).Response);
+        AssertStatus(200, (await Get("/venues")).Response);
+        Authenticate("ManageVenues");
+        AssertStatus(201, (await Post("/venues", VenueBody())).Response);
+    }
+}
