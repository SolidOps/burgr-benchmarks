+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+public sealed record Page<T>(IReadOnlyList<T> Items, int PageNumber, int PageSize, int TotalCount);
+
+public sealed record PageQuery(int Page = 1, int PageSize = 50, string? OrderBy = null, bool Descending = false);
+
+public static class Paging
+{
+    public static async Task<Result<Page<TDto>>> QueryAsync<T, TDto>(
+        IRepository<T> repository, PageQuery query, Func<T, TDto> map, CancellationToken ct)
+        where T : Entity
+    {
+        var errors = new ValidationErrors();
+        if (query.Page < 1)
+            errors.Add("page", "The page must be at least 1.");
+        if (query.PageSize is < 1 or > 200)
+            errors.Add("pageSize", "The page size must be between 1 and 200.");
+
+        string? orderBy = null;
+        if (!string.IsNullOrWhiteSpace(query.OrderBy))
+        {
+            orderBy = SimpleProperties<T>().FirstOrDefault(
+                n => string.Equals(n, query.OrderBy, StringComparison.OrdinalIgnoreCase));
+            if (orderBy is null)
+                errors.Add("orderBy", $"Unknown property '{query.OrderBy}'.");
+        }
+
+        if (errors.Any)
+            return errors.ToError();
+
+        var (items, total) = await repository.QueryAsync(query.Page, query.PageSize, orderBy, query.Descending, ct);
+        return new Page<TDto>(items.Select(map).ToList(), query.Page, query.PageSize, total);
+    }
+
+    /// <summary>The settable properties of a simple type, the ones a list can be ordered by.</summary>
+    private static IEnumerable<string> SimpleProperties<T>() =>
+        typeof(T).GetProperties(BindingFlags.Public | BindingFlags.Instance)
+            .Where(p => p.CanWrite && IsSimple(p.PropertyType))
+            .Select(p => p.Name);
+
+    private static bool IsSimple(Type type)
+    {
+        type = Nullable.GetUnderlyingType(type) ?? type;
+        return type.IsPrimitive || type.IsEnum
+            || type == typeof(string) || type == typeof(decimal) || type == typeof(Guid)
+            || type == typeof(DateTime) || type == typeof(DateTimeOffset);
+    }
+}
