+
+[TestClass]
+public class BoxOfficeTests : TestBase
+{
+    private async Task<Guid> OnSaleShow(int quota = 10, int status = 1, DateTime? startsAt = null)
+    {
+        var venueId = await CreateVenue(Guid.NewGuid().ToString("N"));
+        var show = await CreateShow(venueId, status, startsAt, [new { name = "Standard", price = 12.5m, quota }]);
+        return show.GetProperty("id").GetGuid();
+    }
+
+    [TestMethod]
+    public async Task BookingRoundTrip()
+    {
+        var showId = await OnSaleShow();
+        var (response, booking) = await Book(showId, quantity: 3, email: "me@x.org");
+        AssertStatus(200, response);
+        Assert.AreEqual(37.5m, booking.GetProperty("totalPrice").GetDecimal());
+        Assert.AreEqual("Standard", booking.GetProperty("tier").GetString());
+        var id = booking.GetProperty("id").GetGuid();
+
+        var (_, show) = await Get($"/shows/{showId}");
+        Assert.AreEqual(3, show.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+
+        var (got, one) = await Get($"/bookings/{id}");
+        AssertStatus(200, got);
+        Assert.AreEqual("me@x.org", one.GetProperty("customerEmail").GetString());
+        var (_, list) = await Get("/bookings?orderBy=TotalPrice");
+        Assert.AreEqual(1, list.GetProperty("totalCount").GetInt32());
+        AssertStatus(404, (await Get($"/bookings/{Guid.NewGuid()}")).Response);
+        AssertStatus(405, (await Delete($"/bookings/{id}")).Response);
+    }
+
+    [TestMethod]
+    public async Task ValidationComesFirst()
+    {
+        AssertStatus(400, (await Book(Guid.NewGuid(), quantity: 0)).Response);
+        AssertStatus(400, (await Book(Guid.NewGuid(), quantity: 11)).Response);
+        AssertStatus(400, (await Book(Guid.NewGuid(), email: "nope")).Response);
+    }
+
+    [TestMethod]
+    public async Task UnknownShowIs404() => AssertStatus(404, (await Book(Guid.NewGuid())).Response);
+
+    [TestMethod]
+    public async Task ShowNotOnSaleIs409()
+    {
+        AssertStatus(409, (await Book(await OnSaleShow(status: 0))).Response);
+        AssertStatus(409, (await Book(await OnSaleShow(status: 2))).Response);
+    }
+
+    [TestMethod]
+    public async Task PastShowIs409() =>
+        AssertStatus(409, (await Book(await OnSaleShow(startsAt: DateTime.UtcNow.AddDays(-1)))).Response);
+
+    [TestMethod]
+    public async Task UnknownTierIs400() =>
+        AssertStatus(400, (await Book(await OnSaleShow(), tier: "VIP")).Response);
+
+    [TestMethod]
+    public async Task NotEnoughTicketsIs409AndChangesNothing()
+    {
+        var showId = await OnSaleShow(quota: 5);
+        AssertStatus(200, (await Book(showId, quantity: 4)).Response);
+        AssertStatus(409, (await Book(showId, quantity: 2)).Response);
+        AssertStatus(200, (await Book(showId, quantity: 1)).Response);
+        var (_, show) = await Get($"/shows/{showId}");
+        Assert.AreEqual(5, show.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+        Assert.AreEqual(2, (await Get("/bookings")).Body.GetProperty("totalCount").GetInt32());
+    }
+
+    [TestMethod]
+    public async Task BookingNeedsAuthenticationOnly()
+    {
+        var showId = await OnSaleShow();
+        Authenticate();
+        AssertStatus(200, (await Book(showId)).Response);
+    }
+
+    [TestMethod]
+    public async Task ReadingBookingsRequiresManageShows()
+    {
+        Authenticate("ManageVenues");
+        AssertStatus(403, (await Get("/bookings")).Response);
+        Authenticate("ManageShows");
+        AssertStatus(200, (await Get("/bookings")).Response);
+    }
+}
diff --git a/src/Ticketing.Tests/Framework/TestBase.cs b/src/Ticketing.Tests/Framework/TestBase.cs
new file mode 100644
index 0000000..b61232a
--- /dev/null
+++ b/src/Ticketing.Tests/Framework/TestBase.cs
@@ -0,0 +1,132 @@
+using System.IdentityModel.Tokens.Jwt;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Data.Sqlite;
+using Microsoft.AspNetCore.Hosting;
+using Microsoft.IdentityModel.JsonWebTokens;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests.Framework;
+
+public sealed class TicketingFactory : WebApplicationFactory<Program>
+{
+    public const string Key = "test-key";
+    public string DatabasePath { get; } = Path.Combine(Path.GetTempPath(), $"ticketing-{Guid.NewGuid():N}.db");
+
+    protected override void ConfigureWebHost(IWebHostBuilder builder)
+    {
+        builder.UseSetting("Jwt:Key", Key);
+        builder.UseSetting("ConnectionStrings:Ticketing", $"Data Source={DatabasePath}");
+    }
+
+    protected override void Dispose(bool disposing)
+    {
+        base.Dispose(disposing);
+        SqliteConnection.ClearAllPools();
+        foreach (var file in Directory.GetFiles(Path.GetTempPath(), Path.GetFileName(DatabasePath) + "*"))
+            File.Delete(file);
+    }
+}
+
+/// <summary>A throw-away application and database per test.</summary>
+public abstract class TestBase
+{
+    protected static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    private TicketingFactory _factory = null!;
+    protected HttpClient Client { get; private set; } = null!;
+
+    [TestInitialize]
+    public void Start()
+    {
+        _factory = new TicketingFactory();
+        Client = _factory.CreateClient();
+        Authenticate("*");
+    }
+
+    [TestCleanup]
+    public void Stop()
+    {
+        Client.Dispose();
+        _factory.Dispose();
+    }
+
+    protected static string Token(string[] rights, string key = TicketingFactory.Key, DateTime? expires = null)
+    {
+        var bytes = Encoding.UTF8.GetBytes(key);
+        var padded = Enumerable.Repeat((byte)' ', Math.Max(32, bytes.Length)).ToArray();
+        bytes.CopyTo(padded, 0);
+        return new JsonWebTokenHandler().CreateToken(new SecurityTokenDescriptor
+        {
+            Subject = new ClaimsIdentity(rights.Select(r => new Claim("right", r)).Append(new Claim("sub", "tester"))),
+            Expires = expires ?? DateTime.UtcNow.AddHours(1),
+            NotBefore = (expires ?? DateTime.UtcNow.AddHours(1)).AddHours(-2),
+            SigningCredentials = new SigningCredentials(new SymmetricSecurityKey(padded), SecurityAlgorithms.HmacSha256),
+        });
+    }
+
+    protected void Authenticate(params string[] rights) =>
+        Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token(rights));
+
+    protected void Anonymous() => Client.DefaultRequestHeaders.Authorization = null;
+
+    protected async Task<(HttpResponseMessage Response, JsonElement Body)> Send(HttpMethod method, string url, object? body = null)
+    {
+        var request = new HttpRequestMessage(method, url);
+        if (body is not null)
+            request.Content = JsonContent.Create(body, options: Json);
+        var response = await Client.SendAsync(request);
+        var text = await response.Content.ReadAsStringAsync();
+        var json = string.IsNullOrEmpty(text) || response.Content.Headers.ContentType?.MediaType?.Contains("json") != true
+            ? default
+            : JsonDocument.Parse(text).RootElement.Clone();
+        return (response, json);
+    }
+
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Get(string url) => Send(HttpMethod.Get, url);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Post(string url, object body) => Send(HttpMethod.Post, url, body);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Put(string url, object body) => Send(HttpMethod.Put, url, body);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Delete(string url) => Send(HttpMethod.Delete, url);
+
+    protected static void AssertStatus(int expected, HttpResponseMessage response) =>
+        Assert.AreEqual(expected, (int)response.StatusCode);
+
+    // ---- builders
+
+    protected static object VenueBody(string name = "Opera", int capacity = 100) => new
+    {
+        name,
+        address = new { street = "1 Main St", city = "Paris", postalCode = "75001" },
+        capacity,
+    };
+
+    protected async Task<Guid> CreateVenue(string name = "Opera", int capacity = 100)
+    {
+        var (response, body) = await Post("/venues", VenueBody(name, capacity));
+        AssertStatus(201, response);
+        return body.GetProperty("id").GetGuid();
+    }
+
+    protected static object ShowBody(Guid venueId, int status = 1, DateTime? startsAt = null, object[]? tiers = null, string title = "Hamlet") => new
+    {
+        title,
+        startsAt = startsAt ?? DateTime.UtcNow.AddDays(10),
+        status,
+        venueId,
+        ticketTiers = tiers ?? [new { name = "Standard", price = 20.5m, quota = 10 }],
+    };
+
+    protected async Task<JsonElement> CreateShow(Guid venueId, int status = 1, DateTime? startsAt = null, object[]? tiers = null)
+    {
+        var (response, body) = await Post("/shows", ShowBody(venueId, status, startsAt, tiers));
+        AssertStatus(201, response);
+        return body;
+    }
+
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Book(Guid showId, string tier = "Standard", int quantity = 2, string email = "a@b.c") =>
+        Post("/box-office/book", new { showId, tier, customerEmail = email, quantity });
+}
