+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Shows;
+
+namespace Acme.Ticketing.Application.Shows;
+
+public sealed record TicketTierDto(Guid Id, string Name, decimal Price, int Quota, int Sold)
+{
+    public static TicketTierDto From(TicketTier t) => new(t.Id, t.Name, t.Price, t.Quota, t.Sold);
+}
+
+public sealed record ShowDto(
+    Guid Id, string Title, DateTime StartsAt, ShowStatus Status, Guid VenueId,
+    IReadOnlyList<TicketTierDto> TicketTiers, bool IsSoldOut)
+{
+    public static ShowDto From(Show s) =>
+        new(s.Id, s.Title, s.StartsAt, s.Status, s.VenueId,
+            s.TicketTiers.Select(TicketTierDto.From).ToList(), s.IsSoldOut);
+}
+
+public sealed class TicketTierInput
+{
+    public Guid? Id { get; set; }
+    public string? Name { get; set; }
+    public decimal Price { get; set; }
+    public int Quota { get; set; }
+}
+
+public sealed class ShowInput
+{
+    public string? Title { get; set; }
+    public DateTime? StartsAt { get; set; }
+    public int? Status { get; set; }
+    public Guid? VenueId { get; set; }
+    public List<TicketTierInput>? TicketTiers { get; set; }
+
+    public void Validate(ValidationErrors errors)
+    {
+        errors.Required("title", Title, 200);
+        if (StartsAt is null)
+            errors.Add("startsAt", "The start date is required.");
+        if (Status is { } status && !Enum.IsDefined((ShowStatus)status))
+            errors.Add("status", "Unknown status.");
+        if (VenueId is null || VenueId == Guid.Empty)
+            errors.Add("venueId", "The venue is required.");
+
+        var tiers = TicketTiers ?? [];
+        for (var i = 0; i < tiers.Count; i++)
+        {
+            var tier = tiers[i];
+            if (tier is null)
+            {
+                errors.Add($"ticketTiers[{i}]", "The tier is required.");
+                continue;
+            }
+            errors.Required($"ticketTiers[{i}].name", tier.Name, 50);
+            if (tier.Price < 0)
+                errors.Add($"ticketTiers[{i}].price", "The price cannot be negative.");
+            if (tier.Quota < 0)
+                errors.Add($"ticketTiers[{i}].quota", "The quota cannot be negative.");
+        }
+    }
+}
