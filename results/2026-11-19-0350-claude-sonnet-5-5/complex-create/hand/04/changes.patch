@@ -0,0 +1,46 @@
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class SecurityTests : TestBase
+{
+    [TestMethod]
+    public async Task NoTokenIs401()
+    {
+        Anonymous();
+        foreach (var url in new[] { "/venues", "/shows", "/bookings", $"/venues/{Guid.NewGuid()}" })
+            AssertStatus(401, (await Get(url)).Response);
+        AssertStatus(401, (await Book(Guid.NewGuid())).Response);
+        AssertStatus(401, (await Post("/venues", VenueBody())).Response);
+    }
+
+    [TestMethod]
+    public async Task BadSignatureOrExpiredTokenIs401()
+    {
+        Client.DefaultRequestHeaders.Authorization = new("Bearer", Token(["*"], key: "other-key"));
+        AssertStatus(401, (await Get("/venues")).Response);
+        Client.DefaultRequestHeaders.Authorization = new("Bearer", Token(["*"], expires: DateTime.UtcNow.AddMinutes(-1)));
+        AssertStatus(401, (await Get("/venues")).Response);
+        Client.DefaultRequestHeaders.Authorization = new("Bearer", "garbage");
+        AssertStatus(401, (await Get("/venues")).Response);
+    }
+
+    [TestMethod]
+    public async Task WildcardGrantsEveryRight()
+    {
+        Authenticate("*");
+        AssertStatus(201, (await Post("/venues", VenueBody())).Response);
+        AssertStatus(200, (await Get("/bookings")).Response);
+    }
+
+    [TestMethod]
+    public async Task NoRightsStillReads()
+    {
+        Authenticate();
+        AssertStatus(200, (await Get("/venues")).Response);
+        AssertStatus(200, (await Get("/shows")).Response);
+        AssertStatus(403, (await Delete($"/shows/{Guid.NewGuid()}")).Response);
+        AssertStatus(403, (await Put($"/venues/{Guid.NewGuid()}", VenueBody())).Response);
+    }
+}
