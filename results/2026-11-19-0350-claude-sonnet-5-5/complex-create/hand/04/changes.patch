@@ -0,0 +1,74 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Venues;
+
+namespace Acme.Ticketing.Application.Venues;
+
+public sealed class VenueService(IVenueRepository venues, IUnitOfWork unitOfWork)
+{
+    public Task<Result<Page<VenueDto>>> QueryAsync(PageQuery query, CancellationToken ct = default) =>
+        Paging.QueryAsync(venues, query, v => VenueDto.From(v), ct);
+
+    public async Task<Result<VenueDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        return venue is null ? Error.NotFound("Venue not found.") : VenueDto.From(venue, withShows: true);
+    }
+
+    public async Task<Result<VenueDto>> AddAsync(VenueInput input, CancellationToken ct = default)
+    {
+        var errors = new ValidationErrors();
+        input.Validate(errors);
+        if (errors.Any)
+            return errors.ToError();
+        if (await venues.NameExistsAsync(input.Name!, null, ct))
+            return Error.Conflict("A venue with this name already exists.");
+
+        var venue = new Venue();
+        Apply(venue, input);
+        venues.Add(venue);
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? VenueDto.From(venue) : commit.Error!;
+    }
+
+    public async Task<Result<VenueDto>> UpdateAsync(Guid id, VenueInput input, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        if (venue is null)
+            return Error.NotFound("Venue not found.");
+
+        var errors = new ValidationErrors();
+        input.Validate(errors);
+        if (!errors.Any
+            && venue.Shows.Any(s => s.TicketTiers.Sum(t => (long)t.Quota) > input.Capacity))
+            errors.Add("capacity", "The capacity is lower than the quotas of a show of the venue.");
+        if (errors.Any)
+            return errors.ToError();
+        if (await venues.NameExistsAsync(input.Name!, id, ct))
+            return Error.Conflict("A venue with this name already exists.");
+
+        Apply(venue, input);
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? VenueDto.From(venue) : commit.Error!;
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        if (venue is null)
+            return Error.NotFound("Venue not found.");
+        if (venue.Shows.Count > 0)
+            return Error.Conflict("The venue still has shows.");
+
+        venues.Remove(venue);
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    private static void Apply(Venue venue, VenueInput input)
+    {
+        venue.Name = input.Name!;
+        venue.Address = new Address(input.Address!.Street!, input.Address.City!, input.Address.PostalCode!);
+        venue.Capacity = input.Capacity;
+    }
+}
