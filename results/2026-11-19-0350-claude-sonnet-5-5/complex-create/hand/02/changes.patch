diff --git a/src/Ticketing.Infrastructure/TicketingDbContext.cs b/src/Ticketing.Infrastructure/TicketingDbContext.cs
new file mode 100644
index 0000000..3beaae1
--- /dev/null
+++ b/src/Ticketing.Infrastructure/TicketingDbContext.cs
@@ -0,0 +1,46 @@
+using Acme.Ticketing.Domain;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public sealed class TicketingDbContext(DbContextOptions<TicketingDbContext> options) : DbContext(options)
+{
+    protected override void OnModelCreating(ModelBuilder b)
+    {
+        b.Entity<Venue>(e =>
+        {
+            e.Property(v => v.Id).ValueGeneratedNever();
+            e.Property(v => v.Name).IsRequired().HasMaxLength(100);
+            e.HasIndex(v => v.Name).IsUnique();
+            e.OwnsOne(v => v.Address, a => a.ToJson()); // value object stored as JSON in the venue's row
+            e.Navigation(v => v.Address).IsRequired();
+        });
+
+        b.Entity<Show>(e =>
+        {
+            e.Property(s => s.Id).ValueGeneratedNever();
+            e.Property(s => s.Title).IsRequired().HasMaxLength(200);
+            e.Property(s => s.StartsAt).HasConversion(d => d.ToUniversalTime(), d => DateTime.SpecifyKind(d, DateTimeKind.Utc));
+            e.HasOne(s => s.Venue).WithMany(v => v.Shows).HasForeignKey(s => s.VenueId).OnDelete(DeleteBehavior.Restrict);
+            e.HasMany(s => s.TicketTiers).WithOne().HasForeignKey(t => t.ShowId).OnDelete(DeleteBehavior.Cascade);
+            e.Ignore(s => s.IsSoldOut);
+            e.Ignore(s => s.TotalQuota);
+        });
+
+        b.Entity<TicketTier>(e =>
+        {
+            e.Property(t => t.Id).ValueGeneratedNever();
+            e.Property(t => t.Name).IsRequired().HasMaxLength(50);
+            e.Property(t => t.Sold).IsConcurrencyToken(); // two concurrent bookings cannot oversell
+            e.Ignore(t => t.Remaining);
+        });
+
+        b.Entity<Booking>(e =>
+        {
+            e.Property(x => x.Id).ValueGeneratedNever();
+            e.Property(x => x.Tier).IsRequired();
+            e.Property(x => x.CustomerEmail).IsRequired();
+            e.HasOne<Show>().WithMany().HasForeignKey(x => x.ShowId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
