+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Domain;
+
+public enum ShowStatus { Draft = 0, OnSale = 1, Cancelled = 2 }
+
+public sealed record Address(string Street, string City, string PostalCode);
+
+public class Venue : Entity
+{
+    public string Name { get; set; } = "";
+    public Address Address { get; set; } = new("", "", "");
+    public int Capacity { get; set; }
+    public List<Show> Shows { get; } = [];
+}
+
+public class Show : Entity
+{
+    public string Title { get; set; } = "";
+    public DateTime StartsAt { get; set; }
+    public ShowStatus Status { get; set; }
+    public Guid VenueId { get; set; }
+    public Venue? Venue { get; set; }
+    public List<TicketTier> TicketTiers { get; } = [];
+
+    public int TotalQuota => TicketTiers.Sum(t => t.Quota);
+    public bool IsSoldOut => TicketTiers.Count > 0 && TicketTiers.All(t => t.Sold >= t.Quota);
+}
+
+public class TicketTier : Entity
+{
+    public Guid ShowId { get; set; }
+    public string Name { get; set; } = "";
+    public decimal Price { get; set; }
+    public int Quota { get; set; }
+    /// <summary>Only bookings change it.</summary>
+    public int Sold { get; private set; }
+
+    public int Remaining => Quota - Sold;
+
+    public void Reserve(int quantity) => Sold += quantity;
+}
+
+public class Booking : Entity
+{
+    public Guid ShowId { get; set; }
+    public string Tier { get; set; } = "";
+    public string CustomerEmail { get; set; } = "";
+    public int Quantity { get; set; }
+    public decimal TotalPrice { get; set; }
+}
