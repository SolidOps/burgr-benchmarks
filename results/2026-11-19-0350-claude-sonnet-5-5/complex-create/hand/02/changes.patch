--- /dev/null
+++ b/src/Ticketing.Application/Inputs.cs
@@ -0,0 +1,67 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public sealed record AddressInput(string? Street, string? City, string? PostalCode);
+
+public sealed record VenueInput(string? Name, AddressInput? Address, int? Capacity)
+{
+    public Validation Validate()
+    {
+        var v = new Validation();
+        v.Required("name", Name, 100);
+        if (Address is null) v.Add("address", "The address is required.");
+        else
+        {
+            v.Required("address.street", Address.Street, 100);
+            v.Required("address.city", Address.City, 50);
+            v.Required("address.postalCode", Address.PostalCode, 10);
+        }
+        if (Capacity is null) v.Add("capacity", "The capacity is required.");
+        else if (Capacity < 0) v.Add("capacity", "The capacity cannot be negative.");
+        return v;
+    }
+}
+
+/// <summary>A tier without <c>Id</c> is added, with an <c>Id</c> is updated. <c>sold</c> in a body is ignored.</summary>
+public sealed record TicketTierInput(Guid? Id, string? Name, decimal? Price, int? Quota);
+
+public sealed record ShowInput(string? Title, DateTime? StartsAt, ShowStatus? Status, Guid? VenueId, List<TicketTierInput>? TicketTiers)
+{
+    public IReadOnlyList<TicketTierInput> Tiers => TicketTiers ?? [];
+
+    public Validation Validate()
+    {
+        var v = new Validation();
+        v.Required("title", Title, 200);
+        if (StartsAt is null) v.Add("startsAt", "The start is required.");
+        if (Status is { } s && !Enum.IsDefined(s)) v.Add("status", "The status is unknown.");
+        if (VenueId is null || VenueId == Guid.Empty) v.Add("venueId", "The venue is required.");
+
+        var seenIds = new HashSet<Guid>();
+        var seenNames = new HashSet<string>();
+        for (var i = 0; i < Tiers.Count; i++)
+        {
+            var t = Tiers[i];
+            if (t is null) { v.Add($"ticketTiers[{i}]", "The tier is required."); continue; }
+            v.Required($"ticketTiers[{i}].name", t.Name, 50);
+            if (t.Name is not null && !seenNames.Add(t.Name)) v.Add($"ticketTiers[{i}].name", "The tier name is used twice.");
+            if (t.Price is null) v.Add($"ticketTiers[{i}].price", "The price is required.");
+            else if (t.Price < 0) v.Add($"ticketTiers[{i}].price", "The price cannot be negative.");
+            if (t.Quota is null) v.Add($"ticketTiers[{i}].quota", "The quota is required.");
+            else if (t.Quota < 0) v.Add($"ticketTiers[{i}].quota", "The quota cannot be negative.");
+            if (t.Id is { } id && !seenIds.Add(id)) v.Add($"ticketTiers[{i}].id", "The tier id is used twice.");
+        }
+        return v;
+    }
+
+    public static DateTime ToUtc(DateTime d) => d.Kind switch
+    {
+        DateTimeKind.Utc => d,
+        DateTimeKind.Local => d.ToUniversalTime(),
+        _ => DateTime.SpecifyKind(d, DateTimeKind.Utc),
+    };
+}
+
+public sealed record BookingInput(Guid ShowId, string? Tier, string? CustomerEmail, int Quantity);
