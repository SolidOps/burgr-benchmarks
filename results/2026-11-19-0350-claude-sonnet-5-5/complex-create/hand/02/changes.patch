+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+/// <summary>The paging parameters of a query.</summary>
+public sealed record QueryInput(int Page = 1, int PageSize = 50, string? OrderBy = null, bool Descending = false)
+{
+    public const int MaxPageSize = 200;
+
+    public Result<PageRequest> ToRequest<T>()
+    {
+        var v = new Validation();
+        if (Page < 1) v.Add("page", "The page must be at least 1.");
+        if (PageSize is < 1 or > MaxPageSize) v.Add("pageSize", $"The page size must be between 1 and {MaxPageSize}.");
+
+        string? orderBy = null;
+        if (!string.IsNullOrEmpty(OrderBy))
+        {
+            orderBy = SortableProperties.Of<T>().FirstOrDefault(p => string.Equals(p.Name, OrderBy, StringComparison.OrdinalIgnoreCase))?.Name;
+            if (orderBy is null) v.Add("orderBy", $"'{OrderBy}' is not a property that can be ordered by.");
+        }
+
+        return v.IsValid ? new PageRequest(Page, PageSize, orderBy, Descending) : v.ToError();
+    }
+}
