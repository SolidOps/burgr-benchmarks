+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+/// <summary>Reads the bookings; they are only created by the box office.</summary>
+public sealed class BookingService(IBookingRepository bookings)
+{
+    public async Task<Result<Page<BookingDto>>> QueryAsync(QueryInput input, CancellationToken ct = default)
+    {
+        var request = input.ToRequest<Booking>();
+        if (!request.IsSuccess) return request.Error!;
+        return (await bookings.QueryAsync(request.Value, ct)).Map(b => b.ToDto());
+    }
+
+    public async Task<Result<BookingDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var booking = await bookings.GetAsync(id, ct);
+        return booking is null ? Error.NotFound("Booking not found.") : booking.ToDto();
+    }
+}
