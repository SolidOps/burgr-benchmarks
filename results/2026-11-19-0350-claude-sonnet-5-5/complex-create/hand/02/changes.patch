+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Infrastructure.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public sealed class VenueRepository(TicketingDbContext db) : Repository<Venue>(db), IVenueRepository
+{
+    public Task<Venue?> GetWithShowsAsync(Guid id, CancellationToken ct = default) =>
+        Set.Include(v => v.Shows).ThenInclude(s => s.TicketTiers).FirstOrDefaultAsync(v => v.Id == id, ct);
+
+    public Task<bool> NameTakenAsync(string name, Guid? exceptId, CancellationToken ct = default) =>
+        Set.AnyAsync(v => v.Name == name && v.Id != exceptId, ct);
+}
+
+public sealed class ShowRepository(TicketingDbContext db) : Repository<Show>(db), IShowRepository
+{
+    protected override IQueryable<Show> WithIncludes(IQueryable<Show> query) => query.Include(s => s.TicketTiers);
+
+    public Task<bool> AnyForVenueAsync(Guid venueId, CancellationToken ct = default) =>
+        Set.AnyAsync(s => s.VenueId == venueId, ct);
+
+    public async Task<int> MaxTotalQuotaForVenueAsync(Guid venueId, CancellationToken ct = default)
+    {
+        var totals = await Set.AsNoTracking().Where(s => s.VenueId == venueId)
+            .Select(s => s.TicketTiers.Sum(t => t.Quota)).ToListAsync(ct);
+        return totals.Count == 0 ? 0 : totals.Max();
+    }
+}
+
+public sealed class BookingRepository(TicketingDbContext db) : Repository<Booking>(db), IBookingRepository
+{
+    public Task<bool> AnyForShowAsync(Guid showId, CancellationToken ct = default) =>
+        Set.AnyAsync(b => b.ShowId == showId, ct);
+}
