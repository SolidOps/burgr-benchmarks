@@ -0,0 +1,21 @@
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Api.Endpoints;
+
+/// <summary>Maps the outcome of a use case to an HTTP response.</summary>
+public static class ResultExtensions
+{
+    public static IResult ToHttp<T>(this Result<T> result, Func<T, IResult>? ok = null) =>
+        result.IsSuccess ? (ok ?? (v => Results.Ok(v)))(result.Value) : Map(result.Error!);
+
+    public static IResult ToHttp(this Result result, Func<IResult>? ok = null) =>
+        result.IsSuccess ? (ok ?? Results.NoContent)() : Map(result.Error!);
+
+    private static IResult Map(Error error) => error.Kind switch
+    {
+        ErrorKind.NotFound => Results.Problem(error.Message, statusCode: StatusCodes.Status404NotFound),
+        ErrorKind.Invalid => Results.ValidationProblem(error.Errors!.ToDictionary(e => e.Key, e => e.Value)),
+        ErrorKind.Conflict => Results.Problem(error.Message, statusCode: StatusCodes.Status409Conflict),
+        _ => Results.Problem(error.Message, statusCode: StatusCodes.Status403Forbidden),
+    };
+}
diff --git a/src/Ticketing.Api/Program.cs b/src/Ticketing.Api/Program.cs
new file mode 100644
index 0000000..92aa291
--- /dev/null
+++ b/src/Ticketing.Api/Program.cs
@@ -0,0 +1,54 @@
+using System.Text;
+using Acme.Ticketing.Api.Endpoints;
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Infrastructure;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.AspNetCore.Authorization;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.IdentityModel.Tokens;
+
+var builder = WebApplication.CreateBuilder(args);
+
+builder.Services.AddSingleton(TimeProvider.System);
+builder.Services.AddTicketingApplication();
+// The configuration is read lazily, so that overrides made by a test host apply.
+builder.Services.AddTicketingInfrastructure((sp, options) =>
+    options.UseSqlite(sp.GetRequiredService<IConfiguration>().GetConnectionString("Ticketing")));
+
+// Authentication: HMAC SHA-256 JWT; signature and lifetime only (no issuer, no audience).
+builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme).AddJwtBearer();
+builder.Services.AddOptions<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme)
+    .Configure<IConfiguration>((options, configuration) =>
+    {
+        var key = Encoding.UTF8.GetBytes(configuration["Jwt:Key"] ?? throw new InvalidOperationException("Jwt:Key is not configured."));
+        if (key.Length < 32) key = [.. key, .. Enumerable.Repeat((byte)' ', 32 - key.Length)];
+        options.MapInboundClaims = false;
+        options.TokenValidationParameters = new TokenValidationParameters
+        {
+            IssuerSigningKey = new SymmetricSecurityKey(key),
+            ValidAlgorithms = [SecurityAlgorithms.HmacSha256],
+            ValidateIssuerSigningKey = true,
+            ValidateIssuer = false,
+            ValidateAudience = false,
+            ValidateLifetime = true,
+            ClockSkew = TimeSpan.Zero,
+        };
+    });
+
+// Authorization: every endpoint needs an authenticated caller; a right is a `right` claim, `*` grants every right.
+var authorization = builder.Services.AddAuthorizationBuilder()
+    .SetFallbackPolicy(new AuthorizationPolicyBuilder().RequireAuthenticatedUser().Build());
+foreach (var right in Rights.Defined)
+    authorization.AddPolicy(right, policy => policy.RequireAuthenticatedUser().RequireAssertion(context =>
+        context.User.HasClaim(c => c.Type == Rights.Claim && (c.Value == right || c.Value == Rights.All))));
+
+var app = builder.Build();
+await app.Services.InitializeTicketingDatabaseAsync();
+
+app.UseAuthentication();
+app.UseAuthorization();
+app.MapTicketingEndpoints();
+
+app.Run();
+
+public partial class Program;
