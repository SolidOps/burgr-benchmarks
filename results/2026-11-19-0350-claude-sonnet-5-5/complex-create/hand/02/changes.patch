@@ -0,0 +1,121 @@
+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class VenueTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var created = await Client.PostAsJsonAsync("/venues", VenueBody("Opera", 120));
+        await AssertStatus(HttpStatusCode.Created, created);
+        var body = await Json(created);
+        var id = body.GetProperty("id").GetGuid();
+        Assert.AreEqual("Paris", body.GetProperty("address").GetProperty("city").GetString());
+
+        var get = await Json(await Client.GetAsync($"/venues/{id}"));
+        Assert.AreEqual("Opera", get.GetProperty("name").GetString());
+        Assert.AreEqual(120, get.GetProperty("capacity").GetInt32());
+        Assert.AreEqual(0, get.GetProperty("shows").GetArrayLength());
+
+        var put = await Client.PutAsJsonAsync($"/venues/{id}", VenueBody("Opera 2", 130));
+        await AssertStatus(HttpStatusCode.OK, put);
+        Assert.AreEqual("Opera 2", (await Json(put)).GetProperty("name").GetString());
+
+        var page = await Json(await Client.GetAsync("/venues"));
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(1, page.GetProperty("pageNumber").GetInt32());
+        Assert.AreEqual(50, page.GetProperty("pageSize").GetInt32());
+        Assert.AreEqual(130, page.GetProperty("items")[0].GetProperty("capacity").GetInt32());
+
+        await AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/venues/{id}"));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/venues/{id}"));
+    }
+
+    [TestMethod]
+    public async Task DetailIncludesShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue);
+        var shows = (await Json(await Client.GetAsync($"/venues/{venue}"))).GetProperty("shows");
+        Assert.AreEqual(1, shows.GetArrayLength());
+        Assert.AreEqual(show, shows[0].GetProperty("id").GetGuid());
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIsNotFound()
+    {
+        await AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/venues/{Guid.NewGuid()}"));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.PutAsJsonAsync($"/venues/{Guid.NewGuid()}", VenueBody()));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.DeleteAsync($"/venues/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task InvalidBodyIsValidationProblem()
+    {
+        var response = await Client.PostAsJsonAsync("/venues", new
+        {
+            name = new string('x', 101),
+            address = new { street = new string('x', 101), city = new string('x', 51), postalCode = "" },
+            capacity = 10,
+        });
+        await AssertStatus(HttpStatusCode.BadRequest, response);
+        var errors = (await Json(response)).GetProperty("errors");
+        foreach (var path in new[] { "name", "address.street", "address.city", "address.postalCode" })
+            Assert.IsTrue(errors.TryGetProperty(path, out _), path);
+
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.PostAsJsonAsync("/venues", new { name = "x", capacity = 1 }));
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.PostAsJsonAsync("/venues", new { name = "", address = new { street = "a", city = "b", postalCode = "c" }, capacity = 1 }));
+    }
+
+    [TestMethod]
+    public async Task NameMustBeUnique()
+    {
+        var id = await CreateVenue("A");
+        await CreateVenue("B");
+        await AssertStatus(HttpStatusCode.Conflict, await Client.PostAsJsonAsync("/venues", VenueBody("A")));
+        await AssertStatus(HttpStatusCode.Conflict, await Client.PutAsJsonAsync($"/venues/{id}", VenueBody("B")));
+        await AssertStatus(HttpStatusCode.OK, await Client.PutAsJsonAsync($"/venues/{id}", VenueBody("A", 5)));
+    }
