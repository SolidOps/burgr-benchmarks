+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class BoxOfficeTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task BookingUpdatesSoldAndIsReadable()
+    {
+        var show = await CreateShow(await CreateVenue(), [Tier("Standard", 12.5m, 10)]);
+        var response = await Book(show, "Standard", 3, "fan@example.com");
+        await AssertStatus(HttpStatusCode.OK, response);
+        var booking = await Json(response);
+        Assert.AreEqual(37.5m, booking.GetProperty("totalPrice").GetDecimal());
+        Assert.AreEqual("Standard", booking.GetProperty("tier").GetString());
+        Assert.AreEqual(3, booking.GetProperty("quantity").GetInt32());
+        Assert.AreEqual(show, booking.GetProperty("showId").GetGuid());
+        var id = booking.GetProperty("id").GetGuid();
+
+        var tier = (await Json(await Client.GetAsync($"/shows/{show}"))).GetProperty("ticketTiers")[0];
+        Assert.AreEqual(3, tier.GetProperty("sold").GetInt32());
+
+        var get = await Json(await Client.GetAsync($"/bookings/{id}"));
+        Assert.AreEqual("fan@example.com", get.GetProperty("customerEmail").GetString());
+        var page = await Json(await Client.GetAsync("/bookings?orderBy=TotalPrice&descending=true"));
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        await AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/bookings/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task BookingsAreReadOnly()
+    {
+        await AssertStatus(HttpStatusCode.MethodNotAllowed, await Client.PostAsJsonAsync("/bookings", new { }));
+        await AssertStatus(HttpStatusCode.MethodNotAllowed, await Client.DeleteAsync($"/bookings/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task InvalidQuantityOrEmailIsBadRequestBeforeAnythingElse()
+    {
+        // The show does not exist: the 400 comes first.
+        var unknown = Guid.NewGuid();
+        foreach (var quantity in new[] { 0, -1, 11 })
+            await AssertStatus(HttpStatusCode.BadRequest, await Book(unknown, quantity: quantity));
+        await AssertStatus(HttpStatusCode.BadRequest, await Book(unknown, email: "nobody"));
+        await AssertStatus(HttpStatusCode.NotFound, await Book(unknown));
+
+        var show = await CreateShow(await CreateVenue(), [Tier(quota: 50)]);
+        await AssertStatus(HttpStatusCode.OK, await Book(show, quantity: 1));
+        await AssertStatus(HttpStatusCode.OK, await Book(show, quantity: 10));
+    }
+
+    [TestMethod]
+    public async Task ShowMustBeOnSaleAndNotStarted()
+    {
+        var venue = await CreateVenue();
+        foreach (var status in new[] { 0, 2 })
+            await AssertStatus(HttpStatusCode.Conflict, await Book(await CreateShow(venue, status: status)));
+        var past = await CreateShow(venue, startsAt: DateTime.UtcNow.AddMinutes(-5));
+        await AssertStatus(HttpStatusCode.Conflict, await Book(past));
+    }
+
+    [TestMethod]
+    public async Task StatusIsCheckedBeforeTier()
+    {
+        var show = await CreateShow(await CreateVenue(), status: 0);
+        await AssertStatus(HttpStatusCode.Conflict, await Book(show, "Unknown"));
+    }
+
+    [TestMethod]
+    public async Task UnknownTierIsBadRequest()
+    {
+        var show = await CreateShow(await CreateVenue());
+        await AssertStatus(HttpStatusCode.BadRequest, await Book(show, "Nope"));
+    }
+
+    [TestMethod]
+    public async Task NotEnoughTicketsIsConflictAndChangesNothing()
+    {
+        var show = await CreateShow(await CreateVenue(), [Tier(quota: 5)]);
+        await AssertStatus(HttpStatusCode.OK, await Book(show, quantity: 4));
+        await AssertStatus(HttpStatusCode.Conflict, await Book(show, quantity: 2));
+        await AssertStatus(HttpStatusCode.OK, await Book(show, quantity: 1));
+        await AssertStatus(HttpStatusCode.Conflict, await Book(show, quantity: 1));
+
+        Assert.AreEqual(5, (await Json(await Client.GetAsync($"/shows/{show}"))).GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+        Assert.AreEqual(2, (await Json(await Client.GetAsync("/bookings"))).GetProperty("totalCount").GetInt32());
+    }
+}
diff --git a/src/Ticketing.Tests/Framework/ApiTestBase.cs b/src/Ticketing.Tests/Framework/ApiTestBase.cs
new file mode 100644
index 0000000..1260ec6
--- /dev/null
+++ b/src/Ticketing.Tests/Framework/ApiTestBase.cs
@@ -0,0 +1,102 @@
+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text;
+using System.Text.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.Configuration;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests.Framework;
+
+/// <summary>A real host per test, with a throw-away SQLite database and a signed test token.</summary>
+public abstract class ApiTestBase
+{
+    protected const string JwtKey = "integration-tests-signing-key";
+    private string _dbPath = "";
+    private WebApplicationFactory<Program> _factory = null!;
+
+    /// <summary>A caller with every right.</summary>
+    protected HttpClient Client { get; private set; } = null!;
+
+    [TestInitialize]
+    public void StartHost()
+    {
+        _dbPath = Path.Combine(Path.GetTempPath(), $"ticketing-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b => b.ConfigureAppConfiguration((_, c) =>
+            c.AddInMemoryCollection(new Dictionary<string, string?>
+            {
+                ["ConnectionStrings:Ticketing"] = $"Data Source={_dbPath};Pooling=False",
+                ["Jwt:Key"] = JwtKey,
+            })));
+        Client = ClientWith("*");
+    }
+
+    [TestCleanup]
+    public void StopHost()
+    {
+        Client.Dispose();
+        _factory.Dispose();
+        foreach (var f in Directory.GetFiles(Path.GetTempPath(), Path.GetFileName(_dbPath) + "*")) File.Delete(f);
+    }
+
+    protected HttpClient ClientWith(params string[] rights) => ClientWithToken(Token(rights));
+
+    protected HttpClient ClientWithToken(string? token)
+    {
+        var client = _factory.CreateClient();
+        if (token is not null) client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        return client;
+    }
+
+    protected static string Token(string[] rights, string key = JwtKey, DateTime? expires = null)
+    {
+        var bytes = Encoding.UTF8.GetBytes(key).Concat(Enumerable.Repeat((byte)' ', 32)).Take(Math.Max(32, Encoding.UTF8.GetByteCount(key))).ToArray();
+        var credentials = new SigningCredentials(new SymmetricSecurityKey(bytes), SecurityAlgorithms.HmacSha256);
+        var token = new JwtSecurityToken(
+            claims: new[] { new Claim("sub", "tester") }.Concat(rights.Select(r => new Claim("right", r))),
+            notBefore: DateTime.UtcNow.AddMinutes(-10),
+            expires: expires ?? DateTime.UtcNow.AddHours(1),
+            signingCredentials: credentials);
+        return new JwtSecurityTokenHandler().WriteToken(token);
+    }
+
+    protected static async Task<JsonElement> Json(HttpResponseMessage response) =>
+        JsonDocument.Parse(await response.Content.ReadAsStringAsync()).RootElement;
+
+    protected static async Task AssertStatus(HttpStatusCode expected, HttpResponseMessage response)
+    {
+        if (response.StatusCode != expected)
+            Assert.Fail($"Expected {(int)expected} but got {(int)response.StatusCode}: {await response.Content.ReadAsStringAsync()}");
+    }
+
+    // --- helpers building data through the endpoints ---
+
+    protected static object VenueBody(string name = "Opera", int capacity = 100) =>
+        new { name, address = new { street = "1 Main St", city = "Paris", postalCode = "75001" }, capacity };
+
+    protected async Task<Guid> CreateVenue(string name = "Opera", int capacity = 100)
+    {
+        var response = await Client.PostAsJsonAsync("/venues", VenueBody(name, capacity));
+        await AssertStatus(HttpStatusCode.Created, response);
+        return (await Json(response)).GetProperty("id").GetGuid();
+    }
+
+    protected static object ShowBody(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null, string title = "Carmen") =>
+        new { title, startsAt = startsAt ?? DateTime.UtcNow.AddDays(30), status, venueId, ticketTiers = tiers ?? [] };
+
+    protected static object Tier(string name = "Standard", decimal price = 10m, int quota = 50, Guid? id = null) =>
+        new { id, name, price, quota };
+
+    protected async Task<Guid> CreateShow(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null)
+    {
+        var response = await Client.PostAsJsonAsync("/shows", ShowBody(venueId, tiers ?? [Tier()], status, startsAt));
+        await AssertStatus(HttpStatusCode.Created, response);
+        return (await Json(response)).GetProperty("id").GetGuid();
+    }
+
+    protected Task<HttpResponseMessage> Book(Guid showId, string tier = "Standard", int quantity = 2, string email = "a@b.c", HttpClient? client = null) =>
+        (client ?? Client).PostAsJsonAsync("/box-office/book", new { showId, tier, customerEmail = email, quantity });
+}
diff --git a/src/Ticketing.Tests/SecurityTests.cs b/src/Ticketing.Tests/SecurityTests.cs
new file mode 100644
index 0000000..3740067
--- /dev/null
+++ b/src/Ticketing.Tests/SecurityTests.cs
@@ -0,0 +1,106 @@
+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class SecurityTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task NoValidTokenIs401()
+    {
+        var id = Guid.NewGuid();
+        var invalid = new Dictionary<string, HttpClient>
+        {
+            ["none"] = ClientWithToken(null),
+            ["garbage"] = ClientWithToken("garbage"),
+            ["wrong key"] = ClientWithToken(Token(["*"], key: "another-signing-key")),
+            ["expired"] = ClientWithToken(Token(["*"], expires: DateTime.UtcNow.AddSeconds(-30))),
+        };
+        foreach (var (name, client) in invalid)
+        {
+            foreach (var path in new[] { "/venues", $"/venues/{id}", "/shows", $"/shows/{id}", "/bookings", $"/bookings/{id}" })
+                Assert.AreEqual(HttpStatusCode.Unauthorized, (await client.GetAsync(path)).StatusCode, $"{name} {path}");
+            Assert.AreEqual(HttpStatusCode.Unauthorized, (await client.PostAsJsonAsync("/venues", VenueBody())).StatusCode, name);
+            Assert.AreEqual(HttpStatusCode.Unauthorized, (await Book(id, client: client)).StatusCode, name);
+        }
+    }
+
+    [TestMethod]
+    public async Task KeyIsPaddedWithSpacesToThirtyTwoBytes()
+    {
+        // A token signed with the key padded by hand is accepted (the helper pads like the host).
+        await AssertStatus(HttpStatusCode.OK, await ClientWith().GetAsync("/venues"));
+    }
+
+    [TestMethod]
+    public async Task ReadingVenuesAndShowsAndBookingOnlyNeedAnAuthenticatedCaller()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue);
+        var plain = ClientWith();
+        await AssertStatus(HttpStatusCode.OK, await plain.GetAsync("/venues"));
+        await AssertStatus(HttpStatusCode.OK, await plain.GetAsync($"/venues/{venue}"));
+        await AssertStatus(HttpStatusCode.OK, await plain.GetAsync("/shows"));
+        await AssertStatus(HttpStatusCode.OK, await plain.GetAsync($"/shows/{show}"));
+        await AssertStatus(HttpStatusCode.OK, await Book(show, client: plain));
+    }
+
+    [TestMethod]
+    public async Task WritingVenuesNeedsManageVenues()
+    {
+        var venue = await CreateVenue();
+        foreach (var rights in new[] { Array.Empty<string>(), ["ManageShows"], ["Other"] })
+        {
+            var client = ClientWith(rights);
+            await AssertStatus(HttpStatusCode.Forbidden, await client.PostAsJsonAsync("/venues", VenueBody("X")));
+            await AssertStatus(HttpStatusCode.Forbidden, await client.PutAsJsonAsync($"/venues/{venue}", VenueBody("X")));
+            await AssertStatus(HttpStatusCode.Forbidden, await client.DeleteAsync($"/venues/{venue}"));
+        }
+        var manager = ClientWith("ManageVenues");
+        await AssertStatus(HttpStatusCode.Created, await manager.PostAsJsonAsync("/venues", VenueBody("X")));
+        await AssertStatus(HttpStatusCode.OK, await manager.PutAsJsonAsync($"/venues/{venue}", VenueBody("Y")));
+        await AssertStatus(HttpStatusCode.NoContent, await manager.DeleteAsync($"/venues/{venue}"));
+    }
+
+    [TestMethod]
+    public async Task WritingShowsNeedsManageShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue);
+        foreach (var rights in new[] { Array.Empty<string>(), ["ManageVenues"] })
+        {
+            var client = ClientWith(rights);
+            await AssertStatus(HttpStatusCode.Forbidden, await client.PostAsJsonAsync("/shows", ShowBody(venue)));
+            await AssertStatus(HttpStatusCode.Forbidden, await client.PutAsJsonAsync($"/shows/{show}", ShowBody(venue)));
+            await AssertStatus(HttpStatusCode.Forbidden, await client.DeleteAsync($"/shows/{show}"));
+        }
+        var manager = ClientWith("ManageShows");
+        await AssertStatus(HttpStatusCode.Created, await manager.PostAsJsonAsync("/shows", ShowBody(venue)));
+        await AssertStatus(HttpStatusCode.OK, await manager.PutAsJsonAsync($"/shows/{show}", ShowBody(venue)));
+        await AssertStatus(HttpStatusCode.NoContent, await manager.DeleteAsync($"/shows/{show}"));
+    }
+
+    [TestMethod]
+    public async Task ReadingBookingsNeedsManageShows()
+    {
+        var show = await CreateShow(await CreateVenue());
+        var id = (await Json(await Book(show))).GetProperty("id").GetGuid();
+        foreach (var rights in new[] { Array.Empty<string>(), ["ManageVenues"] })
+        {
+            await AssertStatus(HttpStatusCode.Forbidden, await ClientWith(rights).GetAsync("/bookings"));
+            await AssertStatus(HttpStatusCode.Forbidden, await ClientWith(rights).GetAsync($"/bookings/{id}"));
+        }
+        await AssertStatus(HttpStatusCode.OK, await ClientWith("ManageShows").GetAsync("/bookings"));
+        await AssertStatus(HttpStatusCode.OK, await ClientWith("ManageShows").GetAsync($"/bookings/{id}"));
+    }
+
+    [TestMethod]
+    public async Task StarGrantsEveryRightAmongSeveral()
+    {
+        var client = ClientWith("Other", "*");
+        await AssertStatus(HttpStatusCode.Created, await client.PostAsJsonAsync("/venues", VenueBody("Z")));
+        await AssertStatus(HttpStatusCode.OK, await client.GetAsync("/bookings"));
+    }
+}
