+namespace Acme.Ticketing.Application;
+
+/// <summary>The rights, carried by the <c>right</c> claims; <c>*</c> grants every right.</summary>
+public static class Rights
+{
+    public const string Claim = "right";
+    public const string All = "*";
+    public const string ManageVenues = nameof(ManageVenues);
+    public const string ManageShows = nameof(ManageShows);
+
+    public static readonly IReadOnlyList<string> Defined = [ManageVenues, ManageShows];
+}
diff --git a/src/Ticketing.Application/ShowService.cs b/src/Ticketing.Application/ShowService.cs
new file mode 100644
index 0000000..b87ace8
--- /dev/null
+++ b/src/Ticketing.Application/ShowService.cs
@@ -0,0 +1,90 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class ShowService(IShowRepository shows, IVenueRepository venues, IBookingRepository bookings, IUnitOfWork unitOfWork)
+{
+    public async Task<Result<Page<ShowDto>>> QueryAsync(QueryInput input, CancellationToken ct = default)
+    {
+        var request = input.ToRequest<Show>();
+        if (!request.IsSuccess) return request.Error!;
+        return (await shows.QueryAsync(request.Value, ct)).Map(s => s.ToDto());
+    }
+
+    public async Task<Result<ShowDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        return show is null ? Error.NotFound("Show not found.") : show.ToDto();
+    }
+
+    public async Task<Result<ShowDto>> AddAsync(ShowInput input, CancellationToken ct = default)
+    {
+        var v = input.Validate();
+        if (!v.IsValid) return v.ToError();
+
+        var show = new Show();
+        var error = await ApplyAsync(show, input, ct);
+        if (error is not null) return error;
+        shows.Add(show);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? show.ToDto() : commit.Error!;
+    }
+
+    public async Task<Result<ShowDto>> UpdateAsync(Guid id, ShowInput input, CancellationToken ct = default)
+    {
+        var v = input.Validate();
+        if (!v.IsValid) return v.ToError();
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+
+        var error = await ApplyAsync(show, input, ct);
+        if (error is not null) return error;
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? show.ToDto() : commit.Error!;
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+        if (await bookings.AnyForShowAsync(id, ct)) return Error.Conflict("The show has bookings.");
+        shows.Remove(show); // its tiers are deleted with it
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    /// <summary>Checks the business rules, then applies the input (and the tier list) to the show.</summary>
+    private async Task<Error?> ApplyAsync(Show show, ShowInput input, CancellationToken ct)
+    {
+        var venue = await venues.GetAsync(input.VenueId!.Value, ct);
+        if (venue is null) return Error.Invalid("venueId", "The venue does not exist.");
+
+        var v = new Validation();
+        var existing = show.TicketTiers.ToDictionary(t => t.Id);
+        for (var i = 0; i < input.Tiers.Count; i++)
+            if (input.Tiers[i].Id is { } tierId && !existing.ContainsKey(tierId))
+                v.Add($"ticketTiers[{i}].id", "The tier does not belong to the show.");
+        if (input.Tiers.Sum(t => (long)t.Quota!.Value) > venue.Capacity)
+            v.Add("ticketTiers", $"The quotas exceed the capacity of the venue ({venue.Capacity}).");
+        if (!v.IsValid) return v.ToError();
+
+        show.Title = input.Title!;
+        show.StartsAt = ShowInput.ToUtc(input.StartsAt!.Value);
+        show.Status = input.Status ?? ShowStatus.Draft;
+        show.VenueId = venue.Id;
+
+        var kept = new HashSet<Guid>();
+        foreach (var t in input.Tiers)
+        {
+            TicketTier tier;
+            if (t.Id is { } tierId) { tier = existing[tierId]; kept.Add(tierId); }
+            else { tier = new TicketTier(); show.TicketTiers.Add(tier); }
+            tier.Name = t.Name!;
+            tier.Price = t.Price!.Value;
+            tier.Quota = t.Quota!.Value;
+        }
+        show.TicketTiers.RemoveAll(t => existing.ContainsKey(t.Id) && !kept.Contains(t.Id));
+        return null;
+    }
+}
