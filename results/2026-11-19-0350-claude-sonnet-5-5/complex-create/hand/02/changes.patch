+++ b/src/Ticketing.Application/VenueService.cs
@@ -0,0 +1,65 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class VenueService(IVenueRepository venues, IShowRepository shows, IUnitOfWork unitOfWork)
+{
+    public async Task<Result<Page<VenueDto>>> QueryAsync(QueryInput input, CancellationToken ct = default)
+    {
+        var request = input.ToRequest<Venue>();
+        if (!request.IsSuccess) return request.Error!;
+        return (await venues.QueryAsync(request.Value, ct)).Map(v => v.ToDto());
+    }
+
+    public async Task<Result<VenueDetailDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        return venue is null ? Error.NotFound("Venue not found.") : venue.ToDetailDto();
+    }
+
+    public async Task<Result<VenueDetailDto>> AddAsync(VenueInput input, CancellationToken ct = default)
+    {
+        var v = input.Validate();
+        if (!v.IsValid) return v.ToError();
+        if (await venues.NameTakenAsync(input.Name!, null, ct)) return Error.Conflict("A venue with this name already exists.");
+
+        var venue = new Venue();
+        Apply(venue, input);
+        venues.Add(venue);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? venue.ToDetailDto() : commit.Error!;
+    }
+
+    public async Task<Result<VenueDetailDto>> UpdateAsync(Guid id, VenueInput input, CancellationToken ct = default)
+    {
+        var v = input.Validate();
+        if (!v.IsValid) return v.ToError();
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        if (venue is null) return Error.NotFound("Venue not found.");
+        if (await venues.NameTakenAsync(input.Name!, id, ct)) return Error.Conflict("A venue with this name already exists.");
+        if (input.Capacity < await shows.MaxTotalQuotaForVenueAsync(id, ct))
+            return Error.Invalid("capacity", "The capacity is lower than the quotas of a show of the venue.");
+
+        Apply(venue, input);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? venue.ToDetailDto() : commit.Error!;
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetAsync(id, ct);
+        if (venue is null) return Error.NotFound("Venue not found.");
+        if (await shows.AnyForVenueAsync(id, ct)) return Error.Conflict("The venue still has shows.");
+        venues.Remove(venue);
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    private static void Apply(Venue venue, VenueInput input)
+    {
+        venue.Name = input.Name!;
+        venue.Address = new Address(input.Address!.Street!, input.Address.City!, input.Address.PostalCode!);
+        venue.Capacity = input.Capacity!.Value;
+    }
+}
