+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public sealed record AddressDto(string Street, string City, string PostalCode);
+public sealed record VenueDto(Guid Id, string Name, AddressDto Address, int Capacity);
+public sealed record VenueDetailDto(Guid Id, string Name, AddressDto Address, int Capacity, IReadOnlyList<ShowDto> Shows);
+public sealed record TicketTierDto(Guid Id, string Name, decimal Price, int Quota, int Sold);
+public sealed record ShowDto(Guid Id, string Title, DateTime StartsAt, ShowStatus Status, Guid VenueId,
+    IReadOnlyList<TicketTierDto> TicketTiers, bool IsSoldOut);
+public sealed record BookingDto(Guid Id, Guid ShowId, string Tier, string CustomerEmail, int Quantity, decimal TotalPrice);
+
+public static class Mapping
+{
+    public static VenueDto ToDto(this Venue v) => new(v.Id, v.Name, v.Address.ToDto(), v.Capacity);
+    public static VenueDetailDto ToDetailDto(this Venue v) =>
+        new(v.Id, v.Name, v.Address.ToDto(), v.Capacity, v.Shows.OrderBy(s => s.StartsAt).Select(s => s.ToDto()).ToList());
+    public static AddressDto ToDto(this Address a) => new(a.Street, a.City, a.PostalCode);
+    public static TicketTierDto ToDto(this TicketTier t) => new(t.Id, t.Name, t.Price, t.Quota, t.Sold);
+    public static ShowDto ToDto(this Show s) =>
+        new(s.Id, s.Title, DateTime.SpecifyKind(s.StartsAt, DateTimeKind.Utc), s.Status, s.VenueId,
+            s.TicketTiers.Select(t => t.ToDto()).ToList(), s.IsSoldOut);
+    public static BookingDto ToDto(this Booking b) => new(b.Id, b.ShowId, b.Tier, b.CustomerEmail, b.Quantity, b.TotalPrice);
+}
