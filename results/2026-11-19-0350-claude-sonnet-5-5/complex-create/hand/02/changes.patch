@@ -0,0 +1,39 @@
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Application.Framework;
+
+namespace Acme.Ticketing.Api.Endpoints;
+
+public static class Endpoints
+{
+    public static void MapTicketingEndpoints(this IEndpointRouteBuilder app)
+    {
+        var venues = app.MapGroup("/venues").RequireAuthorization();
+        venues.MapGet("/", async ([AsParameters] QueryInput q, VenueService s, CancellationToken ct) => (await s.QueryAsync(q, ct)).ToHttp());
+        venues.MapGet("/{id:guid}", async (Guid id, VenueService s, CancellationToken ct) => (await s.GetAsync(id, ct)).ToHttp());
+        venues.MapPost("/", async (VenueInput input, VenueService s, CancellationToken ct) =>
+                (await s.AddAsync(input, ct)).ToHttp(v => Results.Created($"/venues/{v.Id}", v)))
+            .RequireAuthorization(Rights.ManageVenues);
+        venues.MapPut("/{id:guid}", async (Guid id, VenueInput input, VenueService s, CancellationToken ct) => (await s.UpdateAsync(id, input, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageVenues);
+        venues.MapDelete("/{id:guid}", async (Guid id, VenueService s, CancellationToken ct) => (await s.RemoveAsync(id, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageVenues);
+
+        var shows = app.MapGroup("/shows").RequireAuthorization();
+        shows.MapGet("/", async ([AsParameters] QueryInput q, ShowService s, CancellationToken ct) => (await s.QueryAsync(q, ct)).ToHttp());
+        shows.MapGet("/{id:guid}", async (Guid id, ShowService s, CancellationToken ct) => (await s.GetAsync(id, ct)).ToHttp());
+        shows.MapPost("/", async (ShowInput input, ShowService s, CancellationToken ct) =>
+                (await s.AddAsync(input, ct)).ToHttp(v => Results.Created($"/shows/{v.Id}", v)))
+            .RequireAuthorization(Rights.ManageShows);
+        shows.MapPut("/{id:guid}", async (Guid id, ShowInput input, ShowService s, CancellationToken ct) => (await s.UpdateAsync(id, input, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageShows);
+        shows.MapDelete("/{id:guid}", async (Guid id, ShowService s, CancellationToken ct) => (await s.RemoveAsync(id, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageShows);
+
+        var bookings = app.MapGroup("/bookings").RequireAuthorization(Rights.ManageShows);
+        bookings.MapGet("/", async ([AsParameters] QueryInput q, BookingService s, CancellationToken ct) => (await s.QueryAsync(q, ct)).ToHttp());
+        bookings.MapGet("/{id:guid}", async (Guid id, BookingService s, CancellationToken ct) => (await s.GetAsync(id, ct)).ToHttp());
+
+        app.MapPost("/box-office/book", async (BookingInput input, BoxOfficeService s, CancellationToken ct) => (await s.BookAsync(input, ct)).ToHttp())
+            .RequireAuthorization();
+    }
+}
