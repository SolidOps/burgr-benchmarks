@@ -0,0 +1,42 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application;
+
+public sealed class BoxOfficeService(IShowRepository shows, IBookingRepository bookings, IUnitOfWork unitOfWork, TimeProvider time)
+{
+    public const int MaxQuantity = 10;
+
+    public async Task<Result<BookingDto>> BookAsync(BookingInput input, CancellationToken ct = default)
+    {
+        var v = new Validation();
+        if (input.Quantity is < 1 or > MaxQuantity) v.Add("quantity", $"The quantity must be between 1 and {MaxQuantity}.");
+        if (input.CustomerEmail is null || !input.CustomerEmail.Contains('@')) v.Add("customerEmail", "The email is invalid.");
+        if (!v.IsValid) return v.ToError();
+
+        var show = await shows.GetAsync(input.ShowId, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+        if (show.Status != ShowStatus.OnSale) return Error.Conflict("The show is not on sale.");
+        if (show.StartsAt < time.GetUtcNow().UtcDateTime) return Error.Conflict("The show has already started.");
+
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == input.Tier);
+        if (tier is null) return Error.Invalid("tier", "The show has no tier with this name.");
+        if (tier.Remaining < input.Quantity) return Error.Conflict("Not enough tickets left in this tier.");
+
+        tier.Reserve(input.Quantity);
+        var booking = new Booking
+        {
+            ShowId = show.Id,
+            Tier = tier.Name,
+            CustomerEmail = input.CustomerEmail!,
+            Quantity = input.Quantity,
+            TotalPrice = tier.Price * input.Quantity,
+        };
+        bookings.Add(booking);
+
+        // The tier's sold count and the booking are saved together.
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? booking.ToDto() : commit.Error!;
+    }
+}
