+using System.Reflection;
+
+namespace Acme.Ticketing.Domain.Framework;
+
+public sealed record PageRequest(int Page, int PageSize, string? OrderBy, bool Descending);
+
+public sealed record Page<T>(IReadOnlyList<T> Items, int PageNumber, int PageSize, int TotalCount)
+{
+    public Page<TOut> Map<TOut>(Func<T, TOut> map) => new(Items.Select(map).ToList(), PageNumber, PageSize, TotalCount);
+}
+
+public static class SortableProperties
+{
+    /// <summary>The simple (scalar, stored) properties of <typeparamref name="T"/> a query can be ordered by.</summary>
+    public static IReadOnlyList<PropertyInfo> Of<T>() =>
+        typeof(T).GetProperties(BindingFlags.Public | BindingFlags.Instance)
+            .Where(p => p.CanWrite && p.GetMethod is { IsPublic: true } && IsSimple(Nullable.GetUnderlyingType(p.PropertyType) ?? p.PropertyType))
+            .ToList();
+
+    private static bool IsSimple(Type t) =>
+        t.IsPrimitive || t.IsEnum || t == typeof(string) || t == typeof(decimal) || t == typeof(Guid) || t == typeof(DateTime);
+}
