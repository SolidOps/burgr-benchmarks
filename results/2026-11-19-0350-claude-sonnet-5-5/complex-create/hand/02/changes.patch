+using System.Linq.Expressions;
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public abstract class Repository<T>(TicketingDbContext db) : IRepository<T> where T : Entity
+{
+    protected TicketingDbContext Db { get; } = db;
+    protected DbSet<T> Set => Db.Set<T>();
+
+    /// <summary>The related data loaded with the aggregate.</summary>
+    protected virtual IQueryable<T> WithIncludes(IQueryable<T> query) => query;
+
+    public Task<T?> GetAsync(Guid id, CancellationToken ct = default) =>
+        WithIncludes(Set).FirstOrDefaultAsync(e => e.Id == id, ct);
+
+    public void Add(T entity) => Set.Add(entity);
+    public void Remove(T entity) => Set.Remove(entity);
+
+    public async Task<Page<T>> QueryAsync(PageRequest request, CancellationToken ct = default)
+    {
+        var query = WithIncludes(Set.AsNoTracking());
+        var total = await query.CountAsync(ct);
+        var items = await OrderBy(query, request.OrderBy, request.Descending)
+            .Skip((request.Page - 1) * request.PageSize).Take(request.PageSize).ToListAsync(ct);
+        return new Page<T>(items, request.Page, request.PageSize, total);
+    }
+
+    private static IOrderedQueryable<T> OrderBy(IQueryable<T> query, string? name, bool descending)
+    {
+        IOrderedQueryable<T> ordered;
+        if (name is null || name == nameof(Entity.Id))
+            ordered = descending ? query.OrderByDescending(e => e.Id) : query.OrderBy(e => e.Id);
+        else
+        {
+            var property = typeof(T).GetProperty(name, BindingFlags.Public | BindingFlags.Instance)
+                ?? throw new ArgumentException($"Unknown property {name}.", nameof(name));
+            var parameter = Expression.Parameter(typeof(T), "e");
+            Expression body = Expression.Property(parameter, property);
+            // SQLite cannot order decimals (stored as text) natively.
+            if (property.PropertyType == typeof(decimal)) body = Expression.Convert(body, typeof(double));
+            var method = typeof(Queryable).GetMethods()
+                .First(m => m.Name == (descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy)) && m.GetParameters().Length == 2)
+                .MakeGenericMethod(typeof(T), body.Type);
+            ordered = (IOrderedQueryable<T>)method.Invoke(null, [query, Expression.Lambda(body, parameter)])!;
+            ordered = ordered.ThenBy(e => e.Id); // stable pages
+        }
+        return ordered;
+    }
+}
