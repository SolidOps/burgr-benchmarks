+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class ShowTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var venue = await CreateVenue();
+        var starts = new DateTime(2030, 5, 1, 20, 0, 0, DateTimeKind.Utc);
+        var created = await Client.PostAsJsonAsync("/shows", ShowBody(venue, [Tier("VIP", 99.5m, 10), Tier("Standard", 20, 40)], 0, starts));
+        await AssertStatus(HttpStatusCode.Created, created);
+        var id = (await Json(created)).GetProperty("id").GetGuid();
+
+        var show = await Json(await Client.GetAsync($"/shows/{id}"));
+        Assert.AreEqual("Carmen", show.GetProperty("title").GetString());
+        Assert.AreEqual(0, show.GetProperty("status").GetInt32());
+        Assert.AreEqual(venue, show.GetProperty("venueId").GetGuid());
+        Assert.AreEqual(starts, show.GetProperty("startsAt").GetDateTime().ToUniversalTime());
+        Assert.IsTrue(show.GetProperty("startsAt").GetString()!.EndsWith('Z'));
+        Assert.IsFalse(show.GetProperty("isSoldOut").GetBoolean());
+        var tiers = show.GetProperty("ticketTiers");
+        Assert.AreEqual(2, tiers.GetArrayLength());
+        Assert.IsTrue(tiers.EnumerateArray().All(t => t.GetProperty("id").GetGuid() != Guid.Empty && t.GetProperty("sold").GetInt32() == 0));
+        Assert.IsTrue(tiers.EnumerateArray().Any(t => t.GetProperty("name").GetString() == "VIP" && t.GetProperty("price").GetDecimal() == 99.5m));
+
+        var put = await Client.PutAsJsonAsync($"/shows/{id}", ShowBody(venue, [Tier()], 2, title: "Renamed"));
+        await AssertStatus(HttpStatusCode.OK, put);
+        Assert.AreEqual(2, (await Json(put)).GetProperty("status").GetInt32());
+
+        var page = await Json(await Client.GetAsync("/shows?orderBy=Title"));
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual("Renamed", page.GetProperty("items")[0].GetProperty("title").GetString());
+
+        await AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/shows/{id}"));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/shows/{id}"));
+    }
+
+    [TestMethod]
+    public async Task PutReconcilesTiers()
+    {
+        var venue = await CreateVenue();
+        var id = await CreateShow(venue, [Tier("A", 1, 10), Tier("B", 2, 10), Tier("C", 3, 10)]);
+        var tiers = (await Json(await Client.GetAsync($"/shows/{id}"))).GetProperty("ticketTiers").EnumerateArray().ToList();
+        var a = tiers.First(t => t.GetProperty("name").GetString() == "A").GetProperty("id").GetGuid();
+        var c = tiers.First(t => t.GetProperty("name").GetString() == "C").GetProperty("id").GetGuid();
+
+        // A updated (sold in the body is ignored), B removed, C kept, D added.
+        var body = new
+        {
+            title = "Carmen", startsAt = DateTime.UtcNow.AddDays(3), status = 1, venueId = venue,
+            ticketTiers = new object[]
+            {
+                new { id = a, name = "A2", price = 5m, quota = 20, sold = 99 },
+                new { id = c, name = "C", price = 3m, quota = 10 },
+                new { name = "D", price = 4m, quota = 5 },
+            },
+        };
+        var put = await Json(await Client.PutAsJsonAsync($"/shows/{id}", body));
+        var result = put.GetProperty("ticketTiers").EnumerateArray().ToList();
+        CollectionAssert.AreEquivalent(new[] { "A2", "C", "D" }, result.Select(t => t.GetProperty("name").GetString()).ToArray());
+        Assert.IsTrue(result.All(t => t.GetProperty("sold").GetInt32() == 0));
+        Assert.AreEqual(a, result.First(t => t.GetProperty("name").GetString() == "A2").GetProperty("id").GetGuid());
+        Assert.AreEqual(c, result.First(t => t.GetProperty("name").GetString() == "C").GetProperty("id").GetGuid());
+        Assert.AreEqual(3, (await Json(await Client.GetAsync($"/shows/{id}"))).GetProperty("ticketTiers").GetArrayLength());
+
+        // An id that is not a tier of the show is invalid.
+        var bad = ShowBody(venue, [Tier(id: Guid.NewGuid())]);
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.PutAsJsonAsync($"/shows/{id}", bad));
+    }
+
+    [TestMethod]
+    public async Task InvalidBodies()
+    {
+        var venue = await CreateVenue(capacity: 100);
+        var future = DateTime.UtcNow.AddDays(1);
+        var cases = new Dictionary<string, object>
+        {
+            ["missing title"] = new { title = "", startsAt = future, status = 0, venueId = venue },
+            ["long title"] = ShowBody(venue, title: new string('x', 201)),
+            ["unknown venue"] = ShowBody(Guid.NewGuid()),
+            ["no venue"] = new { title = "x", startsAt = future, status = 0 },
+            ["unknown status"] = ShowBody(venue, status: 7),
+            ["no start"] = new { title = "x", status = 0, venueId = venue },
+            ["tier name"] = ShowBody(venue, [Tier(name: "")]),
+            ["long tier name"] = ShowBody(venue, [Tier(name: new string('x', 51))]),
+            ["tier price"] = ShowBody(venue, [new { name = "x", quota = 1 }]),
+            ["over capacity"] = ShowBody(venue, [Tier("A", 1, 60), Tier("B", 1, 41)]),
+            ["duplicate tier names"] = ShowBody(venue, [Tier("A"), Tier("A")]),
+        };
+        foreach (var (name, body) in cases)
+        {
+            var response = await Client.PostAsJsonAsync("/shows", body);
+            Assert.AreEqual(HttpStatusCode.BadRequest, response.StatusCode, name);
+            Assert.IsTrue((await Json(response)).TryGetProperty("errors", out _), name);
+        }
+        await AssertStatus(HttpStatusCode.Created, await Client.PostAsJsonAsync("/shows", ShowBody(venue, [Tier("A", 1, 60), Tier("B", 1, 40)])));
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIsNotFound()
+    {
+        var venue = await CreateVenue();
+        await AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/shows/{Guid.NewGuid()}"));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.PutAsJsonAsync($"/shows/{Guid.NewGuid()}", ShowBody(venue)));
+        await AssertStatus(HttpStatusCode.NotFound, await Client.DeleteAsync($"/shows/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task PutChecksTheCapacityOfTheNewVenue()
+    {
+        var big = await CreateVenue("Big", 100);
+        var small = await CreateVenue("Small", 10);
+        var id = await CreateShow(big, [Tier(quota: 50)]);
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.PutAsJsonAsync($"/shows/{id}", ShowBody(small, [Tier(quota: 50)])));
+    }
+
+    [TestMethod]
+    public async Task IsSoldOut()
+    {
+        var venue = await CreateVenue();
+        var empty = await CreateShow(venue, []);
+        Assert.IsFalse((await Json(await Client.GetAsync($"/shows/{empty}"))).GetProperty("isSoldOut").GetBoolean());
+
+        var id = await CreateShow(venue, [Tier("A", 1, 2), Tier("B", 1, 1)]);
+        await AssertStatus(HttpStatusCode.OK, await Book(id, "A", 2));
+        Assert.IsFalse((await Json(await Client.GetAsync($"/shows/{id}"))).GetProperty("isSoldOut").GetBoolean());
+        await AssertStatus(HttpStatusCode.OK, await Book(id, "B", 1));
+        Assert.IsTrue((await Json(await Client.GetAsync($"/shows/{id}"))).GetProperty("isSoldOut").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task ShowWithBookingsCannotBeDeleted()
+    {
+        var id = await CreateShow(await CreateVenue());
+        await AssertStatus(HttpStatusCode.OK, await Book(id));
+        await AssertStatus(HttpStatusCode.Conflict, await Client.DeleteAsync($"/shows/{id}"));
+    }
+
+    [TestMethod]
+    public async Task PagingOrdersAndRejectsUnsortableProperties()
+    {
+        var venue = await CreateVenue();
+        await CreateShow(venue, [Tier()], startsAt: DateTime.UtcNow.AddDays(5));
+        await CreateShow(venue, [Tier()], startsAt: DateTime.UtcNow.AddDays(2));
+        var page = await Json(await Client.GetAsync("/shows?orderBy=StartsAt&descending=true"));
+        Assert.IsTrue(page.GetProperty("items")[0].GetProperty("startsAt").GetDateTime() > page.GetProperty("items")[1].GetProperty("startsAt").GetDateTime());
+        await AssertStatus(HttpStatusCode.OK, await Client.GetAsync("/shows?orderBy=Status"));
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.GetAsync("/shows?orderBy=TicketTiers"));
+        await AssertStatus(HttpStatusCode.BadRequest, await Client.GetAsync("/shows?orderBy=IsSoldOut"));
+    }
+}
diff --git a/src/Ticketing.Tests/VenueTests.cs b/src/Ticketing.Tests/VenueTests.cs
