--- /dev/null
+++ b/src/Ticketing.Application/VenueService.cs
@@ -0,0 +1,79 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public class VenueService(IVenueRepository venues, IUnitOfWork unitOfWork)
+{
+    public Task<Result<Page<VenueDto>>> QueryAsync(PageQuery query, CancellationToken ct = default) =>
+        Paging.QueryAsync(venues, query, v => VenueDto.From(v, false), ct);
+
+    public async Task<Result<VenueDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetAsync(id, ct);
+        return venue is null ? Error.NotFound("Venue not found.") : VenueDto.From(venue, true);
+    }
+
+    public async Task<Result<VenueDto>> AddAsync(VenueInput input, CancellationToken ct = default)
+    {
+        var errors = Validate(input);
+        if (!errors.IsValid) return errors.ToError();
+
+        var venue = new Venue();
+        Apply(venue, input);
+        venues.Add(venue);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? VenueDto.From(venue, true) : Taken(commit.Error!);
+    }
+
+    public async Task<Result<VenueDto>> UpdateAsync(Guid id, VenueInput input, CancellationToken ct = default)
+    {
+        var venue = await venues.GetAsync(id, ct);
+        if (venue is null) return Error.NotFound("Venue not found.");
+
+        var errors = Validate(input);
+        if (errors.IsValid && venue.Shows.Any(s => s.TicketTiers.Sum(t => (long)t.Quota) > input.Capacity))
+            errors.Add("capacity", "The capacity is lower than the quotas of the tiers of a show of this venue.");
+        if (!errors.IsValid) return errors.ToError();
+
+        Apply(venue, input);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? VenueDto.From(venue, true) : Taken(commit.Error!);
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetAsync(id, ct);
+        if (venue is null) return Error.NotFound("Venue not found.");
+        if (venue.Shows.Count > 0) return Error.Conflict("The venue still has shows.");
+
+        venues.Remove(venue);
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    private static Error Taken(Error error) =>
+        error.Kind == ErrorKind.Conflict ? Error.Conflict("A venue with this name already exists.") : error;
+
+    private static void Apply(Venue venue, VenueInput input)
+    {
+        venue.Name = input.Name!.Trim();
+        venue.Address = new Address(input.Address!.Street!, input.Address.City!, input.Address.PostalCode!);
+        venue.Capacity = input.Capacity!.Value;
+    }
+
+    private static ValidationErrors Validate(VenueInput input)
+    {
+        var errors = new ValidationErrors();
+        errors.Required("name", input.Name?.Trim(), 100);
+        if (input.Address is null) errors.Add("address", "The address is required.");
+        else
+        {
+            errors.Required("address.street", input.Address.Street, 100);
+            errors.Required("address.city", input.Address.City, 50);
+            errors.Required("address.postalCode", input.Address.PostalCode, 10);
+        }
+        if (input.Capacity is null) errors.Add("capacity", "The capacity is required.");
+        else if (input.Capacity < 0) errors.Add("capacity", "The capacity cannot be negative.");
+        return errors;
+    }
+}
