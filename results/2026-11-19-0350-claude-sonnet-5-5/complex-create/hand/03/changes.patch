diff --git a/src/Ticketing.Infrastructure/TicketingDbContext.cs b/src/Ticketing.Infrastructure/TicketingDbContext.cs
new file mode 100644
index 0000000..16ae7b0
--- /dev/null
+++ b/src/Ticketing.Infrastructure/TicketingDbContext.cs
@@ -0,0 +1,54 @@
+using Acme.Ticketing.Domain;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public class TicketingDbContext(DbContextOptions<TicketingDbContext> options) : DbContext(options)
+{
+    public DbSet<Venue> Venues => Set<Venue>();
+    public DbSet<Show> Shows => Set<Show>();
+    public DbSet<Booking> Bookings => Set<Booking>();
+
+    protected override void ConfigureConventions(ModelConfigurationBuilder builder)
+    {
+        // SQLite cannot order by its default TEXT decimals.
+        builder.Properties<decimal>().HaveConversion<double>();
+    }
+
+    protected override void OnModelCreating(ModelBuilder model)
+    {
+        model.Entity<Venue>(e =>
+        {
+            e.Property(v => v.Id).ValueGeneratedNever();
+            e.Property(v => v.Name).HasMaxLength(100).IsRequired();
+            e.HasIndex(v => v.Name).IsUnique();
+            e.OwnsOne(v => v.Address, a => a.ToJson());
+            e.Navigation(v => v.Address).IsRequired();
+            e.HasMany(v => v.Shows).WithOne().HasForeignKey(s => s.VenueId).OnDelete(DeleteBehavior.Restrict);
+        });
+
+        model.Entity<Show>(e =>
+        {
+            e.Property(s => s.Id).ValueGeneratedNever();
+            e.Property(s => s.Title).HasMaxLength(200).IsRequired();
+            e.Property(s => s.StartsAt).HasConversion(
+                v => v.ToUniversalTime(), v => DateTime.SpecifyKind(v, DateTimeKind.Utc));
+            e.HasMany(s => s.TicketTiers).WithOne().HasForeignKey(t => t.ShowId).OnDelete(DeleteBehavior.Cascade);
+        });
+
+        model.Entity<TicketTier>(e =>
+        {
+            e.Property(t => t.Id).ValueGeneratedNever();
+            e.Property(t => t.Name).HasMaxLength(50).IsRequired();
+            e.Property(t => t.Sold).IsConcurrencyToken();
+        });
+
+        model.Entity<Booking>(e =>
+        {
+            e.Property(b => b.Id).ValueGeneratedNever();
+            e.Property(b => b.Tier).IsRequired();
+            e.Property(b => b.CustomerEmail).IsRequired();
+            e.HasOne<Show>().WithMany().HasForeignKey(b => b.ShowId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
