+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class BoxOfficeTests : ApiTestBase
+{
+    private async Task<Guid> OnSaleShow(int status = 1, DateTime? startsAt = null)
+    {
+        var venue = await CreateVenue();
+        return IdOf(await CreateShow(IdOf(venue), [Tier("Standard", 12.5m, 5)], status, startsAt));
+    }
+
+    [TestMethod]
+    public async Task BooksAndRecordsBooking()
+    {
+        var showId = await OnSaleShow();
+        var booking = await Ok(await Book(showId, "Standard", 3, "x@y.z"));
+        Assert.AreEqual(37.5m, booking["totalPrice"]!.GetValue<decimal>());
+        Assert.AreEqual("Standard", (string?)booking["tier"]);
+        Assert.AreEqual(showId, booking["showId"]!.GetValue<Guid>());
+
+        var show = await Ok(await Client.GetAsync($"/shows/{showId}"));
+        Assert.AreEqual(3, (int?)show["ticketTiers"]![0]!["sold"]);
+
+        var got = await Ok(await Client.GetAsync($"/bookings/{IdOf(booking)}"));
+        Assert.AreEqual("x@y.z", (string?)got["customerEmail"]);
+        var page = await Ok(await Client.GetAsync("/bookings?orderBy=TotalPrice&descending=true"));
+        Assert.AreEqual(1, (int?)page["totalCount"]);
+        AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/bookings/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    [DataRow(0)]
+    [DataRow(11)]
+    [DataRow(-1)]
+    public async Task QuantityOutOfRangeIs400(int quantity) =>
+        AssertStatus(HttpStatusCode.BadRequest, await Book(await OnSaleShow(), quantity: quantity));
+
+    [TestMethod]
+    public async Task EmailWithoutAtIs400() =>
+        AssertStatus(HttpStatusCode.BadRequest, await Book(await OnSaleShow(), email: "nope"));
+
+    [TestMethod]
+    public async Task ValidationComesBeforeLookup() =>
+        AssertStatus(HttpStatusCode.BadRequest, await Book(Guid.NewGuid(), quantity: 0));
+
+    [TestMethod]
+    public async Task UnknownShowIs404() => AssertStatus(HttpStatusCode.NotFound, await Book(Guid.NewGuid()));
+
+    [TestMethod]
+    [DataRow(0)]
+    [DataRow(2)]
+    public async Task ShowNotOnSaleIs409(int status) =>
+        AssertStatus(HttpStatusCode.Conflict, await Book(await OnSaleShow(status)));
+
+    [TestMethod]
+    public async Task ShowInThePastIs409()
+    {
+        var showId = await OnSaleShow(startsAt: Clock.UtcNow.AddDays(1));
+        Clock.UtcNow = Clock.UtcNow.AddDays(2);
+        AssertStatus(HttpStatusCode.Conflict, await Book(showId));
+    }
+
+    [TestMethod]
+    public async Task UnknownTierIs400() =>
+        AssertStatus(HttpStatusCode.BadRequest, await Book(await OnSaleShow(), "Nope"));
+
+    [TestMethod]
+    public async Task NotEnoughTicketsIs409AndChangesNothing()
+    {
+        var showId = await OnSaleShow();
+        AssertStatus(HttpStatusCode.OK, await Book(showId, quantity: 4));
+        AssertStatus(HttpStatusCode.Conflict, await Book(showId, quantity: 2));
+        AssertStatus(HttpStatusCode.OK, await Book(showId, quantity: 1));
+
+        var show = await Ok(await Client.GetAsync($"/shows/{showId}"));
+        Assert.AreEqual(5, (int?)show["ticketTiers"]![0]!["sold"]);
+        Assert.AreEqual(2, (int?)(await Json(await Client.GetAsync("/bookings")))["totalCount"]);
+    }
+
+    [TestMethod]
+    public async Task ConcurrentBookingsNeverOversell()
+    {
+        var showId = await OnSaleShow();
+        var results = await Task.WhenAll(Enumerable.Range(0, 8).Select(_ => Book(showId, quantity: 1)));
+        var ok = results.Count(r => r.StatusCode == HttpStatusCode.OK);
+        Assert.IsTrue(results.All(r => r.StatusCode is HttpStatusCode.OK or HttpStatusCode.Conflict));
+        var show = await Ok(await Client.GetAsync($"/shows/{showId}"));
+        Assert.AreEqual(ok, (int?)show["ticketTiers"]![0]!["sold"]);
+        Assert.IsTrue(ok <= 5);
+    }
+}
