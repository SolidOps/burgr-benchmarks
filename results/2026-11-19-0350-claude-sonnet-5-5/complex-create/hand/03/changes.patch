+using Acme.Ticketing.Application.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public class UnitOfWork(TicketingDbContext db) : IUnitOfWork
+{
+    public async Task<Result> CommitAsync(CancellationToken ct = default)
+    {
+        try
+        {
+            await db.SaveChangesAsync(ct);
+            return Result.Success;
+        }
+        catch (DbUpdateConcurrencyException)
+        {
+            return Error.Conflict("The data was changed by someone else; try again.");
+        }
+        catch (DbUpdateException e) when (e.InnerException?.Message.Contains("constraint failed", StringComparison.OrdinalIgnoreCase) == true)
+        {
+            return Error.Conflict("The change violates a unique value or a reference.");
+        }
+    }
+}
