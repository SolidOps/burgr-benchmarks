@@ -0,0 +1,122 @@
+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class VenueTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var created = await CreateVenue("Arena", 100);
+        var id = IdOf(created);
+        Assert.AreEqual("Paris", (string?)created["address"]!["city"]);
+
+        var got = await Ok(await Client.GetAsync($"/venues/{id}"));
+        Assert.AreEqual("Arena", (string?)got["name"]);
+        Assert.AreEqual(0, got["shows"]!.AsArray().Count);
+
+        var put = await Ok(await Client.PutAsJsonAsync($"/venues/{id}", new
+        {
+            name = "Arena 2",
+            address = new { street = "2 Rue", city = "Lyon", postalCode = "69001" },
+            capacity = 200,
+        }));
+        Assert.AreEqual("Lyon", (string?)put["address"]!["city"]);
+        Assert.AreEqual(200, (int?)put["capacity"]);
+
+        AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/venues/{id}"));
+        AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/venues/{id}"));
+    }
+
+    [TestMethod]
+    public async Task Validation()
+    {
+        var response = await Client.PostAsJsonAsync("/venues", new
+        {
+            name = new string('x', 101),
+            address = new { street = "", city = new string('c', 51), postalCode = "12345678901" },
+            capacity = 1,
+        });
+        var body = await Ok(response, HttpStatusCode.BadRequest);
+        var errors = body["errors"]!.AsObject();
+        foreach (var key in new[] { "name", "address.street", "address.city", "address.postalCode" })
+            Assert.IsTrue(errors.ContainsKey(key), key);
+    }
+
+    [TestMethod]
+    public async Task NameIsUnique()
+    {
+        await CreateVenue("Arena");
+        var other = await CreateVenue("Other");
+        var body = new { name = "Arena", address = new { street = "s", city = "c", postalCode = "p" }, capacity = 1 };
+        AssertStatus(HttpStatusCode.Conflict, await Client.PostAsJsonAsync("/venues", body));
+        AssertStatus(HttpStatusCode.Conflict, await Client.PutAsJsonAsync($"/venues/{IdOf(other)}", body));
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIs404()
+    {
+        AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/venues/{Guid.NewGuid()}"));
+        AssertStatus(HttpStatusCode.NotFound, await Client.DeleteAsync($"/venues/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task VenueWithShowsCannotBeDeletedAndListsItsShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue));
+        AssertStatus(HttpStatusCode.Conflict, await Client.DeleteAsync($"/venues/{IdOf(venue)}"));
+
+        var got = await Ok(await Client.GetAsync($"/venues/{IdOf(venue)}"));
+        Assert.AreEqual(IdOf(show), got["shows"]![0]!["id"]!.GetValue<Guid>());
+
+        AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/shows/{IdOf(show)}"));
+        AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/venues/{IdOf(venue)}"));
+    }
+
+    [TestMethod]
+    public async Task CapacityCannotDropBelowShowQuotas()
+    {
+        var venue = await CreateVenue(capacity: 100);
+        await CreateShow(IdOf(venue), [Tier("A", 1m, 60)]);
+        var response = await Client.PutAsJsonAsync($"/venues/{IdOf(venue)}", new
+        {
+            name = "Arena",
+            address = new { street = "s", city = "c", postalCode = "p" },
+            capacity = 50,
+        });
+        AssertStatus(HttpStatusCode.BadRequest, response);
+    }
+
+    [TestMethod]
+    public async Task PagingAndOrdering()
+    {
+        foreach (var n in new[] { "B", "C", "A" }) await CreateVenue(n);
+
+        var page = await Ok(await Client.GetAsync("/venues?orderBy=Name&pageSize=2"));
+        Assert.AreEqual(3, (int?)page["totalCount"]);
+        Assert.AreEqual(1, (int?)page["pageNumber"]);
+        Assert.AreEqual(2, (int?)page["pageSize"]);
+        Assert.AreEqual("A", (string?)page["items"]![0]!["name"]);
+        Assert.AreEqual(2, page["items"]!.AsArray().Count);
+
+        var desc = await Ok(await Client.GetAsync("/venues?orderBy=Name&descending=true&page=2&pageSize=2"));
+        Assert.AreEqual(1, desc["items"]!.AsArray().Count);
+        Assert.AreEqual("A", (string?)desc["items"]![0]!["name"]);
+
+        await Ok(await Client.GetAsync("/venues?orderBy=Capacity"));
+    }
+
+    [TestMethod]
+    [DataRow("page=0")]
+    [DataRow("pageSize=0")]
+    [DataRow("pageSize=201")]
+    [DataRow("orderBy=Nope")]
+    [DataRow("orderBy=Address")]
+    [DataRow("page=abc")]
+    public async Task InvalidPagingIs400(string query) =>
+        AssertStatus(HttpStatusCode.BadRequest, await Client.GetAsync($"/venues?{query}"));
+}
