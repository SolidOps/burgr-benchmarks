+using System.IdentityModel.Tokens.Jwt;
+using System.Net;
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Nodes;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Extensions.DependencyInjection;
+using Microsoft.Extensions.DependencyInjection.Extensions;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests.Framework;
+
+/// <summary>A real host with a throw-away SQLite database per test and signed test tokens.</summary>
+public abstract class ApiTestBase
+{
+    public const string JwtKey = "test-key";
+
+    private string _dbPath = "";
+    private WebApplicationFactory<Program> _factory = null!;
+    protected FakeClock Clock { get; } = new();
+    protected HttpClient Client { get; private set; } = null!;
+
+    [TestInitialize]
+    public void Setup()
+    {
+        _dbPath = Path.Combine(Path.GetTempPath(), $"ticketing-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+        {
+            b.UseSetting("ConnectionStrings:Ticketing", $"Data Source={_dbPath};Pooling=False");
+            b.UseSetting("Jwt:Key", JwtKey);
+            b.ConfigureServices(s => s.Replace(ServiceDescriptor.Singleton<TimeProvider>(Clock)));
+        });
+        Client = AsUser("*");
+    }
+
+    [TestCleanup]
+    public void Cleanup()
+    {
+        Client.Dispose();
+        _factory.Dispose();
+        foreach (var f in Directory.GetFiles(Path.GetTempPath(), Path.GetFileName(_dbPath) + "*")) File.Delete(f);
+    }
+
+    protected HttpClient Anonymous() => _factory.CreateClient();
+
+    protected HttpClient AsUser(params string[] rights) => WithToken(MakeToken(rights));
+
+    protected HttpClient WithToken(string token)
+    {
+        var client = _factory.CreateClient();
+        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+        return client;
+    }
+
+    protected static string MakeToken(string[] rights, string key = JwtKey, DateTime? expires = null)
+    {
+        var bytes = Encoding.UTF8.GetBytes(key.PadRight(32));
+        var token = new JwtSecurityToken(
+            claims: rights.Select(r => new Claim("right", r)).Append(new Claim("sub", "tester")),
+            notBefore: DateTime.UtcNow.AddHours(-2),
+            expires: expires ?? DateTime.UtcNow.AddHours(1),
+            signingCredentials: new SigningCredentials(new SymmetricSecurityKey(bytes), SecurityAlgorithms.HmacSha256));
+        return new JwtSecurityTokenHandler().WriteToken(token);
+    }
+
+    protected static string Expired() => MakeToken(["*"], expires: DateTime.UtcNow.AddMinutes(-1));
+
+    // ---- helpers
+
+    protected static async Task<JsonNode> Json(HttpResponseMessage response) =>
+        JsonNode.Parse(await response.Content.ReadAsStringAsync()) ?? throw new InvalidOperationException("No JSON.");
+
+    protected static Guid IdOf(JsonNode node) => node["id"]!.GetValue<Guid>();
+
+    protected static void AssertStatus(HttpStatusCode expected, HttpResponseMessage response) =>
+        Assert.AreEqual(expected, response.StatusCode, response.Content.ReadAsStringAsync().Result);
+
+    protected async Task<JsonNode> Ok(HttpResponseMessage response, HttpStatusCode status = HttpStatusCode.OK)
+    {
+        AssertStatus(status, response);
+        return await Json(response);
+    }
+
+    protected async Task<JsonNode> CreateVenue(string name = "Arena", int capacity = 100)
+    {
+        var response = await Client.PostAsJsonAsync("/venues", new
+        {
+            name,
+            address = new { street = "1 Main St", city = "Paris", postalCode = "75001" },
+            capacity,
+        });
+        return await Ok(response, HttpStatusCode.Created);
+    }
+
+    protected static object Tier(string name, decimal price, int quota, Guid? id = null) => new { id, name, price, quota };
+
+    protected object ShowBody(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null, string title = "Concert") => new
+    {
+        title,
+        startsAt = startsAt ?? Clock.UtcNow.AddDays(10),
+        status,
+        venueId,
+        ticketTiers = tiers ?? [Tier("Standard", 10m, 50)],
+    };
+
+    protected async Task<JsonNode> CreateShow(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null)
+    {
+        var response = await Client.PostAsJsonAsync("/shows", ShowBody(venueId, tiers, status, startsAt));
+        return await Ok(response, HttpStatusCode.Created);
+    }
+
+    protected Task<HttpResponseMessage> Book(Guid showId, string tier = "Standard", int quantity = 1, string email = "a@b.c") =>
+        Client.PostAsJsonAsync("/box-office/book", new { showId, tier, customerEmail = email, quantity });
+}
+
+public sealed class FakeClock : TimeProvider
+{
+    public DateTime UtcNow { get; set; } = new(2030, 1, 1, 12, 0, 0, DateTimeKind.Utc);
+    public override DateTimeOffset GetUtcNow() => new(UtcNow);
+}
diff --git a/src/Ticketing.Tests/SecurityTests.cs b/src/Ticketing.Tests/SecurityTests.cs
new file mode 100644
index 0000000..c4872e9
--- /dev/null
+++ b/src/Ticketing.Tests/SecurityTests.cs
@@ -0,0 +1,81 @@
+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class SecurityTests : ApiTestBase
+{
+    private static readonly object VenueBody = new
+    {
+        name = "V", address = new { street = "s", city = "c", postalCode = "p" }, capacity = 10,
+    };
+
+    [TestMethod]
+    [DataRow("/venues")]
+    [DataRow("/shows")]
+    [DataRow("/bookings")]
+    public async Task NoTokenIs401(string url) => AssertStatus(HttpStatusCode.Unauthorized, await Anonymous().GetAsync(url));
+
+    [TestMethod]
+    public async Task BadTokensAre401()
+    {
+        AssertStatus(HttpStatusCode.Unauthorized, await WithToken(Expired()).GetAsync("/venues"));
+        AssertStatus(HttpStatusCode.Unauthorized, await WithToken(MakeToken(["*"], key: "other-key")).GetAsync("/venues"));
+        AssertStatus(HttpStatusCode.Unauthorized, await WithToken("garbage").GetAsync("/venues"));
+        AssertStatus(HttpStatusCode.Unauthorized, await Anonymous().PostAsJsonAsync("/box-office/book", new { }));
+    }
+
+    [TestMethod]
+    public async Task AuthenticatedWithoutRightsCanRead()
+    {
+        var user = AsUser();
+        AssertStatus(HttpStatusCode.OK, await user.GetAsync("/venues"));
+        AssertStatus(HttpStatusCode.OK, await user.GetAsync("/shows"));
+        AssertStatus(HttpStatusCode.NotFound, await user.GetAsync($"/venues/{Guid.NewGuid()}"));
+        AssertStatus(HttpStatusCode.BadRequest, await user.PostAsJsonAsync("/box-office/book", new { quantity = 0 }));
+    }
+
+    [TestMethod]
+    public async Task WritingVenuesRequiresManageVenues()
+    {
+        var venue = await CreateVenue();
+        var id = IdOf(venue);
+        foreach (var user in new[] { AsUser(), AsUser("ManageShows") })
+        {
+            AssertStatus(HttpStatusCode.Forbidden, await user.PostAsJsonAsync("/venues", VenueBody));
+            AssertStatus(HttpStatusCode.Forbidden, await user.PutAsJsonAsync($"/venues/{id}", VenueBody));
+            AssertStatus(HttpStatusCode.Forbidden, await user.DeleteAsync($"/venues/{id}"));
+        }
+        AssertStatus(HttpStatusCode.Created, await AsUser("ManageVenues").PostAsJsonAsync("/venues", VenueBody));
+    }
+
+    [TestMethod]
+    public async Task WritingShowsAndReadingBookingsRequireManageShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue));
+        var body = ShowBody(IdOf(venue));
+        foreach (var user in new[] { AsUser(), AsUser("ManageVenues") })
+        {
+            AssertStatus(HttpStatusCode.Forbidden, await user.PostAsJsonAsync("/shows", body));
+            AssertStatus(HttpStatusCode.Forbidden, await user.PutAsJsonAsync($"/shows/{IdOf(show)}", body));
+            AssertStatus(HttpStatusCode.Forbidden, await user.DeleteAsync($"/shows/{IdOf(show)}"));
+            AssertStatus(HttpStatusCode.Forbidden, await user.GetAsync("/bookings"));
+            AssertStatus(HttpStatusCode.Forbidden, await user.GetAsync($"/bookings/{Guid.NewGuid()}"));
+        }
+        var manager = AsUser("ManageShows");
+        AssertStatus(HttpStatusCode.Created, await manager.PostAsJsonAsync("/shows", body));
+        AssertStatus(HttpStatusCode.OK, await manager.GetAsync("/bookings"));
+    }
+
+    [TestMethod]
+    public async Task BookingOnlyNeedsAuthentication()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue));
+        AssertStatus(HttpStatusCode.OK, await AsUser().PostAsJsonAsync("/box-office/book",
+            new { showId = IdOf(show), tier = "Standard", customerEmail = "a@b.c", quantity = 1 }));
+    }
+}
diff --git a/src/Ticketing.Tests/ShowTests.cs b/src/Ticketing.Tests/ShowTests.cs
new file mode 100644
index 0000000..9c4c1ed
--- /dev/null
+++ b/src/Ticketing.Tests/ShowTests.cs
@@ -0,0 +1,146 @@
+using System.Net;
+using System.Net.Http.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class ShowTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var venue = await CreateVenue(capacity: 100);
+        var created = await CreateShow(IdOf(venue), [Tier("VIP", 99.5m, 10), Tier("Standard", 20m, 50)]);
+        var id = IdOf(created);
+        Assert.AreEqual(1, (int?)created["status"]);
+        Assert.AreEqual(2, created["ticketTiers"]!.AsArray().Count);
+        Assert.AreEqual(0, (int?)created["ticketTiers"]![0]!["sold"]);
+
+        var got = await Ok(await Client.GetAsync($"/shows/{id}"));
+        Assert.AreEqual(false, (bool?)got["isSoldOut"]);
+        Assert.AreEqual(99.5m, got["ticketTiers"]!.AsArray().First(t => (string?)t!["name"] == "VIP")!["price"]!.GetValue<decimal>());
+        Assert.AreEqual("2030-01-11T12:00:00Z", (string?)got["startsAt"]);
+
+        AssertStatus(HttpStatusCode.NoContent, await Client.DeleteAsync($"/shows/{id}"));
+        AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/shows/{id}"));
+    }
+
+    [TestMethod]
+    public async Task UpdateAddsUpdatesAndRemovesTiers()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue), [Tier("A", 1m, 10), Tier("B", 2m, 10)]);
+        var a = show["ticketTiers"]!.AsArray().First(t => (string?)t!["name"] == "A")!;
+
+        var body = ShowBody(IdOf(venue), [Tier("A2", 5m, 20, IdOf(a)), Tier("C", 3m, 5)], status: 0, title: "New");
+        var updated = await Ok(await Client.PutAsJsonAsync($"/shows/{IdOf(show)}", body));
+
+        Assert.AreEqual("New", (string?)updated["title"]);
+        Assert.AreEqual(0, (int?)updated["status"]);
+        var tiers = updated["ticketTiers"]!.AsArray();
+        Assert.AreEqual(2, tiers.Count);
+        var kept = tiers.First(t => (string?)t!["name"] == "A2")!;
+        Assert.AreEqual(IdOf(a), IdOf(kept));
+        Assert.AreEqual(20, (int?)kept["quota"]);
+        Assert.IsNotNull(tiers.FirstOrDefault(t => (string?)t!["name"] == "C"));
+
+        var got = await Ok(await Client.GetAsync($"/shows/{IdOf(show)}"));
+        Assert.AreEqual(2, got["ticketTiers"]!.AsArray().Count);
+    }
+
+    [TestMethod]
+    public async Task SoldIsIgnoredInBody()
+    {
+        var venue = await CreateVenue();
+        var response = await Client.PostAsJsonAsync("/shows", new
+        {
+            title = "T", startsAt = Clock.UtcNow.AddDays(1), status = 1, venueId = IdOf(venue),
+            ticketTiers = new[] { new { name = "A", price = 1m, quota = 5, sold = 5 } },
+        });
+        var body = await Ok(response, HttpStatusCode.Created);
+        Assert.AreEqual(0, (int?)body["ticketTiers"]![0]!["sold"]);
+    }
+
+    [TestMethod]
+    public async Task IsSoldOutWhenEveryTierIsSoldOut()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue), [Tier("A", 1m, 2), Tier("B", 1m, 1)]);
+        AssertStatus(HttpStatusCode.OK, await Book(IdOf(show), "A", 2));
+        Assert.AreEqual(false, (bool?)(await Json(await Client.GetAsync($"/shows/{IdOf(show)}")))["isSoldOut"]);
+        AssertStatus(HttpStatusCode.OK, await Book(IdOf(show), "B", 1));
+        Assert.AreEqual(true, (bool?)(await Json(await Client.GetAsync($"/shows/{IdOf(show)}")))["isSoldOut"]);
+
+        var empty = await CreateShow(IdOf(venue), []);
+        Assert.AreEqual(false, (bool?)empty["isSoldOut"]);
+    }
+
+    [TestMethod]
+    public async Task InvalidBodies()
+    {
+        var venue = await CreateVenue(capacity: 10);
+        var v = IdOf(venue);
+
+        async Task<JsonNodeResult> Post(object body) => new(await Client.PostAsJsonAsync("/shows", body));
+
+        // title too long, unknown venue, unknown status, tier errors
+        var r = await Post(ShowBody(Guid.NewGuid(), [Tier("", 1m, 1), Tier(new string('n', 51), 1m, 1)], status: 7, title: new string('t', 201)));
+        AssertStatus(HttpStatusCode.BadRequest, r.Response);
+        var errors = (await Json(r.Response))["errors"]!.AsObject();
+        foreach (var key in new[] { "title", "venueId", "status", "ticketTiers[0].name", "ticketTiers[1].name" })
+            Assert.IsTrue(errors.ContainsKey(key), key);
+
+        // quotas over capacity
+        AssertStatus(HttpStatusCode.BadRequest, (await Post(ShowBody(v, [Tier("A", 1m, 6), Tier("B", 1m, 5)]))).Response);
+        AssertStatus(HttpStatusCode.Created, (await Post(ShowBody(v, [Tier("A", 1m, 6), Tier("B", 1m, 4)]))).Response);
+
+        // a tier id that is not in the show
+        AssertStatus(HttpStatusCode.BadRequest, (await Post(ShowBody(v, [Tier("A", 1m, 1, Guid.NewGuid())]))).Response);
+    }
+
+    private sealed record JsonNodeResult(HttpResponseMessage Response);
+
+    [TestMethod]
+    public async Task QuotaCannotDropBelowSold()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue), [Tier("A", 1m, 10)]);
+        AssertStatus(HttpStatusCode.OK, await Book(IdOf(show), "A", 5));
+        var tier = show["ticketTiers"]![0]!;
+        var body = ShowBody(IdOf(venue), [Tier("A", 1m, 3, IdOf(tier))]);
+        AssertStatus(HttpStatusCode.BadRequest, await Client.PutAsJsonAsync($"/shows/{IdOf(show)}", body));
+    }
+
+    [TestMethod]
+    public async Task UnknownShowIs404()
+    {
+        var venue = await CreateVenue();
+        AssertStatus(HttpStatusCode.NotFound, await Client.GetAsync($"/shows/{Guid.NewGuid()}"));
+        AssertStatus(HttpStatusCode.NotFound, await Client.PutAsJsonAsync($"/shows/{Guid.NewGuid()}", ShowBody(IdOf(venue))));
+        AssertStatus(HttpStatusCode.NotFound, await Client.DeleteAsync($"/shows/{Guid.NewGuid()}"));
+    }
+
+    [TestMethod]
+    public async Task ShowWithBookingsCannotBeDeleted()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(IdOf(venue));
+        AssertStatus(HttpStatusCode.OK, await Book(IdOf(show)));
+        AssertStatus(HttpStatusCode.Conflict, await Client.DeleteAsync($"/shows/{IdOf(show)}"));
+    }
+
+    [TestMethod]
+    public async Task PagingOrdersByDateAndTitle()
+    {
+        var venue = await CreateVenue();
+        await CreateShow(IdOf(venue), startsAt: Clock.UtcNow.AddDays(5));
+        await CreateShow(IdOf(venue), startsAt: Clock.UtcNow.AddDays(2));
+
+        var page = await Ok(await Client.GetAsync("/shows?orderBy=StartsAt"));
+        Assert.AreEqual(2, (int?)page["totalCount"]);
+        Assert.IsTrue(string.CompareOrdinal((string?)page["items"]![0]!["startsAt"], (string?)page["items"]![1]!["startsAt"]) < 0);
+        await Ok(await Client.GetAsync("/shows?orderBy=Title&descending=true"));
+        await Ok(await Client.GetAsync("/shows?orderBy=Status"));
+    }
+}
