+++ b/src/Ticketing.Application/ShowService.cs
@@ -0,0 +1,124 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public class ShowService(IShowRepository shows, IVenueRepository venues, IBookingRepository bookings, IUnitOfWork unitOfWork)
+{
+    public Task<Result<Page<ShowDto>>> QueryAsync(PageQuery query, CancellationToken ct = default) =>
+        Paging.QueryAsync(shows, query, ShowDto.From, ct);
+
+    public async Task<Result<ShowDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        return show is null ? Error.NotFound("Show not found.") : ShowDto.From(show);
+    }
+
+    public async Task<Result<ShowDto>> AddAsync(ShowInput input, CancellationToken ct = default)
+    {
+        var show = new Show();
+        var error = await ApplyAsync(show, input, isNew: true, ct);
+        if (error is not null) return error;
+
+        shows.Add(show);
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? ShowDto.From(show) : commit.Error!;
+    }
+
+    public async Task<Result<ShowDto>> UpdateAsync(Guid id, ShowInput input, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+
+        var error = await ApplyAsync(show, input, isNew: false, ct);
+        if (error is not null) return error;
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? ShowDto.From(show) : commit.Error!;
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+        if (await bookings.AnyForShowAsync(id, ct)) return Error.Conflict("The show has bookings.");
+
+        shows.Remove(show);
+        return await unitOfWork.CommitAsync(ct);
+    }
+
+    /// <summary>Validates the input and applies it to the show; returns the error, if any.</summary>
+    private async Task<Error?> ApplyAsync(Show show, ShowInput input, bool isNew, CancellationToken ct)
+    {
+        var errors = new ValidationErrors();
+        errors.Required("title", input.Title, 200);
+        if (input.StartsAt is null) errors.Add("startsAt", "The start date is required.");
+        var status = ShowStatus.Draft;
+        if (input.Status is { } s)
+        {
+            if (Enum.IsDefined(typeof(ShowStatus), s)) status = (ShowStatus)s;
+            else errors.Add("status", "The status is unknown.");
+        }
+
+        Venue? venue = null;
+        if (input.VenueId is null || input.VenueId == Guid.Empty) errors.Add("venueId", "The venue is required.");
+        else
+        {
+            venue = await venues.GetAsync(input.VenueId.Value, ct);
+            if (venue is null) errors.Add("venueId", "The venue does not exist.");
+        }
+
+        var tiers = input.TicketTiers ?? [];
+        var names = new HashSet<string>();
+        var ids = new HashSet<Guid>();
+        for (var i = 0; i < tiers.Count; i++)
+        {
+            var tier = tiers[i];
+            var path = $"ticketTiers[{i}]";
+            if (tier is null) { errors.Add(path, "The tier is required."); continue; }
+            errors.Required($"{path}.name", tier.Name, 50);
+            if (!string.IsNullOrWhiteSpace(tier.Name) && !names.Add(tier.Name))
+                errors.Add($"{path}.name", "The tier name is already used in this show.");
+            if (tier.Price is null) errors.Add($"{path}.price", "The price is required.");
+            else if (tier.Price < 0) errors.Add($"{path}.price", "The price cannot be negative.");
+            if (tier.Quota is null) errors.Add($"{path}.quota", "The quota is required.");
+            else if (tier.Quota < 0) errors.Add($"{path}.quota", "The quota cannot be negative.");
+
+            if (tier.Id is { } tierId)
+            {
+                var existing = isNew ? null : show.TicketTiers.FirstOrDefault(t => t.Id == tierId);
+                if (existing is null || !ids.Add(tierId)) errors.Add($"{path}.id", "The tier does not belong to this show.");
+                else if (tier.Quota < existing.Sold)
+                    errors.Add($"{path}.quota", "The quota cannot be lower than the number of tickets sold.");
+            }
+        }
+
+        if (venue is not null && tiers.Where(t => t?.Quota is > 0).Sum(t => (long)t.Quota!.Value) > venue.Capacity)
+            errors.Add("ticketTiers", "The quotas of the tiers exceed the capacity of the venue.");
+
+        if (!errors.IsValid) return errors.ToError();
+
+        show.Title = input.Title!.Trim();
+        show.StartsAt = input.StartsAt!.Value.Kind == DateTimeKind.Unspecified
+            ? DateTime.SpecifyKind(input.StartsAt.Value, DateTimeKind.Utc)
+            : input.StartsAt.Value.ToUniversalTime();
+        show.Status = status;
+        show.VenueId = venue!.Id;
+
+        foreach (var removed in show.TicketTiers.Where(t => !ids.Contains(t.Id)).ToList())
+            show.TicketTiers.Remove(removed);
+        foreach (var tier in tiers)
+        {
+            var target = tier.Id is { } id ? show.TicketTiers.First(t => t.Id == id) : new TicketTier();
+            target.Name = tier.Name!;
+            target.Price = tier.Price!.Value;
+            target.Quota = tier.Quota!.Value;
+            if (tier.Id is null)
+            {
+                target.ShowId = show.Id;
+                show.TicketTiers.Add(target);
+            }
+        }
+        return null;
+    }
+}
