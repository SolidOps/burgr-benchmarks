@@ -0,0 +1,48 @@
+using System.Linq.Expressions;
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public abstract class EfRepository<T>(TicketingDbContext db) : IRepository<T> where T : Entity
+{
+    protected TicketingDbContext Db => db;
+
+    /// <summary>The query with the children loaded by <see cref="GetAsync"/>.</summary>
+    protected virtual IQueryable<T> WithChildren(IQueryable<T> query) => query;
+
+    /// <summary>The query with the children loaded for the items of a page.</summary>
+    protected virtual IQueryable<T> WithListChildren(IQueryable<T> query) => query;
+
+    public Task<T?> GetAsync(Guid id, CancellationToken ct = default) =>
+        WithChildren(db.Set<T>()).FirstOrDefaultAsync(e => e.Id == id, ct);
+
+    public async Task<(IReadOnlyList<T> Items, int TotalCount)> QueryAsync(
+        int skip, int take, string? orderBy, bool descending, CancellationToken ct = default)
+    {
+        var total = await db.Set<T>().CountAsync(ct);
+        var query = WithListChildren(db.Set<T>().AsNoTracking());
+        var ordered = orderBy is null
+            ? query.OrderBy(e => e.Id)
+            : OrderByProperty(query, typeof(T).GetProperty(orderBy)!, descending).ThenBy(e => e.Id);
+        return (await ordered.Skip(skip).Take(take).ToListAsync(ct), total);
+    }
+
+    public void Add(T entity) => db.Set<T>().Add(entity);
+
+    public void Remove(T entity) => db.Set<T>().Remove(entity);
+
+    private static IOrderedQueryable<T> OrderByProperty(IQueryable<T> query, PropertyInfo property, bool descending)
+    {
+        var parameter = Expression.Parameter(typeof(T), "e");
+        var selector = Expression.Lambda(Expression.Property(parameter, property), parameter);
+        var call = Expression.Call(
+            typeof(Queryable),
+            descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy),
+            [typeof(T), property.PropertyType],
+            query.Expression,
+            Expression.Quote(selector));
+        return (IOrderedQueryable<T>)query.Provider.CreateQuery<T>(call);
+    }
+}
