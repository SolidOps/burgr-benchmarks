+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain;
+
+namespace Acme.Ticketing.Application;
+
+public class BoxOfficeService(IShowRepository shows, IBookingRepository bookings, IUnitOfWork unitOfWork, TimeProvider clock)
+{
+    public async Task<Result<BookingDto>> BookAsync(BookInput input, CancellationToken ct = default)
+    {
+        var errors = new ValidationErrors();
+        if (input.Quantity is not (>= 1 and <= 10)) errors.Add("quantity", "The quantity must be between 1 and 10.");
+        if (input.CustomerEmail is null || !input.CustomerEmail.Contains('@'))
+            errors.Add("customerEmail", "The email must contain an '@'.");
+        if (!errors.IsValid) return errors.ToError();
+
+        var show = await shows.GetAsync(input.ShowId ?? Guid.Empty, ct);
+        if (show is null) return Error.NotFound("Show not found.");
+        if (show.Status != ShowStatus.OnSale) return Error.Conflict("The show is not on sale.");
+        if (show.StartsAt <= clock.GetUtcNow().UtcDateTime) return Error.Conflict("The show has already started.");
+
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == input.Tier);
+        if (tier is null) return Error.Invalid("tier", "The show has no tier with this name.");
+
+        var quantity = input.Quantity!.Value;
+        if (tier.Quota - tier.Sold < quantity) return Error.Conflict("Not enough tickets left in this tier.");
+
+        tier.Sold += quantity;
+        var booking = new Booking
+        {
+            ShowId = show.Id,
+            Tier = tier.Name,
+            CustomerEmail = input.CustomerEmail!,
+            Quantity = quantity,
+            TotalPrice = tier.Price * quantity,
+        };
+        bookings.Add(booking);
+
+        var commit = await unitOfWork.CommitAsync(ct);
+        return commit.IsSuccess ? BookingDto.From(booking) : commit.Error!;
+    }
+}
