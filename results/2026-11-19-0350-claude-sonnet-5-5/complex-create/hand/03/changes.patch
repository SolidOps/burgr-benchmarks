@@ -0,0 +1,24 @@
+namespace Acme.Ticketing.Application.Framework;
+
+/// <summary>Collects validation errors by property path (camelCase, e.g. <c>address.street</c>).</summary>
+public sealed class ValidationErrors
+{
+    private readonly Dictionary<string, List<string>> _errors = [];
+
+    public bool IsValid => _errors.Count == 0;
+
+    public void Add(string path, string message)
+    {
+        if (!_errors.TryGetValue(path, out var list)) _errors[path] = list = [];
+        list.Add(message);
+    }
+
+    public void Required(string path, string? value, int maxLength)
+    {
+        if (string.IsNullOrWhiteSpace(value)) Add(path, "The value is required.");
+        else if (value.Length > maxLength) Add(path, $"The value must be at most {maxLength} characters.");
+    }
+
+    public Error ToError() => new(ErrorKind.Invalid, "Validation failed.",
+        _errors.ToDictionary(e => e.Key, e => e.Value.ToArray()));
+}
