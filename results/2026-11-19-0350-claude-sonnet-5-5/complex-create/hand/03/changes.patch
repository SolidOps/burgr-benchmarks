+++ b/src/Ticketing.Api/Program.cs
@@ -0,0 +1,53 @@
+using System.Text;
+using Acme.Ticketing.Api;
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Infrastructure;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.IdentityModel.Tokens;
+
+var builder = WebApplication.CreateBuilder(args);
+
+builder.Services.AddTicketingApplication();
+builder.Services.AddTicketingInfrastructure(options =>
+    options.UseSqlite(builder.Configuration.GetConnectionString("Ticketing")));
+
+builder.Services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme).AddJwtBearer();
+builder.Services.AddOptions<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme)
+    .Configure<IConfiguration>((options, configuration) =>
+    {
+        var key = Encoding.UTF8.GetBytes(configuration["Jwt:Key"] ?? throw new InvalidOperationException("Jwt:Key is missing."));
+        if (key.Length < 32) key = [.. key, .. Enumerable.Repeat((byte)' ', 32 - key.Length)];
+        options.MapInboundClaims = false;
+        options.TokenValidationParameters = new TokenValidationParameters
+        {
+            ValidateIssuerSigningKey = true,
+            IssuerSigningKey = new SymmetricSecurityKey(key),
+            ValidAlgorithms = [SecurityAlgorithms.HmacSha256],
+            ValidateLifetime = true,
+            RequireExpirationTime = false,
+            ClockSkew = TimeSpan.Zero,
+            ValidateIssuer = false,
+            ValidateAudience = false,
+        };
+    });
+
+static bool HasRight(System.Security.Claims.ClaimsPrincipal user, string right) =>
+    user.HasClaim("right", Rights.All) || user.HasClaim("right", right);
+
+builder.Services.AddAuthorizationBuilder()
+    .SetFallbackPolicy(new Microsoft.AspNetCore.Authorization.AuthorizationPolicyBuilder().RequireAuthenticatedUser().Build())
+    .AddPolicy(Rights.ManageVenues, p => p.RequireAuthenticatedUser().RequireAssertion(c => HasRight(c.User, Rights.ManageVenues)))
+    .AddPolicy(Rights.ManageShows, p => p.RequireAuthenticatedUser().RequireAssertion(c => HasRight(c.User, Rights.ManageShows)));
+
+var app = builder.Build();
+
+app.Services.EnsureTicketingDatabase();
+
+app.UseAuthentication();
+app.UseAuthorization();
+app.MapTicketing();
+
+app.Run();
+
+public partial class Program;
