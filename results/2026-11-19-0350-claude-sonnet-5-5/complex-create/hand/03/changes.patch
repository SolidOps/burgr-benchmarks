+namespace Acme.Ticketing.Application.Framework;
+
+public enum ErrorKind { NotFound, Invalid, Conflict, Forbidden }
+
+public sealed record Error(ErrorKind Kind, string Message, IReadOnlyDictionary<string, string[]>? Details = null)
+{
+    public static Error NotFound(string message) => new(ErrorKind.NotFound, message);
+    public static Error Conflict(string message) => new(ErrorKind.Conflict, message);
+    public static Error Forbidden(string message) => new(ErrorKind.Forbidden, message);
+    public static Error Invalid(string path, string message) =>
+        new(ErrorKind.Invalid, "Validation failed.", new Dictionary<string, string[]> { [path] = [message] });
+}
+
+public class Result
+{
+    public Error? Error { get; protected init; }
+    public bool IsSuccess => Error is null;
+
+    public static Result Success { get; } = new();
+
+    public static implicit operator Result(Error error) => new() { Error = error };
+}
+
+public sealed class Result<T> : Result
+{
+    public T Value { get; private init; } = default!;
+
+    public static implicit operator Result<T>(T value) => new() { Value = value };
+    public static implicit operator Result<T>(Error error) => new() { Error = error };
+}
