@@ -0,0 +1,46 @@
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+public sealed record PageQuery(int? Page = null, int? PageSize = null, string? OrderBy = null, bool? Descending = null);
+
+public sealed record Page<T>(IReadOnlyList<T> Items, int PageNumber, int PageSize, int TotalCount);
+
+public static class Paging
+{
+    private static bool IsSimple(Type type)
+    {
+        type = Nullable.GetUnderlyingType(type) ?? type;
+        return type.IsPrimitive || type.IsEnum
+            || type == typeof(string) || type == typeof(decimal) || type == typeof(Guid) || type == typeof(DateTime);
+    }
+
+    public static string? ResolveOrderBy(Type entityType, string name) =>
+        entityType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
+            .FirstOrDefault(p => p.SetMethod is { IsPublic: true } && IsSimple(p.PropertyType)
+                && string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))?.Name;
+
+    public static async Task<Result<Page<TDto>>> QueryAsync<TEntity, TDto>(
+        IRepository<TEntity> repository, PageQuery query, Func<TEntity, TDto> map, CancellationToken ct)
+        where TEntity : Entity
+    {
+        var errors = new ValidationErrors();
+        var page = query.Page ?? 1;
+        var pageSize = query.PageSize ?? 50;
+        if (page < 1) errors.Add("page", "The page must be at least 1.");
+        if (pageSize is < 1 or > 200) errors.Add("pageSize", "The page size must be between 1 and 200.");
+        string? orderBy = null;
+        if (!string.IsNullOrWhiteSpace(query.OrderBy))
+        {
+            orderBy = ResolveOrderBy(typeof(TEntity), query.OrderBy);
+            if (orderBy is null) errors.Add("orderBy", $"'{query.OrderBy}' is not a property that can be ordered by.");
+        }
+        if (!errors.IsValid) return errors.ToError();
+
+        var skip = (long)(page - 1) * pageSize;
+        if (skip > int.MaxValue) return new Page<TDto>([], page, pageSize, 0);
+        var (items, total) = await repository.QueryAsync((int)skip, pageSize, orderBy, query.Descending ?? false, ct);
+        return new Page<TDto>(items.Select(map).ToList(), page, pageSize, total);
+    }
+}
