+using Acme.Ticketing.Api.Framework;
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Application.Framework;
+
+namespace Acme.Ticketing.Api;
+
+public static class Endpoints
+{
+    public static void MapTicketing(this IEndpointRouteBuilder app)
+    {
+        var venues = app.MapGroup("/venues").RequireAuthorization();
+        venues.MapGet("/", (VenueService s, int? page, int? pageSize, string? orderBy, bool? descending, CancellationToken ct) =>
+            s.QueryAsync(new PageQuery(page, pageSize, orderBy, descending), ct).ToHttpAsync());
+        venues.MapGet("/{id:guid}", (VenueService s, Guid id, CancellationToken ct) => s.GetAsync(id, ct).ToHttpAsync());
+        venues.MapPost("/", async (VenueService s, VenueInput input, CancellationToken ct) =>
+                (await s.AddAsync(input, ct)).ToHttp(v => Results.Created($"/venues/{v.Id}", v)))
+            .RequireAuthorization(Rights.ManageVenues);
+        venues.MapPut("/{id:guid}", (VenueService s, Guid id, VenueInput input, CancellationToken ct) =>
+                s.UpdateAsync(id, input, ct).ToHttpAsync())
+            .RequireAuthorization(Rights.ManageVenues);
+        venues.MapDelete("/{id:guid}", async (VenueService s, Guid id, CancellationToken ct) =>
+                (await s.RemoveAsync(id, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageVenues);
+
+        var shows = app.MapGroup("/shows").RequireAuthorization();
+        shows.MapGet("/", (ShowService s, int? page, int? pageSize, string? orderBy, bool? descending, CancellationToken ct) =>
+            s.QueryAsync(new PageQuery(page, pageSize, orderBy, descending), ct).ToHttpAsync());
+        shows.MapGet("/{id:guid}", (ShowService s, Guid id, CancellationToken ct) => s.GetAsync(id, ct).ToHttpAsync());
+        shows.MapPost("/", async (ShowService s, ShowInput input, CancellationToken ct) =>
+                (await s.AddAsync(input, ct)).ToHttp(v => Results.Created($"/shows/{v.Id}", v)))
+            .RequireAuthorization(Rights.ManageShows);
+        shows.MapPut("/{id:guid}", (ShowService s, Guid id, ShowInput input, CancellationToken ct) =>
+                s.UpdateAsync(id, input, ct).ToHttpAsync())
+            .RequireAuthorization(Rights.ManageShows);
+        shows.MapDelete("/{id:guid}", async (ShowService s, Guid id, CancellationToken ct) =>
+                (await s.RemoveAsync(id, ct)).ToHttp())
+            .RequireAuthorization(Rights.ManageShows);
+
+        var bookings = app.MapGroup("/bookings").RequireAuthorization(Rights.ManageShows);
+        bookings.MapGet("/", (BookingService s, int? page, int? pageSize, string? orderBy, bool? descending, CancellationToken ct) =>
+            s.QueryAsync(new PageQuery(page, pageSize, orderBy, descending), ct).ToHttpAsync());
+        bookings.MapGet("/{id:guid}", (BookingService s, Guid id, CancellationToken ct) => s.GetAsync(id, ct).ToHttpAsync());
+
+        app.MapPost("/box-office/book", async (BoxOfficeService s, BookInput input, CancellationToken ct) =>
+            (await s.BookAsync(input, ct)).ToHttp()).RequireAuthorization();
+    }
+
+    private static async Task<IResult> ToHttpAsync<T>(this Task<Result<T>> task) => (await task).ToHttp();
+}
