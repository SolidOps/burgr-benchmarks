@@ -0,0 +1,21 @@
+using Acme.Ticketing.Application.Framework;
+
+namespace Acme.Ticketing.Api.Framework;
+
+public static class ResultHttp
+{
+    /// <summary>Maps the outcome of a use case to an HTTP response.</summary>
+    public static IResult ToHttp<T>(this Result<T> result, Func<T, IResult>? success = null) =>
+        result.IsSuccess ? (success ?? (v => Results.Ok(v)))(result.Value) : result.Error!.ToHttp();
+
+    public static IResult ToHttp(this Result result, Func<IResult>? success = null) =>
+        result.IsSuccess ? (success ?? Results.NoContent)() : result.Error!.ToHttp();
+
+    private static IResult ToHttp(this Error error) => error.Kind switch
+    {
+        ErrorKind.NotFound => Results.Problem(error.Message, statusCode: StatusCodes.Status404NotFound),
+        ErrorKind.Conflict => Results.Problem(error.Message, statusCode: StatusCodes.Status409Conflict),
+        ErrorKind.Forbidden => Results.Problem(error.Message, statusCode: StatusCodes.Status403Forbidden),
+        _ => Results.ValidationProblem(error.Details?.ToDictionary(d => d.Key, d => d.Value) ?? []),
+    };
+}
diff --git a/src/Ticketing.Api/Program.cs b/src/Ticketing.Api/Program.cs
new file mode 100644
