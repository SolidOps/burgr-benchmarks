@@ -0,0 +1,23 @@
+using Acme.Ticketing.Application.Framework;
+
+namespace Acme.Ticketing.Api.Endpoints;
+
+public static class Http
+{
+    /// <summary>Maps the outcome of a use case to a response.</summary>
+    public static IResult ToHttp<T>(this Result<T> result, Func<T, IResult>? success = null)
+    {
+        if (result.IsSuccess) return success is null ? Results.Ok(result.Value) : success(result.Value!);
+        var error = result.Error!;
+        return error.Kind switch
+        {
+            ErrorKind.NotFound => Results.Problem(error.Message, statusCode: StatusCodes.Status404NotFound),
+            ErrorKind.Invalid => Results.ValidationProblem(
+                error.Errors!.ToDictionary(e => e.Key, e => e.Value), statusCode: StatusCodes.Status400BadRequest),
+            ErrorKind.Conflict => Results.Problem(error.Message, statusCode: StatusCodes.Status409Conflict),
+            _ => Results.Problem(error.Message, statusCode: StatusCodes.Status403Forbidden),
+        };
+    }
+
+    public static IResult NoContentOr(this Result<Unit> result) => result.ToHttp(_ => Results.NoContent());
+}
