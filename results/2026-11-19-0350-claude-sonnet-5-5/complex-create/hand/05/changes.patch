--- /dev/null
+++ b/src/Ticketing.Application/Venues/Venues.cs
@@ -0,0 +1,122 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Application.Shows;
+using Acme.Ticketing.Domain.Framework;
+using Acme.Ticketing.Domain.Venues;
+
+namespace Acme.Ticketing.Application.Venues;
+
+public sealed record AddressDto(string Street, string City, string PostalCode);
+
+public sealed record VenueDto(Guid Id, string Name, AddressDto Address, int Capacity)
+{
+    public static VenueDto From(Venue v) =>
+        new(v.Id, v.Name, new AddressDto(v.Address.Street, v.Address.City, v.Address.PostalCode), v.Capacity);
+}
+
+public sealed record VenueDetailDto(Guid Id, string Name, AddressDto Address, int Capacity, IReadOnlyList<ShowDto> Shows)
+{
+    public static VenueDetailDto From(Venue v)
+    {
+        var dto = VenueDto.From(v);
+        return new(dto.Id, dto.Name, dto.Address, dto.Capacity, v.Shows.Select(ShowDto.From).ToList());
+    }
+}
+
+public sealed record AddressInput(string? Street, string? City, string? PostalCode);
+
+public sealed record VenueInput(string? Name, AddressInput? Address, int Capacity)
+{
+    public ValidationErrors Validate()
+    {
+        var errors = new ValidationErrors();
+        Text(errors, "name", Name, 100);
+        if (Address is null) errors.Add("address", "The address is required.");
+        else
+        {
+            Text(errors, "address.street", Address.Street, 100);
+            Text(errors, "address.city", Address.City, 50);
+            Text(errors, "address.postalCode", Address.PostalCode, 10);
+        }
+        if (Capacity < 0) errors.Add("capacity", "The capacity cannot be negative.");
+        return errors;
+    }
+
+    private static void Text(ValidationErrors errors, string path, string? value, int max)
+    {
+        if (string.IsNullOrWhiteSpace(value)) errors.Add(path, "This value is required.");
+        else if (value.Length > max) errors.Add(path, $"At most {max} characters.");
+    }
+}
+
+public sealed class VenueService(IVenueRepository venues, IUnitOfWork unitOfWork)
+{
+    public async Task<Result<PagedResult<VenueDto>>> QueryAsync(
+        int page, int pageSize, string? orderBy, bool descending, CancellationToken ct = default)
+    {
+        var query = Paging.Validate<Venue>(page, pageSize, orderBy, descending);
+        if (!query.IsSuccess) return query.Error!;
+        var result = await venues.PageAsync(query.Value!, ct);
+        return PagedResult<Venue>.From(result).Map(VenueDto.From);
+    }
+
+    public async Task<Result<VenueDetailDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        return venue is null ? NotFound(id) : VenueDetailDto.From(venue);
+    }
+
+    public async Task<Result<VenueDto>> AddAsync(VenueInput input, CancellationToken ct = default)
+    {
+        var errors = input.Validate();
+        if (errors.Any) return errors.ToError();
+        if (await venues.NameExistsAsync(input.Name!, null, ct)) return NameTaken(input.Name!);
+
+        var venue = new Venue();
+        Apply(venue, input);
+        venues.Add(venue);
+        return await CommitAsync(venue, ct);
+    }
+
+    public async Task<Result<VenueDto>> UpdateAsync(Guid id, VenueInput input, CancellationToken ct = default)
+    {
+        var venue = await venues.GetWithShowsAsync(id, ct);
+        if (venue is null) return NotFound(id);
+        var errors = input.Validate();
+        if (errors.Any) return errors.ToError();
+
+        var biggest = venue.Shows.Select(s => s.TicketTiers.Sum(t => t.Quota)).DefaultIfEmpty(0).Max();
+        if (input.Capacity < biggest)
+            return Error.Invalid("capacity", $"A show of this venue already has {biggest} tickets in its tiers.");
+        if (await venues.NameExistsAsync(input.Name!, id, ct)) return NameTaken(input.Name!);
+
+        Apply(venue, input);
+        return await CommitAsync(venue, ct);
+    }
+
+    public async Task<Result<Unit>> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var venue = await venues.GetAsync(id, ct);
+        if (venue is null) return NotFound(id);
+        if (await venues.HasShowsAsync(id, ct)) return Error.Conflict("The venue still has shows.");
+
+        venues.Remove(venue);
+        var error = await Commit.TryAsync(unitOfWork, ct);
+        return error is null ? Unit.Value : error;
+    }
+
+    private async Task<Result<VenueDto>> CommitAsync(Venue venue, CancellationToken ct)
+    {
+        var error = await Commit.TryAsync(unitOfWork, ct);
+        return error is null ? VenueDto.From(venue) : error;
+    }
+
+    private static void Apply(Venue venue, VenueInput input)
+    {
+        venue.Name = input.Name!;
+        venue.Address = new Address(input.Address!.Street!, input.Address.City!, input.Address.PostalCode!);
+        venue.Capacity = input.Capacity;
+    }
+
+    private static Error NotFound(Guid id) => Error.NotFound($"Venue {id} was not found.");
+    private static Error NameTaken(string name) => Error.Conflict($"A venue named '{name}' already exists.");
+}
