+using System.Net;
+using System.Text.Json;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class ShowTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var venue = await CreateVenue();
+        var starts = new DateTime(2099, 5, 1, 20, 0, 0, DateTimeKind.Utc);
+        var (created, body) = await Post("/shows", ShowBody(venue, [Tier("VIP", 99.5m, 10)], 0, starts));
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var id = body.GetProperty("id").GetGuid();
+        Assert.AreEqual(0, body.GetProperty("status").GetInt32());
+        Assert.AreEqual(venue, body.GetProperty("venueId").GetGuid());
+        Assert.AreEqual(starts, body.GetProperty("startsAt").GetDateTime().ToUniversalTime());
+
+        var (_, got) = await Get($"/shows/{id}");
+        Assert.IsFalse(got.GetProperty("isSoldOut").GetBoolean());
+        var tier = got.GetProperty("ticketTiers")[0];
+        Assert.AreEqual("VIP", tier.GetProperty("name").GetString());
+        Assert.AreEqual(99.5m, tier.GetProperty("price").GetDecimal());
+        Assert.AreEqual(0, tier.GetProperty("sold").GetInt32());
+        Assert.AreNotEqual(Guid.Empty, tier.GetProperty("id").GetGuid());
+
+        var (updated, upd) = await Put($"/shows/{id}", ShowBody(venue, [], 2, starts, "Renamed"));
+        Assert.AreEqual(HttpStatusCode.OK, updated.StatusCode);
+        Assert.AreEqual("Renamed", upd.GetProperty("title").GetString());
+        Assert.AreEqual(0, upd.GetProperty("ticketTiers").GetArrayLength());
+
+        var (_, page) = await Get("/shows?orderBy=Title");
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/shows/{id}")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/shows/{id}")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TiersAreAddedUpdatedAndRemoved()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue, [Tier("A", quota: 10), Tier("B", quota: 10)]);
+        var id = show.GetProperty("id").GetGuid();
+        var a = show.GetProperty("ticketTiers").EnumerateArray().First(t => t.GetProperty("name").GetString() == "A");
+        var aId = a.GetProperty("id").GetGuid();
+        var bId = show.GetProperty("ticketTiers").EnumerateArray().First(t => t.GetProperty("name").GetString() == "B").GetProperty("id").GetGuid();
+
+        var (r, upd) = await Put($"/shows/{id}", ShowBody(venue, [Tier("A2", 5, 15, aId), Tier("C", 7, 3)]));
+        Assert.AreEqual(HttpStatusCode.OK, r.StatusCode, upd.ToString());
+        var tiers = upd.GetProperty("ticketTiers").EnumerateArray().ToList();
+        Assert.AreEqual(2, tiers.Count);
+        Assert.IsTrue(tiers.Any(t => t.GetProperty("id").GetGuid() == aId && t.GetProperty("name").GetString() == "A2" && t.GetProperty("quota").GetInt32() == 15));
+        Assert.IsTrue(tiers.Any(t => t.GetProperty("name").GetString() == "C" && t.GetProperty("id").GetGuid() != Guid.Empty));
+        Assert.IsFalse(tiers.Any(t => t.GetProperty("id").GetGuid() == bId));
+
+        var (_, got) = await Get($"/shows/{id}");
+        Assert.AreEqual(2, got.GetProperty("ticketTiers").GetArrayLength());
+    }
+
+    [TestMethod]
+    public async Task SoldIsIgnoredAndTierIdMustBelongToShow()
+    {
+        var venue = await CreateVenue();
+        var (_, body) = await Post("/shows", ShowBody(venue, [new { name = "A", price = 1, quota = 5, sold = 4 }]));
+        Assert.AreEqual(0, body.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+
+        var id = body.GetProperty("id").GetGuid();
+        var (r, _) = await Put($"/shows/{id}", ShowBody(venue, [Tier("A", id: Guid.NewGuid())]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, r.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TiersCannotExceedVenueCapacity()
+    {
+        var venue = await CreateVenue(capacity: 30);
+        var (r, b) = await Post("/shows", ShowBody(venue, [Tier("A", quota: 20), Tier("B", quota: 11)]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, r.StatusCode);
+        Assert.IsTrue(b.GetProperty("errors").TryGetProperty("ticketTiers", out _));
+        Assert.AreEqual(HttpStatusCode.Created, (await Post("/shows", ShowBody(venue, [Tier("A", quota: 20), Tier("B", quota: 10)]))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task InvalidBodies()
+    {
+        var venue = await CreateVenue();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(Guid.NewGuid()))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(venue, status: 7))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(venue, title: new string('x', 201)))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", ShowBody(venue, title: ""))).Response.StatusCode);
+        var (r, b) = await Post("/shows", ShowBody(venue, [Tier(new string('n', 51))]));
+        Assert.AreEqual(HttpStatusCode.BadRequest, r.StatusCode);
+        Assert.IsTrue(b.GetProperty("errors").TryGetProperty("ticketTiers[0].name", out _));
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/shows", new { title = "x", venueId = venue, startsAt = DateTime.UtcNow, status = "OnSale" })).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task IsSoldOutWhenEveryTierIsSoldOut()
+    {
+        var venue = await CreateVenue();
+        var empty = await CreateShow(venue, []);
+        Assert.IsFalse((await Get($"/shows/{empty.GetProperty("id").GetGuid()}")).Body.GetProperty("isSoldOut").GetBoolean());
+
+        var show = await CreateShow(venue, [Tier("A", quota: 2), Tier("B", quota: 1)]);
+        var id = show.GetProperty("id").GetGuid();
+        await Post("/box-office/book", Booking(id, "A", 2));
+        Assert.IsFalse((await Get($"/shows/{id}")).Body.GetProperty("isSoldOut").GetBoolean());
+        await Post("/box-office/book", Booking(id, "B", 1));
+        Assert.IsTrue((await Get($"/shows/{id}")).Body.GetProperty("isSoldOut").GetBoolean());
+    }
+
+    [TestMethod]
+    public async Task ShowWithBookingsCannotBeDeleted()
+    {
+        var venue = await CreateVenue();
+        var id = (await CreateShow(venue)).GetProperty("id").GetGuid();
+        Assert.AreEqual(HttpStatusCode.OK, (await Post("/box-office/book", Booking(id))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Delete($"/shows/{id}")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task SoldTicketsAreKeptOnUpdateAndQuotaCannotGoBelowSold()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue, [Tier("A", quota: 10)]);
+        var id = show.GetProperty("id").GetGuid();
+        var tierId = show.GetProperty("ticketTiers")[0].GetProperty("id").GetGuid();
+        await Post("/box-office/book", Booking(id, "A", 5));
+
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Put($"/shows/{id}", ShowBody(venue, [Tier("A", quota: 4, id: tierId)]))).Response.StatusCode);
+        var (r, b) = await Put($"/shows/{id}", ShowBody(venue, [Tier("A", quota: 8, id: tierId)]));
+        Assert.AreEqual(HttpStatusCode.OK, r.StatusCode);
+        Assert.AreEqual(5, b.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+    }
+
+    [TestMethod]
+    public async Task UnknownIdIsNotFound()
+    {
+        var venue = await CreateVenue();
+        var id = Guid.NewGuid();
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/shows/{id}")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Put($"/shows/{id}", ShowBody(venue))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Delete($"/shows/{id}")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task PagingOrdersByStartsAtAndStatus()
+    {
+        var venue = await CreateVenue();
+        await CreateShow(venue, [], 1, DateTime.UtcNow.AddDays(3));
+        await CreateShow(venue, [], 0, DateTime.UtcNow.AddDays(1));
+        await CreateShow(venue, [], 2, DateTime.UtcNow.AddDays(2));
+        var (_, page) = await Get("/shows?orderBy=StartsAt");
+        CollectionAssert.AreEqual(new[] { 0, 2, 1 }, page.GetProperty("items").EnumerateArray().Select(i => i.GetProperty("status").GetInt32()).ToArray());
+        var (_, page2) = await Get("/shows?orderBy=Status&descending=true&pageSize=1");
+        Assert.AreEqual(2, page2.GetProperty("items")[0].GetProperty("status").GetInt32());
+        Assert.AreEqual(3, page2.GetProperty("totalCount").GetInt32());
+    }
+}
