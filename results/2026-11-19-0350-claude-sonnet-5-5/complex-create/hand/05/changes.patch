+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+public sealed record PagedResult<T>(IReadOnlyList<T> Items, int PageNumber, int PageSize, int TotalCount)
+{
+    public PagedResult<TOut> Map<TOut>(Func<T, TOut> map) =>
+        new(Items.Select(map).ToList(), PageNumber, PageSize, TotalCount);
+
+    public static PagedResult<T> From(PagedList<T> list) =>
+        new(list.Items, list.PageNumber, list.PageSize, list.TotalCount);
+}
+
+public static class Paging
+{
+    public const int MaxPageSize = 200;
+
+    /// <summary>Validates the paging parameters of a query on entities of type <typeparamref name="TEntity"/>.</summary>
+    public static Result<PageQuery> Validate<TEntity>(int page, int pageSize, string? orderBy, bool descending)
+    {
+        var errors = new ValidationErrors();
+        if (page < 1) errors.Add("page", "The page must be at least 1.");
+        if (pageSize is < 1 or > MaxPageSize) errors.Add("pageSize", $"The page size must be between 1 and {MaxPageSize}.");
+        if (!string.IsNullOrWhiteSpace(orderBy) && SortableProperties.Resolve(typeof(TEntity), orderBy) is null)
+            errors.Add("orderBy", $"Cannot order by '{orderBy}'.");
+        return errors.Any
+            ? errors.ToError()
+            : new PageQuery(page, pageSize, string.IsNullOrWhiteSpace(orderBy) ? null : orderBy, descending);
+    }
+}
