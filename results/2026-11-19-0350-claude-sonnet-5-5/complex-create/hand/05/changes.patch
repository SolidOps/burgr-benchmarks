+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Framework;
+using Acme.Ticketing.Domain.Shows;
+
+namespace Acme.Ticketing.Application.Bookings;
+
+public sealed record BookingDto(Guid Id, Guid ShowId, string Tier, string CustomerEmail, int Quantity, decimal TotalPrice)
+{
+    public static BookingDto From(Booking b) => new(b.Id, b.ShowId, b.Tier, b.CustomerEmail, b.Quantity, b.TotalPrice);
+}
+
+public sealed record BookingInput(Guid ShowId, string? Tier, string? CustomerEmail, int Quantity)
+{
+    public ValidationErrors Validate()
+    {
+        var errors = new ValidationErrors();
+        if (Quantity is < 1 or > 10) errors.Add("quantity", "The quantity must be between 1 and 10.");
+        if (string.IsNullOrWhiteSpace(CustomerEmail) || !CustomerEmail.Contains('@'))
+            errors.Add("customerEmail", "A valid email is required.");
+        return errors;
+    }
+}
+
+/// <summary>Read side of the bookings.</summary>
+public sealed class BookingService(IBookingRepository bookings)
+{
+    public async Task<Result<PagedResult<BookingDto>>> QueryAsync(
+        int page, int pageSize, string? orderBy, bool descending, CancellationToken ct = default)
+    {
+        var query = Paging.Validate<Booking>(page, pageSize, orderBy, descending);
+        if (!query.IsSuccess) return query.Error!;
+        var result = await bookings.PageAsync(query.Value!, ct);
+        return PagedResult<Booking>.From(result).Map(BookingDto.From);
+    }
+
+    public async Task<Result<BookingDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var booking = await bookings.GetAsync(id, ct);
+        return booking is null ? Error.NotFound($"Booking {id} was not found.") : BookingDto.From(booking);
+    }
+}
+
+/// <summary>The box office: the only way to create bookings.</summary>
+public sealed class BoxOfficeService(
+    IShowRepository shows, IBookingRepository bookings, IUnitOfWork unitOfWork, TimeProvider clock)
+{
+    public async Task<Result<BookingDto>> BookAsync(BookingInput input, CancellationToken ct = default)
+    {
+        var errors = input.Validate();
+        if (errors.Any) return errors.ToError();
+
+        var show = await shows.GetAsync(input.ShowId, ct);
+        if (show is null) return Error.NotFound($"Show {input.ShowId} was not found.");
+        if (show.Status != ShowStatus.OnSale) return Error.Conflict("The show is not on sale.");
+        if (show.StartsAt <= clock.GetUtcNow().UtcDateTime) return Error.Conflict("The show has already started.");
+
+        var tier = show.TicketTiers.FirstOrDefault(t => t.Name == input.Tier);
+        if (tier is null) return Error.Invalid("tier", "The show has no tier with that name.");
+        if (tier.Remaining < input.Quantity)
+            return Error.Conflict($"Only {Math.Max(tier.Remaining, 0)} tickets are left in this tier.");
+
+        tier.Sold += input.Quantity;
+        var booking = new Booking
+        {
+            ShowId = show.Id,
+            Tier = tier.Name,
+            CustomerEmail = input.CustomerEmail!,
+            Quantity = input.Quantity,
+            TotalPrice = tier.Price * input.Quantity,
+        };
+        bookings.Add(booking);
+
+        var error = await Commit.TryAsync(unitOfWork, ct);
+        return error is null ? BookingDto.From(booking) : error;
+    }
+}
