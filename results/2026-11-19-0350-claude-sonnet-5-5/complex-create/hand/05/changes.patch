+using System.Net;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class VenueTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task RoundTrip()
+    {
+        var (created, body) = await Post("/venues", VenueBody("Opera", 120));
+        Assert.AreEqual(HttpStatusCode.Created, created.StatusCode);
+        var id = body.GetProperty("id").GetGuid();
+        Assert.AreEqual("Paris", body.GetProperty("address").GetProperty("city").GetString());
+
+        var (_, got) = await Get($"/venues/{id}");
+        Assert.AreEqual("Opera", got.GetProperty("name").GetString());
+        Assert.AreEqual(0, got.GetProperty("shows").GetArrayLength());
+
+        var (updated, upd) = await Put($"/venues/{id}", VenueBody("Opera 2", 150));
+        Assert.AreEqual(HttpStatusCode.OK, updated.StatusCode);
+        Assert.AreEqual(150, upd.GetProperty("capacity").GetInt32());
+
+        var (list, page) = await Get("/venues");
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(1, page.GetProperty("pageNumber").GetInt32());
+        Assert.AreEqual(50, page.GetProperty("pageSize").GetInt32());
+        Assert.AreEqual("Opera 2", page.GetProperty("items")[0].GetProperty("name").GetString());
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Delete($"/venues/{id}")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/venues/{id}")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task GetIncludesShows()
+    {
+        var venue = await CreateVenue();
+        var show = await CreateShow(venue);
+        var (_, got) = await Get($"/venues/{venue}");
+        Assert.AreEqual(show.GetProperty("id").GetGuid(), got.GetProperty("shows")[0].GetProperty("id").GetGuid());
+    }
+
+    [TestMethod]
+    public async Task InvalidBodyIsBadRequestWithPaths()
+    {
