new file mode 100644
index 0000000..3416303
--- /dev/null
+++ b/src/Ticketing.Application/Shows/Shows.cs
@@ -0,0 +1,166 @@
+using Acme.Ticketing.Application.Framework;
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Framework;
+using Acme.Ticketing.Domain.Shows;
+using Acme.Ticketing.Domain.Venues;
+
+namespace Acme.Ticketing.Application.Shows;
+
+public sealed record TicketTierDto(Guid Id, string Name, decimal Price, int Quota, int Sold)
+{
+    public static TicketTierDto From(TicketTier t) => new(t.Id, t.Name, t.Price, t.Quota, t.Sold);
+}
+
+public sealed record ShowDto(
+    Guid Id, string Title, DateTime StartsAt, ShowStatus Status, Guid VenueId,
+    IReadOnlyList<TicketTierDto> TicketTiers, bool IsSoldOut)
+{
+    public static ShowDto From(Show s) =>
+        new(s.Id, s.Title, s.StartsAt, s.Status, s.VenueId, s.TicketTiers.Select(TicketTierDto.From).ToList(), s.IsSoldOut());
+}
+
+/// <summary>A tier of a show; without <c>Id</c> it is added, with one it is updated. <c>sold</c> is not an input.</summary>
+public sealed record TicketTierInput(Guid? Id, string? Name, decimal Price, int Quota);
+
+public sealed record ShowInput(
+    string? Title, DateTime? StartsAt, ShowStatus Status, Guid? VenueId, List<TicketTierInput?>? TicketTiers)
+{
+    public ValidationErrors Validate()
+    {
+        var errors = new ValidationErrors();
+        if (string.IsNullOrWhiteSpace(Title)) errors.Add("title", "This value is required.");
+        else if (Title.Length > 200) errors.Add("title", "At most 200 characters.");
+        if (StartsAt is null) errors.Add("startsAt", "This value is required.");
+        if (!Enum.IsDefined(Status)) errors.Add("status", "Unknown status.");
+        if (VenueId is null || VenueId == Guid.Empty) errors.Add("venueId", "This value is required.");
+
+        var names = new HashSet<string>();
+        var ids = new HashSet<Guid>();
+        for (var i = 0; i < (TicketTiers?.Count ?? 0); i++)
+        {
+            var tier = TicketTiers![i];
+            var path = $"ticketTiers[{i}]";
+            if (tier is null) { errors.Add(path, "The tier is required."); continue; }
+            if (string.IsNullOrWhiteSpace(tier.Name)) errors.Add($"{path}.name", "This value is required.");
+            else if (tier.Name.Length > 50) errors.Add($"{path}.name", "At most 50 characters.");
+            else if (!names.Add(tier.Name)) errors.Add($"{path}.name", "Tier names must be unique within a show.");
+            if (tier.Price < 0) errors.Add($"{path}.price", "The price cannot be negative.");
+            if (tier.Quota < 0) errors.Add($"{path}.quota", "The quota cannot be negative.");
+            if (tier.Id is { } id && !ids.Add(id)) errors.Add($"{path}.id", "Duplicate tier id.");
+        }
+        return errors;
+    }
+}
+
+public sealed class ShowService(
+    IShowRepository shows, IVenueRepository venues, IBookingRepository bookings, IUnitOfWork unitOfWork)
+{
+    public async Task<Result<PagedResult<ShowDto>>> QueryAsync(
+        int page, int pageSize, string? orderBy, bool descending, CancellationToken ct = default)
+    {
+        var query = Paging.Validate<Show>(page, pageSize, orderBy, descending);
+        if (!query.IsSuccess) return query.Error!;
+        var result = await shows.PageAsync(query.Value!, ct);
+        return PagedResult<Show>.From(result).Map(ShowDto.From);
+    }
+
+    public async Task<Result<ShowDto>> GetAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        return show is null ? NotFound(id) : ShowDto.From(show);
+    }
+
+    public async Task<Result<ShowDto>> AddAsync(ShowInput input, CancellationToken ct = default)
+    {
+        var show = new Show();
+        var error = await ApplyAsync(show, input, ct);
+        if (error is not null) return error;
+        shows.Add(show);
+        return await CommitAsync(show, ct);
+    }
+
+    public async Task<Result<ShowDto>> UpdateAsync(Guid id, ShowInput input, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return NotFound(id);
+        var error = await ApplyAsync(show, input, ct);
+        if (error is not null) return error;
+        return await CommitAsync(show, ct);
+    }
+
+    public async Task<Result<Unit>> RemoveAsync(Guid id, CancellationToken ct = default)
+    {
+        var show = await shows.GetAsync(id, ct);
+        if (show is null) return NotFound(id);
+        if (await bookings.ExistsForShowAsync(id, ct)) return Error.Conflict("The show has bookings.");
+
+        shows.Remove(show); // its tiers are deleted with it
+        var error = await Commit.TryAsync(unitOfWork, ct);
+        return error is null ? Unit.Value : error;
+    }
+
+    private async Task<Result<ShowDto>> CommitAsync(Show show, CancellationToken ct)
+    {
+        var error = await Commit.TryAsync(unitOfWork, ct);
+        return error is null ? ShowDto.From(show) : error;
+    }
+
+    /// <summary>Validates the input against the venue and the existing tiers, then applies it to the show.</summary>
+    private async Task<Error?> ApplyAsync(Show show, ShowInput input, CancellationToken ct)
+    {
+        var errors = input.Validate();
+        var tiers = input.TicketTiers ?? [];
+
+        Venue? venue = null;
+        if (input.VenueId is { } venueId && venueId != Guid.Empty)
+        {
+            venue = await venues.GetAsync(venueId, ct);
+            if (venue is null) errors.Add("venueId", "The venue does not exist.");
+        }
+
+        var existing = show.TicketTiers.ToDictionary(t => t.Id);
+        for (var i = 0; i < tiers.Count; i++)
+        {
+            var tier = tiers[i];
+            if (tier is null) continue;
+            if (tier.Id is { } tierId)
+            {
+                if (!existing.TryGetValue(tierId, out var current))
+                    errors.Add($"ticketTiers[{i}].id", "The tier does not belong to this show.");
+                else if (tier.Quota < current.Sold)
+                    errors.Add($"ticketTiers[{i}].quota", $"{current.Sold} tickets are already sold.");
+            }
+        }
+
+        if (venue is not null && tiers.Where(t => t is not null).Sum(t => (long)t!.Quota) > venue.Capacity)
+            errors.Add("ticketTiers", $"The quotas exceed the capacity of the venue ({venue.Capacity}).");
+
+        if (errors.Any) return errors.ToError();
+
+        show.Title = input.Title!;
+        show.StartsAt = input.StartsAt!.Value.ToUniversalTime();
+        show.Status = input.Status;
+        show.VenueId = venue!.Id;
+
+        var kept = new HashSet<Guid>();
+        foreach (var tier in tiers.Select(t => t!))
+        {
+            if (tier.Id is { } id)
+            {
+                var current = existing[id];
+                current.Name = tier.Name!;
+                current.Price = tier.Price;
+                current.Quota = tier.Quota;
+                kept.Add(id);
+            }
+            else
+            {
+                show.TicketTiers.Add(new TicketTier { Name = tier.Name!, Price = tier.Price, Quota = tier.Quota });
+            }
+        }
+        show.TicketTiers.RemoveAll(t => existing.ContainsKey(t.Id) && !kept.Contains(t.Id));
+        return null;
+    }
+
+    private static Error NotFound(Guid id) => Error.NotFound($"Show {id} was not found.");
+}
diff --git a/src/Ticketing.Application/Venues/Venues.cs b/src/Ticketing.Application/Venues/Venues.cs
new file mode 100644
