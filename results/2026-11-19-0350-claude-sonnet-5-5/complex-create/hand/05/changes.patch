@@ -0,0 +1,63 @@
+using System.Net;
+using System.Net.Http.Headers;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class SecurityTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task EveryEndpointRequiresAToken()
+    {
+        Anonymous();
+        var id = Guid.NewGuid();
+        foreach (var url in new[] { "/venues", $"/venues/{id}", "/shows", $"/shows/{id}", "/bookings", $"/bookings/{id}" })
+            Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get(url)).Response.StatusCode, url);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Post("/venues", VenueBody())).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Post("/box-office/book", Booking(id))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task BadTokensAreRejected()
+    {
+        foreach (var token in new[]
+        {
+            Token(["*"], key: "another-key"),
+            Token(["*"], expires: DateTime.UtcNow.AddSeconds(-5)),
+            "garbage",
+        })
+        {
+            Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
+            Assert.AreEqual(HttpStatusCode.Unauthorized, (await Get("/venues")).Response.StatusCode);
+        }
+    }
+
+    [TestMethod]
+    public async Task AnyAuthenticatedCallerCanReadAndBook()
+    {
+        Authenticate();
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/venues")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/shows")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Post("/box-office/book", Booking(Guid.NewGuid()))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task BookingsRequireManageShows()
+    {
+        Authenticate("ManageVenues");
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Get("/bookings")).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Get($"/bookings/{Guid.NewGuid()}")).Response.StatusCode);
+        Authenticate("ManageShows");
+        Assert.AreEqual(HttpStatusCode.OK, (await Get("/bookings")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ShowWritesRequireManageShows()
+    {
+        Authenticate("ManageVenues");
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Post("/shows", ShowBody(Guid.NewGuid()))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Put($"/shows/{Guid.NewGuid()}", ShowBody(Guid.NewGuid()))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Delete($"/shows/{Guid.NewGuid()}")).Response.StatusCode);
+    }
+}
