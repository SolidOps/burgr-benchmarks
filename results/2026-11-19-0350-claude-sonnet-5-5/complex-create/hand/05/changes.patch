@@ -0,0 +1,54 @@
+using System.Linq.Expressions;
+using System.Reflection;
+using Acme.Ticketing.Domain.Framework;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure.Framework;
+
+public abstract class Repository<T>(TicketingDbContext db) : IRepository<T> where T : Entity
+{
+    protected TicketingDbContext Db { get; } = db;
+
+    protected IQueryable<T> Set => Include(Db.Set<T>());
+
+    /// <summary>Related data loaded with every entity.</summary>
+    protected virtual IQueryable<T> Include(IQueryable<T> query) => query;
+
+    public Task<T?> GetAsync(Guid id, CancellationToken ct = default) =>
+        Set.FirstOrDefaultAsync(e => e.Id == id, ct);
+
+    public async Task<PagedList<T>> PageAsync(PageQuery query, CancellationToken ct = default)
+    {
+        var total = await Db.Set<T>().CountAsync(ct);
+        var ordered = Order(Set, query.OrderBy, query.Descending);
+        var items = await ordered.Skip((query.Page - 1) * query.PageSize).Take(query.PageSize).ToListAsync(ct);
+        return new PagedList<T>(items, query.Page, query.PageSize, total);
+    }
+
+    public void Add(T entity) => Db.Set<T>().Add(entity);
+
+    public void Remove(T entity) => Db.Set<T>().Remove(entity);
+
+    private static IOrderedQueryable<T> Order(IQueryable<T> query, string? orderBy, bool descending)
+    {
+        var property = orderBy is null ? null : SortableProperties.Resolve(typeof(T), orderBy);
+        // The id as a last key keeps the pages stable.
+        if (property is null || property.Name == nameof(Entity.Id))
+            return descending ? query.OrderByDescending(e => e.Id) : query.OrderBy(e => e.Id);
+
+        var parameter = Expression.Parameter(typeof(T), "e");
+        Expression key = Expression.Property(parameter, property);
+        // SQLite cannot order decimals natively.
+        if ((Nullable.GetUnderlyingType(key.Type) ?? key.Type) == typeof(decimal))
+            key = Expression.Convert(key, key.Type == typeof(decimal) ? typeof(double) : typeof(double?));
+        var lambda = Expression.Lambda(key, parameter);
+
+        var method = typeof(Queryable)
+            .GetMethods(BindingFlags.Public | BindingFlags.Static)
+            .First(m => m.Name == (descending ? nameof(Queryable.OrderByDescending) : nameof(Queryable.OrderBy))
+                        && m.GetParameters().Length == 2)
+            .MakeGenericMethod(typeof(T), key.Type);
+        var ordered = (IOrderedQueryable<T>)method.Invoke(null, [query, lambda])!;
+        return descending ? ordered.ThenByDescending(e => e.Id) : ordered.ThenBy(e => e.Id);
+    }
+}
