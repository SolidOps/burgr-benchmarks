+using Acme.Ticketing.Domain.Framework;
+
+namespace Acme.Ticketing.Application.Framework;
+
+internal static class Commit
+{
+    /// <summary>Commits the unit of work; a violated constraint becomes a conflict.</summary>
+    public static async Task<Error?> TryAsync(IUnitOfWork unitOfWork, CancellationToken ct)
+    {
+        try
+        {
+            await unitOfWork.CommitAsync(ct);
+            return null;
+        }
+        catch (DataConflictException e)
+        {
+            return Error.Conflict(e.Message);
+        }
+    }
+}
