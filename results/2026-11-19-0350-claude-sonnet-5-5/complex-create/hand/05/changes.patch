+using System.Net;
+using Acme.Ticketing.Tests.Framework;
+
+namespace Acme.Ticketing.Tests;
+
+[TestClass]
+public class BoxOfficeTests : ApiTestBase
+{
+    private async Task<Guid> OnSaleShow(int quota = 10, decimal price = 12.5m)
+    {
+        var venue = await CreateVenue();
+        return (await CreateShow(venue, [Tier("Standard", price, quota)])).GetProperty("id").GetGuid();
+    }
+
+    [TestMethod]
+    public async Task BookingUpdatesSoldAndIsReadable()
+    {
+        var show = await OnSaleShow(price: 12.5m);
+        var (r, b) = await Post("/box-office/book", Booking(show, "Standard", 3, "x@y.z"));
+        Assert.AreEqual(HttpStatusCode.OK, r.StatusCode, b.ToString());
+        Assert.AreEqual(37.5m, b.GetProperty("totalPrice").GetDecimal());
+        Assert.AreEqual("Standard", b.GetProperty("tier").GetString());
+        Assert.AreEqual(show, b.GetProperty("showId").GetGuid());
+        var id = b.GetProperty("id").GetGuid();
+
+        Assert.AreEqual(3, (await Get($"/shows/{show}")).Body.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+        var (_, got) = await Get($"/bookings/{id}");
+        Assert.AreEqual("x@y.z", got.GetProperty("customerEmail").GetString());
+        var (_, page) = await Get("/bookings?orderBy=TotalPrice&descending=true");
+        Assert.AreEqual(1, page.GetProperty("totalCount").GetInt32());
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Get($"/bookings/{Guid.NewGuid()}")).Response.StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(0)]
+    [DataRow(11)]
+    [DataRow(-1)]
+    public async Task QuantityOutOfRange(int quantity)
+    {
+        var show = await OnSaleShow();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/box-office/book", Booking(show, quantity: quantity))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task EmailWithoutAtIsBadRequest()
+    {
+        var show = await OnSaleShow();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/box-office/book", Booking(show, email: "nope"))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ValidationComesBeforeLookup()
+    {
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/box-office/book", Booking(Guid.NewGuid(), quantity: 0))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Post("/box-office/book", Booking(Guid.NewGuid()))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    [DataRow(0)]
+    [DataRow(2)]
+    public async Task ShowMustBeOnSale(int status)
+    {
+        var venue = await CreateVenue();
+        var show = (await CreateShow(venue, null, status)).GetProperty("id").GetGuid();
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Post("/box-office/book", Booking(show))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ShowMustNotHaveStarted()
+    {
+        var venue = await CreateVenue();
+        var show = (await CreateShow(venue, null, 1, DateTime.UtcNow.AddHours(-1))).GetProperty("id").GetGuid();
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Post("/box-office/book", Booking(show))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task UnknownTierIsBadRequestAfterStatusChecks()
+    {
+        var show = await OnSaleShow();
+        Assert.AreEqual(HttpStatusCode.BadRequest, (await Post("/box-office/book", Booking(show, "Nope"))).Response.StatusCode);
+
+        var venue = await CreateVenue("Other");
+        var draft = (await CreateShow(venue, null, 0)).GetProperty("id").GetGuid();
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Post("/box-office/book", Booking(draft, "Nope"))).Response.StatusCode);
+    }
+
+    [TestMethod]
+    public async Task CannotBookMoreThanLeft()
+    {
+        var show = await OnSaleShow(quota: 5);
+        Assert.AreEqual(HttpStatusCode.OK, (await Post("/box-office/book", Booking(show, quantity: 4))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Post("/box-office/book", Booking(show, quantity: 2))).Response.StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Post("/box-office/book", Booking(show, quantity: 1))).Response.StatusCode);
+
+        Assert.AreEqual(5, (await Get($"/shows/{show}")).Body.GetProperty("ticketTiers")[0].GetProperty("sold").GetInt32());
+        Assert.AreEqual(2, (await Get("/bookings")).Body.GetProperty("totalCount").GetInt32());
+    }
+}
diff --git a/src/Ticketing.Tests/Framework/ApiTestBase.cs b/src/Ticketing.Tests/Framework/ApiTestBase.cs
new file mode 100644
index 0000000..9ce153d
--- /dev/null
+++ b/src/Ticketing.Tests/Framework/ApiTestBase.cs
@@ -0,0 +1,116 @@
+using System.Net.Http.Headers;
+using System.Net.Http.Json;
+using System.Security.Claims;
+using System.Text.Json;
+using Acme.Ticketing.Api.Security;
+using Microsoft.AspNetCore.Mvc.Testing;
+using Microsoft.Data.Sqlite;
+using Microsoft.IdentityModel.JsonWebTokens;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Tests.Framework;
+
+/// <summary>Each test gets its own application and its own throw-away SQLite database.</summary>
+public abstract class ApiTestBase
+{
+    protected const string JwtKey = "test-key";
+    private WebApplicationFactory<Program> _factory = null!;
+    private string _dbPath = null!;
+
+    protected HttpClient Client { get; private set; } = null!;
+
+    protected static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);
+
+    [TestInitialize]
+    public void StartApi()
+    {
+        _dbPath = Path.Combine(Path.GetTempPath(), $"ticketing-{Guid.NewGuid():N}.db");
+        _factory = new WebApplicationFactory<Program>().WithWebHostBuilder(b =>
+        {
+            b.UseSetting("ConnectionStrings:Ticketing", $"Data Source={_dbPath}");
+            b.UseSetting("Jwt:Key", JwtKey);
+        });
+        Client = _factory.CreateClient();
+        Authenticate("*");
+    }
+
+    [TestCleanup]
+    public void StopApi()
+    {
+        Client.Dispose();
+        _factory.Dispose();
+        SqliteConnection.ClearAllPools();
+        foreach (var f in Directory.GetFiles(Path.GetTempPath(), Path.GetFileName(_dbPath) + "*")) File.Delete(f);
+    }
+
+    protected static string Token(string[] rights, DateTime? expires = null, string key = JwtKey)
+    {
+        var claims = new ClaimsIdentity(rights.Select(r => new Claim(Authentication.RightClaim, r)));
+        claims.AddClaim(new Claim("sub", "tester"));
+        return new JsonWebTokenHandler().CreateToken(new SecurityTokenDescriptor
+        {
+            Subject = claims,
+            NotBefore = DateTime.UtcNow.AddMinutes(-10),
+            Expires = expires ?? DateTime.UtcNow.AddHours(1),
+            SigningCredentials = new SigningCredentials(
+                new SymmetricSecurityKey(Authentication.SigningKeyBytes(key)), SecurityAlgorithms.HmacSha256),
+        });
+    }
+
+    protected void Authenticate(params string[] rights) =>
+        Client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Token(rights));
+
+    protected void Anonymous() => Client.DefaultRequestHeaders.Authorization = null;
+
+    protected async Task<(HttpResponseMessage Response, JsonElement Body)> Send(
+        HttpMethod method, string url, object? body = null)
+    {
+        var response = await Client.SendAsync(new HttpRequestMessage(method, url)
+        {
+            Content = body is null ? null : JsonContent.Create(body, options: Json),
+        });
+        var text = await response.Content.ReadAsStringAsync();
+        var json = default(JsonElement); // error bodies may be plain text (e.g. an unbindable parameter)
+        if (response.Content.Headers.ContentType?.MediaType?.EndsWith("json") == true)
+            json = JsonDocument.Parse(text).RootElement.Clone();
+        return (response, json);
+    }
+
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Get(string url) => Send(HttpMethod.Get, url);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Post(string url, object body) => Send(HttpMethod.Post, url, body);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Put(string url, object body) => Send(HttpMethod.Put, url, body);
+    protected Task<(HttpResponseMessage Response, JsonElement Body)> Delete(string url) => Send(HttpMethod.Delete, url);
+
+    // --- fixtures ---
+
+    protected static object VenueBody(string name = "Opera", int capacity = 100) => new
+    {
+        name, capacity, address = new { street = "1 Main St", city = "Paris", postalCode = "75001" },
+    };
+
+    protected async Task<Guid> CreateVenue(string name = "Opera", int capacity = 100)
+    {
+        var (r, b) = await Post("/venues", VenueBody(name, capacity));
+        Assert.AreEqual(System.Net.HttpStatusCode.Created, r.StatusCode);
+        return b.GetProperty("id").GetGuid();
+    }
+
+    protected static object ShowBody(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null,
+        string title = "Carmen") => new
+    {
+        title, status, venueId, startsAt = startsAt ?? DateTime.UtcNow.AddDays(30), ticketTiers = tiers ?? [],
+    };
+
+    protected static object Tier(string name = "Standard", decimal price = 10, int quota = 20, Guid? id = null) =>
+        new { id, name, price, quota };
+
+    protected async Task<JsonElement> CreateShow(Guid venueId, object[]? tiers = null, int status = 1, DateTime? startsAt = null)
+    {
+        var (r, b) = await Post("/shows", ShowBody(venueId, tiers ?? [Tier()], status, startsAt));
+        Assert.AreEqual(System.Net.HttpStatusCode.Created, r.StatusCode, b.ToString());
+        return b;
+    }
+
+    protected static object Booking(Guid showId, string tier = "Standard", int quantity = 2, string email = "a@b.c") =>
+        new { showId, tier, customerEmail = email, quantity };
+}
