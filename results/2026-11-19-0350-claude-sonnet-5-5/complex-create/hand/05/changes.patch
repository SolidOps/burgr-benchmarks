+using Acme.Ticketing.Api.Endpoints;
+using Acme.Ticketing.Api.Security;
+using Acme.Ticketing.Application;
+using Acme.Ticketing.Infrastructure;
+using Microsoft.EntityFrameworkCore;
+
+var builder = WebApplication.CreateBuilder(args);
+
+builder.Services.AddTicketingSecurity();
+builder.Services.AddTicketingApplication();
+builder.Services.AddTicketingInfrastructure((sp, options) =>
+{
+    var connectionString = sp.GetRequiredService<IConfiguration>().GetConnectionString("Ticketing")
+        ?? throw new InvalidOperationException("ConnectionStrings:Ticketing is not configured.");
+    options.UseSqlite(connectionString);
+});
+
+var app = builder.Build();
+
+using (var scope = app.Services.CreateScope())
+    scope.ServiceProvider.GetRequiredService<TicketingDbContext>().Database.EnsureCreated();
+
+app.UseAuthentication();
+app.UseAuthorization();
+app.MapTicketing();
+
+app.Run();
+
+public partial class Program;
diff --git a/src/Ticketing.Api/Security/Authentication.cs b/src/Ticketing.Api/Security/Authentication.cs
new file mode 100644
index 0000000..5192749
--- /dev/null
+++ b/src/Ticketing.Api/Security/Authentication.cs
@@ -0,0 +1,55 @@
+using System.Text;
+using Acme.Ticketing.Application.Framework;
+using Microsoft.AspNetCore.Authentication.JwtBearer;
+using Microsoft.IdentityModel.Tokens;
+
+namespace Acme.Ticketing.Api.Security;
+
+public static class Authentication
+{
+    public const string RightClaim = "right";
+
+    /// <summary>The UTF-8 bytes of the key, right-padded with spaces to 32 bytes.</summary>
+    public static byte[] SigningKeyBytes(string key)
+    {
+        var bytes = Encoding.UTF8.GetBytes(key);
+        if (bytes.Length >= 32) return bytes;
+        var padded = new byte[32];
+        Array.Fill(padded, (byte)' ');
+        bytes.CopyTo(padded, 0);
+        return padded;
+    }
+
+    public static IServiceCollection AddTicketingSecurity(this IServiceCollection services)
+    {
+        services.AddAuthentication(JwtBearerDefaults.AuthenticationScheme).AddJwtBearer();
+        services.AddOptions<JwtBearerOptions>(JwtBearerDefaults.AuthenticationScheme)
+            .Configure<IConfiguration>((options, configuration) =>
+            {
+                var key = configuration["Jwt:Key"] ?? throw new InvalidOperationException("Jwt:Key is not configured.");
+                options.MapInboundClaims = false;
+                options.TokenValidationParameters = new TokenValidationParameters
+                {
+                    ValidateIssuerSigningKey = true,
+                    IssuerSigningKey = new SymmetricSecurityKey(SigningKeyBytes(key)),
+                    ValidAlgorithms = [SecurityAlgorithms.HmacSha256],
+                    RequireSignedTokens = true,
+                    ValidateIssuer = false,
+                    ValidateAudience = false,
+                    ValidateLifetime = true,
+                    ClockSkew = TimeSpan.Zero,
+                };
+            });
+
+        services.AddAuthorizationBuilder()
+            .SetFallbackPolicy(new Microsoft.AspNetCore.Authorization.AuthorizationPolicyBuilder()
+                .RequireAuthenticatedUser().Build())
+            .AddPolicy(Rights.ManageVenues, p => RequireRight(p, Rights.ManageVenues))
+            .AddPolicy(Rights.ManageShows, p => RequireRight(p, Rights.ManageShows));
+        return services;
+    }
+
+    private static void RequireRight(Microsoft.AspNetCore.Authorization.AuthorizationPolicyBuilder policy, string right) =>
+        policy.RequireAuthenticatedUser().RequireAssertion(ctx =>
+            ctx.User.HasClaim(c => c.Type == RightClaim && (c.Value == right || c.Value == Rights.All)));
+}
