diff --git a/src/Ticketing.Infrastructure/TicketingDbContext.cs b/src/Ticketing.Infrastructure/TicketingDbContext.cs
new file mode 100644
index 0000000..a1d0db0
--- /dev/null
+++ b/src/Ticketing.Infrastructure/TicketingDbContext.cs
@@ -0,0 +1,65 @@
+using Acme.Ticketing.Domain.Bookings;
+using Acme.Ticketing.Domain.Shows;
+using Acme.Ticketing.Domain.Venues;
+using Microsoft.EntityFrameworkCore;
+
+namespace Acme.Ticketing.Infrastructure;
+
+public sealed class TicketingDbContext(DbContextOptions<TicketingDbContext> options) : DbContext(options)
+{
+    public DbSet<Venue> Venues => Set<Venue>();
+    public DbSet<Show> Shows => Set<Show>();
+    public DbSet<Booking> Bookings => Set<Booking>();
+
+    protected override void ConfigureConventions(ModelConfigurationBuilder builder)
+    {
+        // Dates are UTC in and out.
+        builder.Properties<DateTime>().HaveConversion<UtcDateTimeConverter>();
+    }
+
+    protected override void OnModelCreating(ModelBuilder model)
+    {
+        model.Entity<Venue>(b =>
+        {
+            b.Property(v => v.Id).ValueGeneratedNever();
+            b.Property(v => v.Name).HasMaxLength(100).IsRequired();
+            b.HasIndex(v => v.Name).IsUnique();
+            b.OwnsOne(v => v.Address, a => a.ToJson());
+            b.Navigation(v => v.Address).IsRequired();
+            b.HasMany(v => v.Shows).WithOne(s => s.Venue).HasForeignKey(s => s.VenueId)
+                .OnDelete(DeleteBehavior.Restrict);
+        });
+
+        model.Entity<Show>(b =>
+        {
+            b.Property(s => s.Id).ValueGeneratedNever();
+            b.Property(s => s.Title).HasMaxLength(200).IsRequired();
+            b.HasMany(s => s.TicketTiers).WithOne().HasForeignKey(t => t.ShowId)
+                .OnDelete(DeleteBehavior.Cascade);
+        });
+
+        model.Entity<TicketTier>(b =>
+        {
+            b.Property(t => t.Id).ValueGeneratedNever();
+            b.Property(t => t.Name).HasMaxLength(50).IsRequired();
+            b.Property(t => t.Sold).IsConcurrencyToken(); // two bookings of the same tier cannot oversell
+            b.Ignore(t => t.Remaining);
+        });
+
+        model.Entity<Booking>(b =>
+        {
+            b.Property(x => x.Id).ValueGeneratedNever();
+            b.Property(x => x.Tier).HasMaxLength(50).IsRequired();
+            b.Property(x => x.CustomerEmail).IsRequired();
+            b.HasOne<Show>().WithMany().HasForeignKey(x => x.ShowId).OnDelete(DeleteBehavior.Restrict);
+        });
+    }
+}
+
+internal sealed class UtcDateTimeConverter : Microsoft.EntityFrameworkCore.Storage.ValueConversion.ValueConverter<DateTime, DateTime>
+{
+    public UtcDateTimeConverter()
+        : base(v => v.ToUniversalTime(), v => DateTime.SpecifyKind(v, DateTimeKind.Utc))
+    {
+    }
+}
