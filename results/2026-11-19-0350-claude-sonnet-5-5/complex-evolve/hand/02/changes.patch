@@ -0,0 +1,194 @@
+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrudWithItsMembers()
+    {
+        await NewUserAsync("ada@example.com");
+        await NewUserAsync("bob@example.com");
+        await NewUserAsync("eve@example.com");
+        var created = await PostAsync<TeamDto>("/teams", Team("core", Member("ada@example.com", true), Member("bob@example.com", false)));
+        Assert.HasCount(2, created.Members);
+        Assert.AreNotEqual(Guid.Empty, created.Members[0].Id);
+
+        var ada = created.Members.Single(m => m.UserEmail == "ada@example.com");
+        var update = Team("core2", Member("bob@example.com", true, created.Members.Single(m => m.UserEmail == "bob@example.com").Id), Member("eve@example.com", false));
+        var response = await Client.PutAsJsonAsync($"/teams/{created.Id}", update);
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
+
+        var read = (await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}"))!;
+        Assert.AreEqual("core2", read.Name);
+        CollectionAssert.AreEquivalent(new[] { "bob@example.com", "eve@example.com" }, read.Members.Select(m => m.UserEmail).ToArray());
+        Assert.IsTrue(read.Members.Single(m => m.UserEmail == "bob@example.com").IsOwner);
+        Assert.IsFalse(read.Members.Any(m => m.Id == ada.Id));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", Team("core2"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        var team = await PostAsync<TeamDto>("/teams", Team("empty"));
+        Assert.IsEmpty(team.Members);
+    }
+
+    [TestMethod]
+    public async Task TeamsArePaged()
+    {
+        await NewUserAsync("ada@example.com");
+        await PostAsync<TeamDto>("/teams", Team("b", Member("ada@example.com", true)));
+        await PostAsync<TeamDto>("/teams", Team("a"));
+        await PostAsync<TeamDto>("/teams", Team("c"));
+
+        var page = (await Client.GetFromJsonAsync<Page<TeamDto>>("/teams?page=1&pageSize=2&orderBy=Name"))!;
+
+        Assert.AreEqual(3, page.TotalCount);
+        CollectionAssert.AreEqual(new[] { "a", "b" }, page.Items.Select(t => t.Name).ToArray());
+        Assert.HasCount(1, page.Items[1].Members);
+        await AssertInvalidAsync(await Client.GetAsync("/teams?orderBy=Nope"), "orderBy");
+    }
+
+    [TestMethod]
+    public async Task NameIsRequiredAndAtMost50Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("")), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team(new string('x', 51))), "Name");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", Team(new string('x', 50)))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task DescriptionIsAtMost200Characters()
+    {
+        var team = Team("t");
+        team.Description = new string('x', 201);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", team), "Description");
+        team.Description = new string('x', 200);
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", team)).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameMustBeUnique()
+    {
+        await PostAsync<TeamDto>("/teams", Team("dup"));
+        var other = await PostAsync<TeamDto>("/teams", Team("other"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", Team("dup"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PutAsJsonAsync($"/teams/{other.Id}", Team("dup"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{other.Id}", Team("other"))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustMatchAUser()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", Member("ghost@example.com", true))), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", Member("", true))), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", Member(new string('x', 51), true))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailAppearsOnceInATeam()
+    {
+        await NewUserAsync("ada@example.com");
+        var response = await Client.PostAsJsonAsync("/teams", Team("t", Member("ada@example.com", true), Member("ada@example.com", false)));
+        await AssertInvalidAsync(response, "Members[1].UserEmail");
+
+        await PostAsync<TeamDto>("/teams", Team("t1", Member("ada@example.com", true)));
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", Team("t2", Member("ada@example.com", true)))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersHasExactlyOneOwner()
+    {
+        await NewUserAsync("ada@example.com");
+        await NewUserAsync("bob@example.com");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", Member("ada@example.com", false))), "Members");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", Member("ada@example.com", true), Member("bob@example.com", true))), "Members");
+
+        var team = await PostAsync<TeamDto>("/teams", Team("t", Member("ada@example.com", true), Member("bob@example.com", false)));
+        var removeOwner = Team("t", Member("bob@example.com", false, team.Members.Single(m => m.UserEmail == "bob@example.com").Id));
+        await AssertInvalidAsync(await Client.PutAsJsonAsync($"/teams/{team.Id}", removeOwner), "Members");
+    }
+
+    [TestMethod]
+    public async Task OwnerCanBeTransferredAndAMemberReAddedInOneUpdate()
