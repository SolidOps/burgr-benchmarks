+using Microsoft.EntityFrameworkCore;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Infrastructure;
+
+public sealed class TeamRepository(UMDbContext db) : EfRepository<Team>(db), ITeamRepository
+{
+    protected override IQueryable<Team> WithDetails(IQueryable<Team> query) => query.Include(x => x.Members);
+
+    protected override IQueryable<Team> WithPageDetails(IQueryable<Team> query) => query.Include(x => x.Members);
+
+    public async Task<HashSet<string>> FindExistingUserEmailsAsync(IEnumerable<string> emails, CancellationToken cancellationToken = default)
+    {
+        var wanted = emails.ToList();
+        var found = await Db.Users.Where(u => wanted.Contains(u.Email)).Select(u => u.Email).ToListAsync(cancellationToken);
+        return found.ToHashSet(StringComparer.Ordinal);
+    }
+}
+
+public partial class UMDbContext
+{
+    public DbSet<Team> Teams => Set<Team>();
+
+    public DbSet<Member> Members => Set<Member>();
+
+    private static void ConfigureTeams(ModelBuilder modelBuilder)
+    {
+        modelBuilder.Entity<Team>(builder =>
+        {
+            builder.HasKey(x => x.Id);
+            builder.Property(x => x.Name).HasMaxLength(50);
+            builder.Property(x => x.Description).HasMaxLength(200);
+            builder.HasIndex(x => x.Name).IsUnique();
+            builder.HasMany(x => x.Members).WithOne(x => x.Team).HasForeignKey(x => x.TeamId);
+        });
+
+        modelBuilder.Entity<Member>(builder =>
+        {
+            builder.HasKey(x => x.Id);
+            builder.Property(x => x.UserEmail).HasMaxLength(50);
+            builder.HasIndex(x => new { x.TeamId, x.UserEmail }).IsUnique();
+        });
+    }
+}
