+using SolidOps.UM.Application;
+
+namespace SolidOps.UM.Api;
+
+public static partial class UMEndpoints
+{
+    private static void MapTeamEndpoints(RouteGroupBuilder group)
+    {
+        group.MapGet("/", async (int? page, int? pageSize, string? orderBy, bool? descending, TeamService service, CancellationToken cancellationToken) =>
+            (await service.QueryAsync(HttpResults.ToPageRequest(page, pageSize, orderBy, descending), cancellationToken)).ToHttpResult())
+            .RequireRight("");
+
+        group.MapGet("/{id}", async (Guid id, TeamService service, CancellationToken cancellationToken) =>
+            (await service.GetAsync(id, cancellationToken)).ToHttpResult())
+            .RequireRight("");
+
+        group.MapPost("/", async (TeamInput input, TeamService service, CancellationToken cancellationToken) =>
+            (await service.AddAsync(input, cancellationToken)).ToCreatedHttpResult(dto => $"/teams/{dto.Id}"))
+            .RequireRight(UMRights.ManageTeams);
+
+        group.MapPut("/{id}", async (Guid id, TeamInput input, TeamService service, CancellationToken cancellationToken) =>
+            (await service.UpdateAsync(id, input, cancellationToken)).ToHttpResult())
+            .RequireRight(UMRights.ManageTeams);
+
+        group.MapDelete("/{id}", async (Guid id, TeamService service, CancellationToken cancellationToken) =>
+            (await service.RemoveAsync(id, cancellationToken)).ToHttpResult())
+            .RequireRight(UMRights.ManageTeams);
+    }
+}
