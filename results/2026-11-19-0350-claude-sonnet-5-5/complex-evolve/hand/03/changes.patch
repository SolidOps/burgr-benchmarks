+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrud()
+    {
+        await AddUsersAsync("ada@example.com", "bob@example.com");
+
+        var created = await PostAsync<TeamDto>("/teams", NewTeam("Core", Member("ada@example.com", true)));
+        Assert.AreEqual("Core", created.Name);
+        Assert.HasCount(1, created.Members);
+        Assert.AreNotEqual(Guid.Empty, created.Members[0].Id);
+
+        var update = NewTeam("Core2", new MemberInput { Id = created.Members[0].Id, UserEmail = "ada@example.com", IsOwner = true }, Member("bob@example.com", false));
+        update.Description = "The core team";
+        var updateResponse = await Client.PutAsJsonAsync($"/teams/{created.Id}", update);
+        Assert.AreEqual(HttpStatusCode.OK, updateResponse.StatusCode, await updateResponse.Content.ReadAsStringAsync());
+        var updated = (await updateResponse.Content.ReadFromJsonAsync<TeamDto>())!;
+        Assert.AreEqual("Core2", updated.Name);
+        Assert.HasCount(2, updated.Members);
+        Assert.AreEqual(created.Members[0].Id, updated.Members.Single(m => m.IsOwner).Id);
+
+        var read = await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}");
+        Assert.AreEqual("The core team", read!.Description);
+        Assert.HasCount(2, read.Members);
+
+        var page = await Client.GetFromJsonAsync<Page<TeamDto>>("/teams");
+        Assert.AreEqual(1, page!.TotalCount);
+        Assert.HasCount(2, page.Items[0].Members);
+
+        // members must be removed before the team
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", NewTeam("Core2"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Empty"));
+
+        Assert.IsEmpty(team.Members);
+    }
+
+    [TestMethod]
+    public async Task MembersAreAddedUpdatedAndRemovedByTheList()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com", "c@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("T", Member("a@example.com", true), Member("b@example.com", false)));
+        var a = team.Members.Single(m => m.UserEmail == "a@example.com");
+        var b = team.Members.Single(m => m.UserEmail == "b@example.com");
+
+        // b is removed, a kept, c added; a keeps its Id
+        var response = await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("T",
+            new MemberInput { Id = a.Id, UserEmail = "a@example.com", IsOwner = true }, Member("c@example.com", false)));
+        var updated = (await response.Content.ReadFromJsonAsync<TeamDto>())!;
+
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode);
+        CollectionAssert.AreEquivalent(new[] { "a@example.com", "c@example.com" }, updated.Members.Select(m => m.UserEmail).ToArray());
+        Assert.IsTrue(updated.Members.Any(m => m.Id == a.Id));
+        Assert.IsFalse(updated.Members.Any(m => m.Id == b.Id));
+    }
+
+    [TestMethod]
+    public async Task OwnershipCanMoveAndAMemberCanBeReplacedByTheSameEmail()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("T", Member("a@example.com", true), Member("b@example.com", false)));
+        var a = team.Members.Single(m => m.UserEmail == "a@example.com");
+        var b = team.Members.Single(m => m.UserEmail == "b@example.com");
+
+        var moved = await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("T",
+            new MemberInput { Id = a.Id, UserEmail = "a@example.com", IsOwner = false },
+            new MemberInput { Id = b.Id, UserEmail = "b@example.com", IsOwner = true }));
+        Assert.AreEqual(HttpStatusCode.OK, moved.StatusCode, await moved.Content.ReadAsStringAsync());
+
+        // a removed and re-added in the same request
+        var replaced = await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("T",
+            Member("a@example.com", false),
+            new MemberInput { Id = b.Id, UserEmail = "b@example.com", IsOwner = true }));
+        Assert.AreEqual(HttpStatusCode.OK, replaced.StatusCode, await replaced.Content.ReadAsStringAsync());
+    }
+
+    [TestMethod]
+    public async Task UnknownTeamIsNotFound()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{UnknownId}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{UnknownId}", NewTeam("X"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{UnknownId}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameIsRequiredAndAtMost50Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("")), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam(new string('x', 51))), "Name");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", NewTeam(new string('x', 50)))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task DescriptionIsAtMost200Characters()
+    {
+        var tooLong = NewTeam("A");
+        tooLong.Description = new string('x', 201);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", tooLong), "Description");
+
+        var fine = NewTeam("B");
+        fine.Description = new string('x', 200);
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", fine)).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task MemberEmailIsRequiredAtMost50CharactersAndOfAnExistingUser()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("A", Member("", true))), "Members[0].UserEmail");
+
+        var longEmail = new string('x', 45) + "@e.com";
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("B", Member(longEmail, true))), "Members[0].UserEmail");
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("C", Member("nobody@example.com", true))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task SameEmailCannotAppearTwiceInATeamButCanInTwoTeams()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com");
+
