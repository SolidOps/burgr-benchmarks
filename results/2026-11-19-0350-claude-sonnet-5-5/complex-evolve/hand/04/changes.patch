+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrud()
+    {
+        await AddUsersAsync("ada@example.com", "bob@example.com");
+        var created = await PostAsync<TeamDto>("/teams", NewTeam("Core", "ada@example.com", "bob@example.com"));
+        Assert.AreEqual("Core", created.Name);
+        Assert.HasCount(2, created.Members);
+        Assert.IsTrue(created.Members.All(m => m.Id != Guid.Empty));
+
+        var update = NewTeam("Core 2", "ada@example.com");
+        update.Description = "The core team";
+        update.Members![0]!.Id = created.Members.Single(m => m.UserEmail == "ada@example.com").Id;
+        var response = await Client.PutAsJsonAsync($"/teams/{created.Id}", update);
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode);
+        var updated = (await response.Content.ReadFromJsonAsync<TeamDto>())!;
+        Assert.AreEqual("The core team", updated.Description);
+
+        var read = (await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}"))!;
+        Assert.AreEqual("Core 2", read.Name);
+        Assert.AreEqual("ada@example.com", read.Members.Single().UserEmail);
+
+        update.Members = [];
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", update)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Empty"));
+
+        Assert.IsEmpty(team.Members);
+    }
+
+    [TestMethod]
+    public async Task MembersAreSynchronizedByTheUpdate()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com", "c@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Sync", "a@example.com", "b@example.com"));
+        var a = team.Members.Single(m => m.UserEmail == "a@example.com");
+
+        var input = NewTeam("Sync", "a@example.com", "c@example.com");
+        input.Members![0]!.Id = a.Id;
+        input.Members[0]!.IsOwner = false;
+        input.Members[1]!.IsOwner = true;
+        var updated = (await (await Client.PutAsJsonAsync($"/teams/{team.Id}", input)).Content.ReadFromJsonAsync<TeamDto>())!;
+
+        Assert.HasCount(2, updated.Members);
+        Assert.AreEqual(a.Id, updated.Members.Single(m => m.UserEmail == "a@example.com").Id);
+        Assert.IsFalse(updated.Members.Single(m => m.UserEmail == "a@example.com").IsOwner);
+        Assert.IsTrue(updated.Members.Single(m => m.UserEmail == "c@example.com").IsOwner);
+        Assert.IsFalse(updated.Members.Any(m => m.UserEmail == "b@example.com"));
+        var read = (await Client.GetFromJsonAsync<TeamDto>($"/teams/{team.Id}"))!;
+        Assert.HasCount(2, read.Members);
+    }
+
+    [TestMethod]
+    public async Task NameIsRequiredAndLimited()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("")), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam(new string('x', 51))), "Name");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", NewTeam(new string('x', 50)))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task DescriptionIsLimited()
+    {
+        var team = NewTeam("Desc");
+        team.Description = new string('x', 201);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", team), "Description");
+        team.Description = new string('x', 200);
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", team)).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task MemberEmailIsRequiredAndLimited()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("T1", "")), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("T2", new string('x', 51))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustMatchAUser()
+    {
+        var response = await Client.PostAsJsonAsync("/teams", NewTeam("Ghosts", "nobody@example.com"));
+
+        await AssertInvalidAsync(response, "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task SameEmailTwiceIsInvalid()
+    {
+        await AddUsersAsync("ada@example.com");
+        var input = NewTeam("Twice", "ada@example.com", "ada@example.com");
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", input), "Members[1].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersNeedsExactlyOneOwner()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com");
+
+        var none = NewTeam("NoOwner", "a@example.com", "b@example.com");
+        none.Members!.ForEach(m => m!.IsOwner = false);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", none), "Members");
+
+        var two = NewTeam("TwoOwners", "a@example.com", "b@example.com");
+        two.Members!.ForEach(m => m!.IsOwner = true);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", two), "Members");
+
+        var created = await PostAsync<TeamDto>("/teams", NewTeam("Owned", "a@example.com", "b@example.com"));
+        await AssertInvalidAsync(await Client.PutAsJsonAsync($"/teams/{created.Id}", none), "Members");
+    }
+
+    [TestMethod]
+    public async Task UpdatingAMemberOfAnotherTeamIsInvalid()
+    {
+        await AddUsersAsync("a@example.com", "b@example.com");
+        var first = await PostAsync<TeamDto>("/teams", NewTeam("First", "a@example.com"));
+        var second = await PostAsync<TeamDto>("/teams", NewTeam("Second", "b@example.com"));
+        var input = NewTeam("Second", "b@example.com");
+        input.Members![0]!.Id = first.Members[0].Id;
+
+        await AssertInvalidAsync(await Client.PutAsJsonAsync($"/teams/{second.Id}", input), "Members[0].Id");
+    }
+
+    [TestMethod]
+    public async Task SameUserCanBelongToSeveralTeams()
+    {
+        await AddUsersAsync("ada@example.com");
+        await PostAsync<TeamDto>("/teams", NewTeam("One", "ada@example.com"));
+        await PostAsync<TeamDto>("/teams", NewTeam("Two", "ada@example.com"));
+    }
+
+    [TestMethod]
+    public async Task NameMustBeUnique()
+    {
+        await PostAsync<TeamDto>("/teams", NewTeam("Same"));
+        var other = await PostAsync<TeamDto>("/teams", NewTeam("Other"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", NewTeam("Same"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PutAsJsonAsync($"/teams/{other.Id}", NewTeam("Same"))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersCannotBeDeleted()
+    {
+        await AddUsersAsync("ada@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Full", "ada@example.com"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task UnknownTeamIsNotFound()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{UnknownId}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{UnknownId}", NewTeam("X"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{UnknownId}")).StatusCode);
+    }
+
+    [TestMethod]
