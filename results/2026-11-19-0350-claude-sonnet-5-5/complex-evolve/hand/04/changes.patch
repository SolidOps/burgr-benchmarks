+    [TestMethod]
+    public async Task WritingRequiresManageTeams()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Guarded"));
+
+        AuthenticateAs(UMRights.ManageUsers);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.PostAsJsonAsync("/teams", NewTeam("New"))).StatusCode);
