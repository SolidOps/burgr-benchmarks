+    /// <summary>A team whose first member is the owner.</summary>
+    private static TeamInput Team(string name, params string[] emails) => new()
+    {
+        Name = name,
+        Members = emails.Select((email, i) => new TeamMemberInput { UserEmail = email, IsOwner = i == 0 }).ToList(),
+    };
