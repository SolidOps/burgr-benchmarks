@@ -0,0 +1,245 @@
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Application;
+
+public sealed class TeamMemberDto
+{
+    public Guid Id { get; set; }
+
+    public string UserEmail { get; set; } = string.Empty;
+
+    public bool IsOwner { get; set; }
+
+    public static TeamMemberDto From(TeamMember entity) => new() { Id = entity.Id, UserEmail = entity.UserEmail, IsOwner = entity.IsOwner };
+}
+
+public sealed class TeamDto
+{
+    /// <summary>The values accepted by the orderBy parameter of the query.</summary>
+    public static readonly IReadOnlyCollection<string> SortableProperties = ["Id", "Name", "Description"];
+
+    public Guid Id { get; set; }
+
+    public string Name { get; set; } = string.Empty;
+
+    public string? Description { get; set; }
+
+    public List<TeamMemberDto> Members { get; set; } = [];
+
+    public static TeamDto From(Team entity) => new()
+    {
+        Id = entity.Id,
+        Name = entity.Name,
+        Description = entity.Description,
+        Members = entity.Members.Select(TeamMemberDto.From).ToList(),
+    };
+}
+
+public sealed class TeamMemberInput
+{
+    /// <summary>The member to update; null for a new member.</summary>
+    public Guid? Id { get; set; }
+
+    public string UserEmail { get; set; } = string.Empty;
+
+    public bool IsOwner { get; set; }
+
+    public Dictionary<string, string[]> Validate()
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (string.IsNullOrWhiteSpace(UserEmail))
+        {
+            errors["UserEmail"] = ["UserEmail is required"];
+        }
+        else if (UserEmail.Length > 50)
+        {
+            errors["UserEmail"] = ["UserEmail is longer than 50 characters"];
+        }
+        return errors;
+    }
+}
+
+public sealed class TeamInput
+{
+    public string Name { get; set; } = string.Empty;
+
+    public string? Description { get; set; }
+
+    /// <summary>The whole list: a member without Id is added, a member missing from the list is removed.</summary>
+    public List<TeamMemberInput> Members { get; set; } = [];
+
+    /// <summary>The rules of the input alone; the existence of the users and of the members to update is checked by the service.</summary>
+    public Dictionary<string, string[]> Validate()
+    {
+        var errors = new Dictionary<string, string[]>();
+        if (string.IsNullOrWhiteSpace(Name))
+        {
+            errors["Name"] = ["Name is required"];
+        }
+        else if (Name.Length > 50)
+        {
+            errors["Name"] = ["Name is longer than 50 characters"];
+        }
+        if (Description?.Length > 200)
+        {
+            errors["Description"] = ["Description is longer than 200 characters"];
+        }
+
+        var members = Members ?? [];
+        for (var i = 0; i < members.Count; i++)
+        {
+            if (members[i] is null)
+            {
+                errors[$"Members[{i}]"] = ["The member is required"];
+                continue;
+            }
+            foreach (var (key, messages) in members[i].Validate())
+            {
+                errors[$"Members[{i}].{key}"] = messages;
+            }
+        }
+
+        var valid = members.Where(m => m is not null).ToList();
+        for (var i = 0; i < members.Count; i++)
+        {
+            if (members[i] is { UserEmail.Length: > 0 } member
+                && members.Take(i).Any(other => other is not null && other.UserEmail == member.UserEmail))
+            {
+                errors[$"Members[{i}].UserEmail"] = ["The user is already a member of the team"];
+            }
+            if (members[i]?.Id is { } id && members.Take(i).Any(other => other?.Id == id))
+            {
+                errors[$"Members[{i}].Id"] = ["The member is listed twice"];
+            }
+        }
+        if (valid.Count > 0 && valid.Count(m => m.IsOwner) != 1)
+        {
+            errors["Members"] = ["A team with members has exactly one owner"];
+        }
+        return errors;
+    }
+
+    /// <summary>Applies the input to a team already validated against its members.</summary>
+    public void ApplyTo(Team entity)
+    {
+        entity.Name = Name;
+        entity.Description = Description;
+
+        var inputs = Members ?? [];
+        entity.Members.RemoveAll(member => !inputs.Exists(input => input.Id == member.Id));
+        foreach (var input in inputs)
+        {
+            var member = input.Id is { } id ? entity.Members.Find(m => m.Id == id) : null;
+            if (member is null)
+            {
+                member = new TeamMember();
+                entity.Members.Add(member);
+            }
+            member.UserEmail = input.UserEmail;
+            member.IsOwner = input.IsOwner;
+        }
+    }
+}
+
+public sealed class TeamService(
+    ITeamRepository repository,
+    IUserRepository userRepository,
+    IUnitOfWork unitOfWork)
+{
+    public async Task<Result<Page<TeamDto>>> QueryAsync(PageRequest request, CancellationToken cancellationToken = default)
+    {
+        var errors = Paging.Validate(request, TeamDto.SortableProperties);
+        if (errors.Count > 0)
+        {
+            return Error.Invalid(errors);
+        }
+        var page = await repository.QueryAsync(request, cancellationToken);
+        return page.Map(TeamDto.From);
+    }
+
+    public async Task<Result<TeamDto>> GetAsync(Guid id, CancellationToken cancellationToken = default)
+    {
+        var aggregate = await repository.FindAsync(id, cancellationToken);
+        return aggregate is null ? Error.NotFound() : TeamDto.From(aggregate);
+    }
+
+    public async Task<Result<TeamDto>> AddAsync(TeamInput input, CancellationToken cancellationToken = default)
+    {
+        var errors = await ValidateAsync(input, null, cancellationToken);
+        if (errors.Count > 0)
+        {
+            return Error.Invalid(errors);
+        }
+        var aggregate = new Team();
+        input.ApplyTo(aggregate);
+
+        repository.Add(aggregate);
+        if (await unitOfWork.SaveChangesAsync(cancellationToken) is { } error)
+        {
+            return error;
+        }
+        return TeamDto.From(aggregate);
+    }
+
+    public async Task<Result<TeamDto>> UpdateAsync(Guid id, TeamInput input, CancellationToken cancellationToken = default)
+    {
+        var aggregate = await repository.FindAsync(id, cancellationToken);
+        if (aggregate is null)
+        {
+            return Error.NotFound();
+        }
+        var errors = await ValidateAsync(input, aggregate, cancellationToken);
+        if (errors.Count > 0)
+        {
+            return Error.Invalid(errors);
+        }
+        input.ApplyTo(aggregate);
+
+        if (await unitOfWork.SaveChangesAsync(cancellationToken) is { } error)
+        {
+            return error;
+        }
+        return TeamDto.From(aggregate);
+    }
+
+    public async Task<Result> RemoveAsync(Guid id, CancellationToken cancellationToken = default)
+    {
+        var aggregate = await repository.FindAsync(id, cancellationToken);
+        if (aggregate is null)
+        {
+            return Error.NotFound();
+        }
+        if (aggregate.Members.Count > 0)
+        {
+            return Error.Conflict("The team still has members");
+        }
+
+        repository.Remove(aggregate);
+        return await unitOfWork.SaveChangesAsync(cancellationToken) is { } error ? error : Result.Success();
+    }
+
+    // the input's own rules, then the users and the members it references
+    private async Task<Dictionary<string, string[]>> ValidateAsync(TeamInput input, Team? existing, CancellationToken cancellationToken)
+    {
+        var errors = input.Validate();
+        var members = input.Members ?? [];
+        for (var i = 0; i < members.Count; i++)
+        {
+            var member = members[i];
+            if (member is null)
+            {
+                continue;
+            }
+            if (member.Id is { } id && (existing is null || !existing.Members.Exists(m => m.Id == id)))
+            {
+                errors[$"Members[{i}].Id"] = ["Member not found in the team"];
+            }
+            if (!errors.ContainsKey($"Members[{i}].UserEmail")
+                && await userRepository.FindByEmailAsync(member.UserEmail, cancellationToken) is null)
+            {
+                errors[$"Members[{i}].UserEmail"] = ["User not found"];
+            }
+        }
+        return errors;
+    }
+}
