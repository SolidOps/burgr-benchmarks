+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeRoundTrip()
+    {
+        await AddUsersAsync("ada@example.com", "bob@example.com", "cy@example.com");
+        var created = await PostAsync<TeamDto>("/teams", Team("core", "ada@example.com", "bob@example.com"));
+        Assert.AreEqual("core", created.Name);
+        Assert.HasCount(2, created.Members);
+        Assert.IsTrue(created.Members.All(m => m.Id != Guid.Empty));
+
+        var ada = created.Members.Single(m => m.UserEmail == "ada@example.com");
+        var update = new TeamInput
+        {
+            Name = "core2",
+            Description = "The core team",
+            Members =
+            [
+                new() { Id = ada.Id, UserEmail = "ada@example.com", IsOwner = false },
+                new() { UserEmail = "cy@example.com", IsOwner = true },
+            ],
+        };
+        var response = await Client.PutAsJsonAsync($"/teams/{created.Id}", update);
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
+
+        var read = (await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}"))!;
+        Assert.AreEqual("core2", read.Name);
+        Assert.AreEqual("The core team", read.Description);
+        Assert.HasCount(2, read.Members);
+        Assert.AreEqual(ada.Id, read.Members.Single(m => m.UserEmail == "ada@example.com").Id);
+        Assert.IsFalse(read.Members.Single(m => m.UserEmail == "ada@example.com").IsOwner);
+        Assert.IsTrue(read.Members.Single(m => m.UserEmail == "cy@example.com").IsOwner);
+        Assert.IsFalse(read.Members.Any(m => m.UserEmail == "bob@example.com"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+
+        var empty = new TeamInput { Name = "core2" };
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", empty)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        var created = await PostAsync<TeamDto>("/teams", new TeamInput { Name = "empty" });
+
+        Assert.IsEmpty(created.Members);
+        Assert.IsNull(created.Description);
+    }
+
+    [TestMethod]
+    public async Task TeamsArePagedWithTheirMembers()
+    {
+        await AddUsersAsync("ada@example.com");
+        await PostAsync<TeamDto>("/teams", Team("c", "ada@example.com"));
+        await PostAsync<TeamDto>("/teams", new TeamInput { Name = "a" });
+        await PostAsync<TeamDto>("/teams", new TeamInput { Name = "b" });
+
+        var page = (await Client.GetFromJsonAsync<Page<TeamDto>>("/teams?orderBy=Name&descending=true&page=1&pageSize=2"))!;
+
+        Assert.AreEqual(3, page.TotalCount);
+        Assert.AreEqual("c", page.Items[0].Name);
+        Assert.HasCount(1, page.Items[0].Members);
+        Assert.AreEqual("b", page.Items[1].Name);
+    }
+
+    [TestMethod]
+    public async Task UnknownSortPropertyIsInvalid()
+    {
+        await AssertInvalidAsync(await Client.GetAsync("/teams?orderBy=Members"), "orderBy");
+    }
+
+    [TestMethod]
+    public async Task UnknownTeamIsNotFound()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{UnknownId}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{UnknownId}", new TeamInput { Name = "x" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{UnknownId}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameIsRequiredAndAtMost50Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new TeamInput { Name = " " }), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new TeamInput { Name = new string('n', 51) }), "Name");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", new TeamInput { Name = new string('n', 50) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task DescriptionIsAtMost200Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new TeamInput { Name = "t", Description = new string('d', 201) }), "Description");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", new TeamInput { Name = "t", Description = new string('d', 200) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameIsUnique()
+    {
+        await PostAsync<TeamDto>("/teams", new TeamInput { Name = "dup" });
+        var other = await PostAsync<TeamDto>("/teams", new TeamInput { Name = "other" });
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", new TeamInput { Name = "dup" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PutAsJsonAsync($"/teams/{other.Id}", new TeamInput { Name = "dup" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{other.Id}", new TeamInput { Name = "other", Description = "same name" })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustBelongToAUser()
+    {
+        var response = await Client.PostAsJsonAsync("/teams", Team("t", "nobody@example.com"));
+
+        await AssertInvalidAsync(response, "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailIsRequiredAndAtMost50Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", "")), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", new string('e', 51))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task SameEmailTwiceInATeamIsInvalid()
+    {
+        await AddUsersAsync("ada@example.com");
+        var input = Team("t", "ada@example.com");
+        input.Members.Add(new() { UserEmail = "ada@example.com" });
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", input), "Members[1].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task SameUserCanBeInSeveralTeams()
+    {
+        await AddUsersAsync("ada@example.com");
+        await PostAsync<TeamDto>("/teams", Team("one", "ada@example.com"));
+        await PostAsync<TeamDto>("/teams", Team("two", "ada@example.com"));
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersHasExactlyOneOwner()
+    {
+        await AddUsersAsync("ada@example.com", "bob@example.com");
+        var none = Team("t", "ada@example.com", "bob@example.com");
