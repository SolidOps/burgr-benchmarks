+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrud()
+    {
+        await CreateUsersAsync("ada@example.com", "bob@example.com");
+
+        var created = await PostAsync<TeamDto>("/teams", Team("core", "ada@example.com"));
+        Assert.AreEqual("core", created.Name);
+        Assert.AreEqual("desc", created.Description);
+        Assert.AreEqual("ada@example.com", created.Members.Single().UserEmail);
+        Assert.IsTrue(created.Members.Single().IsOwner);
+        Assert.AreNotEqual(Guid.Empty, created.Members.Single().Id);
+
+        var read = await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}");
+        Assert.AreEqual(created.Members.Single().Id, read!.Members.Single().Id);
+
+        var response = await Client.PutAsJsonAsync($"/teams/{created.Id}", new
+        {
+            name = "core2",
+            members = new object[]
+            {
+                new { id = created.Members[0].Id, userEmail = "ada@example.com", isOwner = false },
+                new { userEmail = "bob@example.com", isOwner = true },
+            },
+        });
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
+        var updated = (await response.Content.ReadFromJsonAsync<TeamDto>())!;
+        Assert.AreEqual("core2", updated.Name);
+        Assert.IsNull(updated.Description);
+        Assert.HasCount(2, updated.Members);
+        Assert.AreEqual(created.Members[0].Id, updated.Members.Single(m => m.UserEmail == "ada@example.com").Id);
+        Assert.IsTrue(updated.Members.Single(m => m.UserEmail == "bob@example.com").IsOwner);
+
+        // removing every member, then the team
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", new { name = "core2", members = Array.Empty<object>() })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        var team = await PostAsync<TeamDto>("/teams", new { name = "empty" });
+        Assert.IsEmpty(team.Members);
+    }
+
+    [TestMethod]
+    public async Task QueryPagesTeamsWithTheirMembers()
+    {
+        await CreateUsersAsync("ada@example.com");
+        await PostAsync<TeamDto>("/teams", Team("a", "ada@example.com"));
+        await PostAsync<TeamDto>("/teams", new { name = "b" });
+        await PostAsync<TeamDto>("/teams", new { name = "c" });
+
+        var page = await Client.GetFromJsonAsync<Page<TeamDto>>("/teams?page=1&pageSize=2&orderBy=Name");
+
+        Assert.AreEqual(3, page!.TotalCount);
+        Assert.AreEqual(2, page.Items.Count);
+        Assert.AreEqual("a", page.Items[0].Name);
+        Assert.AreEqual("ada@example.com", page.Items[0].Members.Single().UserEmail);
+        await AssertInvalidAsync(await Client.GetAsync("/teams?orderBy=Nope"), "orderBy");
+    }
+
+    [TestMethod]
+    public async Task UnknownTeamIsNotFound()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{UnknownId}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{UnknownId}", new { name = "x" })).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{UnknownId}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameAndDescriptionAreValidated()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new { name = "" }), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new { name = new string('x', 51) }), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new { name = "ok", description = new string('x', 201) }), "Description");
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", new { name = new string('x', 50), description = new string('x', 200) })).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustBeAnExistingUserOfAtMost50Characters()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", "ghost@example.com")), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", "")), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", Team("t", new string('x', 51))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task TheSameEmailCannotAppearTwice()
+    {
+        await CreateUsersAsync("ada@example.com");
+        var body = new
+        {
+            name = "t",
+            members = new object[]
+            {
+                new { userEmail = "ada@example.com", isOwner = true },
+                new { userEmail = "ada@example.com", isOwner = false },
+            },
+        };
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", body), "Members[1].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task ATeamWithMembersHasExactlyOneOwner()
+    {
+        await CreateUsersAsync("ada@example.com", "bob@example.com");
+        object Members(bool first, bool second) => new object[]
+        {
+            new { userEmail = "ada@example.com", isOwner = first },
+            new { userEmail = "bob@example.com", isOwner = second },
+        };
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new { name = "t", members = Members(false, false) }), "Members");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", new { name = "t", members = Members(true, true) }), "Members");
+
+        var team = await PostAsync<TeamDto>("/teams", new { name = "t", members = Members(true, false) });
+        var update = await Client.PutAsJsonAsync($"/teams/{team.Id}", new { name = "t", members = Members(false, false) });
+        await AssertInvalidAsync(update, "Members");
+    }
+
+    [TestMethod]
+    public async Task AMemberIdMustBelongToTheTeam()
+    {
+        await CreateUsersAsync("ada@example.com");
+        var team = await PostAsync<TeamDto>("/teams", new { name = "t" });
+        var other = await PostAsync<TeamDto>("/teams", Team("u", "ada@example.com"));
+
+        var body = new { name = "t", members = new object[] { new { id = other.Members[0].Id, userEmail = "ada@example.com", isOwner = true } } };
+
+        await AssertInvalidAsync(await Client.PutAsJsonAsync($"/teams/{team.Id}", body), "Members[0].Id");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", body), "Members[0].Id");
+    }
+
+    [TestMethod]
+    public async Task NameIsUnique()
+    {
+        await PostAsync<TeamDto>("/teams", new { name = "dup" });
+        var other = await PostAsync<TeamDto>("/teams", new { name = "other" });
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", new { name = "dup" })).StatusCode);
