diff --git a/src/UM.Tests/TeamTests.cs b/src/UM.Tests/TeamTests.cs
new file mode 100644
index 0000000..3f994cb
--- /dev/null
+++ b/src/UM.Tests/TeamTests.cs
@@ -0,0 +1,164 @@
+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrudAndItsMembersAreSynchronized()
+    {
+        await AddUserAsync("ada@example.com");
+        await AddUserAsync("bob@example.com");
+        await AddUserAsync("eve@example.com");
+
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Core", Member("ada@example.com", true), Member("bob@example.com", false)));
+        Assert.HasCount(2, team.Members);
+        Assert.IsTrue(team.Members.All(m => m.Id != Guid.Empty));
+        var ada = team.Members.Single(m => m.UserEmail == "ada@example.com");
+        var bob = team.Members.Single(m => m.UserEmail == "bob@example.com");
+
+        // ada updated (owner changes to bob), bob updated, eve added
+        var update = NewTeam("Core 2", Member("ada@example.com", false, ada.Id), Member("bob@example.com", true, bob.Id), Member("eve@example.com", false));
+        update.Description = "The core";
+        var updated = await PutAsync(team.Id, update);
+        Assert.AreEqual("Core 2", updated.Name);
+        Assert.AreEqual("The core", updated.Description);
+        Assert.HasCount(3, updated.Members);
+        Assert.IsFalse(updated.Members.Single(m => m.Id == ada.Id).IsOwner);
+        Assert.IsTrue(updated.Members.Single(m => m.Id == bob.Id).IsOwner);
+
+        // ada and eve removed
+        var one = await PutAsync(team.Id, NewTeam("Core 2", Member("bob@example.com", true, bob.Id)));
+        Assert.AreEqual(bob.Id, one.Members.Single().Id);
+
+        var read = await Client.GetFromJsonAsync<TeamDto>($"/teams/{team.Id}");
+        Assert.HasCount(1, read!.Members);
+
+        var page = await Client.GetFromJsonAsync<Page<TeamDto>>("/teams");
+        Assert.AreEqual(team.Id, page!.Items.Single().Id);
+    }
+
+    [TestMethod]
+    public async Task UnknownIdGives404OnUpdateAndDelete()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{Guid.NewGuid()}", NewTeam("X"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{Guid.NewGuid()}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowedAndCanBeDeleted()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Empty"));
+
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersCannotBeDeleted()
+    {
+        await AddUserAsync("ada@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Core", Member("ada@example.com", true)));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+
+        await PutAsync(team.Id, NewTeam("Core"));
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task NameMustBeUnique()
+    {
+        await PostAsync<TeamDto>("/teams", NewTeam("Core"));
+        var other = await PostAsync<TeamDto>("/teams", NewTeam("Other"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", NewTeam("Core"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PutAsJsonAsync($"/teams/{other.Id}", NewTeam("Core"))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task InvalidFieldsAreReported()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("")), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam(new string('a', 51))), "Name");
+
+        var team = NewTeam("Long");
+        team.Description = new string('d', 201);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", team), "Description");
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("Mail", Member("", true))), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("Mail", Member(new string('a', 51), true))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustMatchAUser()
+    {
+        var response = await Client.PostAsJsonAsync("/teams", NewTeam("Core", Member("nobody@example.com", true)));
+
+        await AssertInvalidAsync(response, "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailAppearsOnceInATeam()
+    {
+        await AddUserAsync("ada@example.com");
+
+        var response = await Client.PostAsJsonAsync("/teams", NewTeam("Core", Member("ada@example.com", true), Member("ada@example.com", false)));
+
+        await AssertInvalidAsync(response, "Members[1].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersHasExactlyOneOwner()
+    {
+        await AddUserAsync("ada@example.com");
+        await AddUserAsync("bob@example.com");
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("None", Member("ada@example.com", false))), "Members");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("Two", Member("ada@example.com", true), Member("bob@example.com", true))), "Members");
+
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("One", Member("ada@example.com", true)));
+        var response = await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("One", Member("ada@example.com", false, team.Members[0].Id)));
+        await AssertInvalidAsync(response, "Members");
+    }
+
+    [TestMethod]
+    public async Task ReadingRequiresAnAuthenticatedCallerAndWritingTheManageTeamsRight()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("Core"));
+
+        Unauthenticate();
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Client.GetAsync("/teams")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Client.PostAsJsonAsync("/teams", NewTeam("A"))).StatusCode);
+
+        AuthenticateAs(UMRights.ManageUsers);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync("/teams")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.PostAsJsonAsync("/teams", NewTeam("A"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("A"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+
+        AuthenticateAs(UMRights.ManageTeams);
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", NewTeam("A"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    private async Task AddUserAsync(string email) =>
+        await PostAsync<UserDto>("/users", new UserInput { Email = email, Provider = "local" });
+
+    private async Task<TeamDto> PutAsync(Guid id, TeamInput input)
+    {
+        var response = await Client.PutAsJsonAsync($"/teams/{id}", input);
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode, await response.Content.ReadAsStringAsync());
+        return (await response.Content.ReadFromJsonAsync<TeamDto>())!;
+    }
+
+    private static TeamInput NewTeam(string name, params TeamMemberInput[] members) => new() { Name = name, Members = [.. members] };
+
+    private static TeamMemberInput Member(string email, bool isOwner, Guid? id = null) => new() { Id = id, UserEmail = email, IsOwner = isOwner };
+}
