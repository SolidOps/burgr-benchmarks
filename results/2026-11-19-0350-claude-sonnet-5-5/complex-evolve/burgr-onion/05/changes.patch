+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Application;
+
+public partial class TeamService
+{
+    // a member is the email of an existing user, once per team; a team with members has exactly one owner
+    private async partial Task<Error?> CheckMembersAsync(Team aggregate, CancellationToken cancellationToken)
+    {
+        var errors = new Dictionary<string, string[]>();
+        var members = aggregate.Members.ToList();
+        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        for (var i = 0; i < members.Count; i++)
+        {
+            var email = members[i].UserEmail;
+            if (!seen.Add(email))
+            {
+                errors[$"Members[{i}].UserEmail"] = ["The user is already a member of the team"];
+            }
+            else if (await UserRepository.FindByEmailAsync(email, cancellationToken) is null)
+            {
+                errors[$"Members[{i}].UserEmail"] = ["User not found"];
+            }
+        }
+        if (members.Count > 0 && members.Count(m => m.IsOwner) != 1)
+        {
+            errors["Members"] = ["A team with members must have exactly one owner"];
+        }
+        return errors.Count > 0 ? Error.Invalid(errors) : null;
+    }
+
+    private partial Task<Error?> RefuseIfHasMembersAsync(Team aggregate, CancellationToken cancellationToken)
+    {
+        return Task.FromResult(aggregate.Members.Count > 0 ? Error.Conflict("The team still has members") : null);
+    }
+}
