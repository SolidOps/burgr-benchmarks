+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Application;
+
+public partial class TeamService
+{
+    // every member is an existing user, and a team with members has exactly one owner
+    private async partial Task<Error?> CheckMembersAsync(Team aggregate, CancellationToken cancellationToken)
+    {
+        var errors = new Dictionary<string, string[]>();
+        var members = aggregate.Members.ToList();
+        for (var i = 0; i < members.Count; i++)
+        {
+            if (await UserRepository.FindByEmailAsync(members[i].UserEmail, cancellationToken) is null)
+            {
+                errors[$"Members[{i}].UserEmail"] = ["No user has this email"];
+            }
+        }
+        if (members.Count > 0 && members.Count(m => m.IsOwner) != 1)
+        {
+            errors["Members"] = ["A team with members must have exactly one owner"];
+        }
+        return errors.Count > 0 ? Error.Invalid(errors) : null;
+    }
+
+    private partial Task<Error?> CheckNoMembersAsync(Team aggregate, CancellationToken cancellationToken)
+    {
+        return Task.FromResult<Error?>(aggregate.Members.Count > 0 ? Error.Conflict("The team still has members") : null);
+    }
+}
