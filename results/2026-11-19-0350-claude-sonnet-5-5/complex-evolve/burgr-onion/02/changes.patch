+public sealed partial class TeamInput
+{
+    // Property [S][NO][NAR][PUO][NRO]
+    public System.String Name { get; set; } = string.Empty;
+
+    public String? Description { get; set; } = null;
+
+    // Property [M][LNA][SY][EN][PUO][NRO]
+    /// <summary>The whole list: a child without Id is added, a child missing from the list is removed.</summary>
+    public List<TeamMemberInput> Members { get; set; } = [];
+
+    /// <summary>Required values, maximum lengths, enum values, value objects and synchronized children, then <see cref="OnValidating"/>.</summary>
+    public Dictionary<string, string[]> Validate()
+    {
+        var errors = new Dictionary<string, string[]>();
+        // Property [S][NO][NAR][PUO][NRO]
+        // VALIDATION RULE - NULLABLE_PROPERTY
+        if (string.IsNullOrWhiteSpace(Name))
+        {
+            errors["Name"] = ["Name is required"];
+        }
+
+        // Property [S][NO][NAR][PUO][NRO]
+        // VALIDATION RULE - PROPERTY_HAS_MAX_SIZE
+        if (Name?.Length > 50)
+        {
+            errors["Name"] = ["Name is longer than 50 characters"];
+        }
+
+        // VALIDATION RULE - PROPERTY_HAS_MAX_SIZE
+        if (Description?.Length > 200)
+        {
+            errors["Description"] = ["Description is longer than 200 characters"];
+        }
+
+        // Property [M][LNA][SY][EN][PUO][NRO]
+        for (var i = 0; i < Members.Count; i++)
+        {
+            foreach (var (key, messages) in Members[i].Validate())
+            {
+                errors[$"Members[{i}].{key}"] = messages;
+            }
+        }
+
+        OnValidating(errors);
+        return errors;
+    }
+    partial void OnValidating(Dictionary<string, string[]> errors);
+    public void ApplyTo(Domain.Team entity)
+    {
+        // Property [S][NO][NAR][PUO][NRO]
+        entity.Name = Name;
+
+        entity.Description = Description;
+
+        // Property [M][LNA][SY][EN][PUO][NRO]
+        entity.Members.RemoveAll(child => !Members.Exists(input => Equals(input.Id, child.Id)));
+        foreach (var childInput in Members)
+        {
+            var child = childInput.Id is { } childId ? entity.Members.Find(c => c.Id.Equals(childId)) : null;
+            if (child is null)
+            {
+                child = new Domain.TeamMember();
+                entity.Members.Add(child);
+            }
+            childInput.ApplyTo(child);
+        }
+
+    }
