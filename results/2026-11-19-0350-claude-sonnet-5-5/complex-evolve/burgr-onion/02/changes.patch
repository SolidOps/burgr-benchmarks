diff --git a/src/UM.Tests/TeamTests.cs b/src/UM.Tests/TeamTests.cs
new file mode 100644
index 0000000..630a86e
--- /dev/null
+++ b/src/UM.Tests/TeamTests.cs
@@ -0,0 +1,169 @@
+using System.Net;
+using System.Net.Http.Json;
+using SolidOps.UM.Application;
+using SolidOps.UM.Domain;
+
+namespace SolidOps.UM.Tests;
+
+[TestClass]
+public sealed class TeamTests : ApiTestBase
+{
+    [TestMethod]
+    public async Task TeamGoesThroughTheWholeCrud()
+    {
+        await NewUserAsync("ada@example.com");
+        await NewUserAsync("bob@example.com");
+
+        var created = await PostAsync<TeamDto>("/teams", NewTeam("core", Member("ada@example.com", true)));
+        Assert.AreEqual("core", created.Name);
+        Assert.HasCount(1, created.Members);
+        var ada = created.Members[0];
+
+        var input = NewTeam("core2", new TeamMemberInput { Id = ada.Id, UserEmail = "ada@example.com", IsOwner = true }, Member("bob@example.com", false));
+        input.Description = "the core";
+        var response = await Client.PutAsJsonAsync($"/teams/{created.Id}", input);
+        Assert.AreEqual(HttpStatusCode.OK, response.StatusCode);
+        var updated = (await response.Content.ReadFromJsonAsync<TeamDto>())!;
+        Assert.AreEqual("the core", updated.Description);
+        Assert.HasCount(2, updated.Members);
+        Assert.IsTrue(updated.Members.Any(m => m.Id == ada.Id), "the kept member keeps its Id");
+
+        var read = await Client.GetFromJsonAsync<TeamDto>($"/teams/{created.Id}");
+        Assert.HasCount(2, read!.Members);
+
+        var page = await Client.GetFromJsonAsync<Page<TeamDto>>("/teams");
+        Assert.AreEqual(1, page!.TotalCount);
+
+        // removing members, then the team
+        input.Members = [];
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.PutAsJsonAsync($"/teams/{created.Id}", input)).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NoContent, (await Client.DeleteAsync($"/teams/{created.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{created.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task UnknownTeamIsNotFound()
+    {
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.GetAsync($"/teams/{Guid.NewGuid()}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.PutAsJsonAsync($"/teams/{Guid.NewGuid()}", NewTeam("x"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.NotFound, (await Client.DeleteAsync($"/teams/{Guid.NewGuid()}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithoutMembersIsAllowed()
+    {
+        await PostAsync<TeamDto>("/teams", NewTeam("empty"));
+    }
+
+    [TestMethod]
+    public async Task InvalidFieldsAreReported()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("")), "Name");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam(new string('a', 51))), "Name");
+        var longDescription = NewTeam("t");
+        longDescription.Description = new string('d', 201);
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", longDescription), "Description");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailMustMatchAUser()
+    {
+        var response = await Client.PostAsJsonAsync("/teams", NewTeam("t", Member("nobody@example.com", true)));
+
+        await AssertInvalidAsync(response, "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task MemberEmailIsRequiredAndBounded()
+    {
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("t", Member("", true))), "Members[0].UserEmail");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("t2", Member(new string('a', 51) + "@x.com", true))), "Members[0].UserEmail");
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersHasExactlyOneOwner()
+    {
+        await NewUserAsync("ada@example.com");
+        await NewUserAsync("bob@example.com");
+
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("none", Member("ada@example.com", false))), "Members");
+        await AssertInvalidAsync(await Client.PostAsJsonAsync("/teams", NewTeam("two", Member("ada@example.com", true), Member("bob@example.com", true))), "Members");
+
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("one", Member("ada@example.com", true), Member("bob@example.com", false)));
+        var demoted = NewTeam("one", team.Members.Select(m => new TeamMemberInput { Id = m.Id, UserEmail = m.UserEmail, IsOwner = false }).ToArray());
+        await AssertInvalidAsync(await Client.PutAsJsonAsync($"/teams/{team.Id}", demoted), "Members");
+    }
+
+    [TestMethod]
+    public async Task SameEmailTwiceInATeamIsRejected()
+    {
+        await NewUserAsync("ada@example.com");
+
+        var response = await Client.PostAsJsonAsync("/teams", NewTeam("dup", Member("ada@example.com", true), Member("ada@example.com", false)));
+
+        Assert.IsTrue(response.StatusCode is HttpStatusCode.Conflict or HttpStatusCode.BadRequest, response.StatusCode.ToString());
+        Assert.AreEqual(0, (await Client.GetFromJsonAsync<Page<TeamDto>>("/teams"))!.TotalCount);
+    }
+
+    [TestMethod]
+    public async Task SameEmailCanBelongToTwoTeams()
+    {
+        await NewUserAsync("ada@example.com");
+
+        await PostAsync<TeamDto>("/teams", NewTeam("a", Member("ada@example.com", true)));
+        await PostAsync<TeamDto>("/teams", NewTeam("b", Member("ada@example.com", true)));
+    }
+
+    [TestMethod]
+    public async Task TeamNameIsUnique()
+    {
+        await PostAsync<TeamDto>("/teams", NewTeam("same"));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.PostAsJsonAsync("/teams", NewTeam("same"))).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task TeamWithMembersCannotBeDeleted()
+    {
+        await NewUserAsync("ada@example.com");
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("busy", Member("ada@example.com", true)));
+
+        Assert.AreEqual(HttpStatusCode.Conflict, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task ReadingNeedsAnAuthenticatedCaller()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("t"));
+
+        AuthenticateAs();
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync("/teams")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.OK, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+
+        Unauthenticate();
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Client.GetAsync("/teams")).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Unauthorized, (await Client.GetAsync($"/teams/{team.Id}")).StatusCode);
+    }
+
+    [TestMethod]
+    public async Task WritingNeedsManageTeams()
+    {
+        var team = await PostAsync<TeamDto>("/teams", NewTeam("t"));
+
+        AuthenticateAs(UMRights.ManageUsers);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.PostAsJsonAsync("/teams", NewTeam("u"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.PutAsJsonAsync($"/teams/{team.Id}", NewTeam("t"))).StatusCode);
+        Assert.AreEqual(HttpStatusCode.Forbidden, (await Client.DeleteAsync($"/teams/{team.Id}")).StatusCode);
+
+        AuthenticateAs(UMRights.ManageTeams);
+        Assert.AreEqual(HttpStatusCode.Created, (await Client.PostAsJsonAsync("/teams", NewTeam("u"))).StatusCode);
+    }
+
+    private Task NewUserAsync(string email) =>
+        PostAsync<UserDto>("/users", new UserInput { Email = email, Provider = "local" });
+
+    private static TeamMemberInput Member(string email, bool isOwner) => new() { UserEmail = email, IsOwner = isOwner };
+
+    private static TeamInput NewTeam(string name, params TeamMemberInput[] members) => new() { Name = name, Members = [.. members] };
+}
