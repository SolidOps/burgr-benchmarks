+
+    // the input's own rules, then the existence of the aggregates and entities it references
+    private async Task<Dictionary<string, string[]>> ValidateAsync(TeamInput input, CancellationToken cancellationToken)
+    {
+        var errors = input.Validate();
+
         return errors;
     }
